<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<tt xmlns:tt="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:tickRate="10000000" ttp:timeBase="media" xmlns="http://www.w3.org/ns/ttml">
<head>
<ttp:profile use="http://netflix.com/ttml/profile/dfxp-ls-sdh"/>
<styling>
<style tts:backgroundColor="transparent" tts:textAlign="center" xml:id="style0"/>
<style tts:color="white" tts:fontSize="100%" tts:fontWeight="normal" xml:id="style1"/>
<style tts:color="white" tts:fontSize="100%" tts:fontStyle="italic" tts:fontWeight="normal" xml:id="style2"/>
</styling>
<layout>
<region tts:displayAlign="after" xml:id="region0"/>
</layout>
</head>
<body>
<div xml:space="preserve">
    <p xml:id="p1" begin="553050000t" end="573910000t" style="style0"><span style="style1">BEK LAMA: Sedikit yang tahu keseluruhan cerita.</span></p>
    <p xml:id="p2" begin="573910000t" end="610610000t" style="style0"><span style="style1">ia berlaku seperti ini... Dari apa yang saya ingat,</span></p>
    <p xml:id="p3" begin="618120000t" end="641050000t" style="style0"><span style="style1">Sebelum sejarah bermula,</span></p>
    <p xml:id="p4" begin="641050000t" end="667340000t" style="style0"><span style="style1">Mesir adalah tempat kelahiran semua kehidupan.</span></p>
    <p xml:id="p5" begin="667340000t" end="701950000t" style="style0"><span style="style1">Syurga yang layak bagi tuhan yang menciptanya.</span></p>
    <p xml:id="p6" begin="701950000t" end="727400000t" style="style0"><span style="style1">memutuskan untuk tinggal di sana Jadi tuhan</span></p>
    <p xml:id="p7" begin="727400000t" end="741150000t" style="style0"><span style="style1">bersama ciptaan mereka yang lebih kecil,</span></p>
    <p xml:id="p8" begin="747000000t" end="760760000t" style="style0"><span style="style1">lelaki.</span></p>
    <p xml:id="p9" begin="766180000t" end="784950000t" style="style0"><span style="style1">tidak silap tuhan Tetapi ada</span></p>
    <p xml:id="p10" begin="784950000t" end="806220000t" style="style0"><span style="style1">di antara manusia yang menyembah mereka.</span></p>
    <p xml:id="p11" begin="806220000t" end="828330000t" style="style0"><span style="style1">Dewa-dewa itu lebih tinggi</span></p>
    <p xml:id="p12" begin="828330000t" end="843340000t" style="style0"><span style="style1">urat mereka bukannya darah. dengan emas mengalir melalui</span></p>
    <p xml:id="p13" begin="862110000t" end="881290000t" style="style0"><span style="style1">berubah sesuka hati Dan mereka boleh</span></p>
    <p xml:id="p14" begin="881290000t" end="904240000t" style="style0"><span style="style1">daripada binatang yang menakutkan. ke dalam semua cara</span></p>
    <p xml:id="p15" begin="935940000t" end="973470000t" style="style0"><span style="style1">antara dua saudara yang kuat. Mesir sendiri berpecah</span></p>
    <p xml:id="p16" begin="973470000t" end="1006420000t" style="style0"><span style="style1">Osiris, Tuhan Kehidupan, adalah raja yang dikasihi</span></p>
    <p xml:id="p17" begin="1006420000t" end="1031020000t" style="style0"><span style="style1">dilimpahi oleh Sungai Nil. daripada semua tanah</span></p>
    <p xml:id="p18" begin="1048130000t" end="1086500000t" style="style0"><span style="style1">memerintah padang pasir yang tandus, saudaranya, Set,</span></p>
    <p xml:id="p19" begin="1086500000t" end="1131540000t" style="style0"><span style="style1">kepahitan dalam pengasingannya. mencari kedua-dua kekuatan dan</span></p>
    <p xml:id="p20" begin="1131540000t" end="1167420000t" style="style0"><span style="style1">Tetapi kemudian tiba masanya untuk Osiris menobatkan raja baru.</span></p>
    <p xml:id="p21" begin="1167420000t" end="1195780000t" style="style0"><span style="style1">Anak lelaki tunggalnya, Horus.</span></p>
    <p xml:id="p22" begin="1195780000t" end="1220390000t" style="style0"><span style="style1">Ia adalah keputusan yang akan menguji ikatan saudara-saudara</span></p>
    <p xml:id="p23" begin="1220390000t" end="1238740000t" style="style0"><span style="style1">dan nasib seluruh Mesir.</span></p>
    <p xml:id="p24" begin="1441850000t" end="1461870000t" style="style0"><span style="style1">Tetapi tuhan hanya separuh kisah kita.</span></p>
    <p xml:id="p25" begin="1468550000t" end="1488990000t" style="style0"><span style="style1">Ia telah menjadi jelas</span></p>
    <p xml:id="p26" begin="1488990000t" end="1511100000t" style="style0"><span style="style1">perjalanan takdir sahaja. bahawa mereka tidak dapat membentuk</span></p>
    <p xml:id="p27" begin="1511100000t" end="1532780000t" style="style0"><span style="style1">Seorang lelaki yang mempunyai pertimbangan yang luar biasa,</span></p>
    <p xml:id="p28" begin="1532780000t" end="1561970000t" style="style0"><span style="style1">kebijaksanaan dan ketabahan akan diperlukan.</span></p>
    <p xml:id="p29" begin="1561970000t" end="1607020000t" style="style0"><span style="style1">Saya bukan lelaki seperti itu. Malangnya,</span></p>
    <p xml:id="p30" begin="1607020000t" end="1634970000t" style="style0"><span style="style1">diri saya yang lebih muda bodoh, Tetapi sebelum anda menolak</span></p>
    <p xml:id="p31" begin="1634970000t" end="1649570000t" style="style0"><span style="style1">ingat...</span></p>
    <p xml:id="p32" begin="1656660000t" end="1677090000t" style="style0"><span style="style1">Jangan pernah meragui lelaki</span></p>
    <p xml:id="p33" begin="1677090000t" end="1702110000t" style="style0"><span style="style1">berjuang untuk satu perkara yang berkuasa seperti mana-mana tuhan.</span></p>
    <p xml:id="p34" begin="1702110000t" end="1712120000t" style="style0"><span style="style1">LELAKI: Tiga ratus, mustahil.</span></p>
    <p xml:id="p35" begin="1712120000t" end="1722550000t" style="style0"><span style="style1">BEK TUA: Sayang.</span></p>
    <p xml:id="p36" begin="1728400000t" end="1741730000t" style="style0"><span style="style1">Ia adalah harga yang terbaik.</span></p>
    <p xml:id="p37" begin="1760100000t" end="1775110000t" style="style0"><span style="style1">(Merengus) Pencuri!</span></p>
    <p xml:id="p38" begin="1775110000t" end="1792200000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p39" begin="1792200000t" end="1804300000t" style="style0"><span style="style1">LELAKI: Berhenti!</span></p>
    <p xml:id="p40" begin="1832240000t" end="1856440000t" style="style0"><span style="style1">Pakaian ini tiada harapan. ZAYA: (MENGESEH)</span></p>
    <p xml:id="p41" begin="1856440000t" end="1873950000t" style="style0"><span style="style1">Saya perlu membeli beberapa reben untuk memulakan</span></p>
    <p xml:id="p42" begin="1873950000t" end="1893140000t" style="style0"><span style="style1">untuk menjadikannya sesuai untuk pertabalan.</span></p>
    <p xml:id="p43" begin="1893140000t" end="1915250000t" style="style0"><span style="style1">Saya katakan kita habiskan esok bersama-sama.</span></p>
    <p xml:id="p44" begin="1915250000t" end="1952360000t" style="style0"><span style="style1">esok bersama. Pada pertabalan. Kami berbelanja</span></p>
    <p xml:id="p45" begin="1952360000t" end="1962370000t" style="style0"><span style="style1">tuhan akan memberi kita Kami diberkati</span></p>
    <p xml:id="p46" begin="1962370000t" end="1972800000t" style="style0"><span style="style1">dalam hidup kita. seorang raja baru</span></p>
    <p xml:id="p47" begin="1972800000t" end="1992400000t" style="style0"><span style="style1">Horus?</span></p>
    <p xml:id="p48" begin="1992400000t" end="2002830000t" style="style0"><span style="style1">Anda tahu saya tidak peduli tentang tuhan.</span></p>
    <p xml:id="p49" begin="2002830000t" end="2016600000t" style="style0"><span style="style1">Nah, mereka mengambil berat tentang anda.</span></p>
    <p xml:id="p50" begin="2022430000t" end="2043710000t" style="style0"><span style="style1">Bek! Kembalikan. Oh, ya?</span></p>
    <p xml:id="p51" begin="2062470000t" end="2074990000t" style="style0"><span style="style1">untuk memakai sesuatu yang istimewa. Saya tahu awak mahu</span></p>
    <p xml:id="p52" begin="2124620000t" end="2138390000t" style="style0"><span style="style1">Adakah anda mencurinya daripada seorang pekedai</span></p>
    <p xml:id="p53" begin="2138390000t" end="2156320000t" style="style0"><span style="style1">atau dari almari seseorang?</span></p>
    <p xml:id="p54" begin="2156320000t" end="2171340000t" style="style0"><span style="style1">Ia lebih cepat daripada menunggu tuhan</span></p>
    <p xml:id="p55" begin="2171340000t" end="2183850000t" style="style0"><span style="style1">untuk menjawab doa saya.</span></p>
    <p xml:id="p56" begin="2218890000t" end="2236400000t" style="style0"><span style="style1">semua yang kita perlukan. Tuhan memberi kita</span></p>
    <p xml:id="p57" begin="2236400000t" end="2258090000t" style="style0"><span style="style1">ya. Kemurahan hati mereka tidak mengenal batas.</span></p>
    <p xml:id="p58" begin="2271860000t" end="2286030000t" style="style0"><span style="style1">(MENGESEH) Awak nampak cantik.</span></p>
    <p xml:id="p59" begin="2305220000t" end="2324820000t" style="style0"><span style="style1">Zaya, apabila saya meminta awak untuk melarikan diri dengan saya,</span></p>
    <p xml:id="p60" begin="2332740000t" end="2346090000t" style="style0"><span style="style1">Saya berjanji kepada awak kehidupan yang baik.</span></p>
    <p xml:id="p61" begin="2351520000t" end="2371120000t" style="style0"><span style="style1">Pakaian yang layak untuk seorang puteri.</span></p>
    <p xml:id="p62" begin="2371120000t" end="2382790000t" style="style0"><span style="style1">Yang baru setiap hari. (KECIK)</span></p>
    <p xml:id="p63" begin="2382790000t" end="2402810000t" style="style0"><span style="style1">Sungai-sungai permata untuk menghiasi anda.</span></p>
    <p xml:id="p64" begin="2402810000t" end="2415330000t" style="style0"><span style="style1">untuk membesarkan keluarga kita. Sebuah istana emas</span></p>
    <p xml:id="p65" begin="2415330000t" end="2434930000t" style="style0"><span style="style1">Dan berapa ramai anak yang akan kita ada?</span></p>
    <p xml:id="p66" begin="2445780000t" end="2459130000t" style="style0"><span style="style1">(KECIK)</span></p>
    <p xml:id="p67" begin="2459130000t" end="2471640000t" style="style0"><span style="style1">(LEMBUT) Sedozen.</span></p>
    <p xml:id="p68" begin="2475390000t" end="2497910000t" style="style0"><span style="style1">Saya akan lakukan apa sahaja untuk membahagiakan awak.</span></p>
    <p xml:id="p69" begin="2497910000t" end="2520860000t" style="style0"><span style="style1">ODER BEK: Dan bagaimana keadaan Horus, bakal raja,</span></p>
    <p xml:id="p70" begin="2520860000t" end="2540040000t" style="style0"><span style="style1">bersedia untuk hari besarnya?</span></p>
    <p xml:id="p71" begin="2540040000t" end="2556300000t" style="style0"><span style="style1">(Berdengkur)</span></p>
    <p xml:id="p72" begin="2597600000t" end="2613020000t" style="style0"><span style="style1">Tuhan Udara.</span></p>
    <p xml:id="p73" begin="2631800000t" end="2653060000t" style="style0"><span style="style1">Agak satu majlis malam tadi.</span></p>
    <p xml:id="p74" begin="2653060000t" end="2664740000t" style="style0"><span style="style1">Dah ramai tekan pipi ke pipi</span></p>
    <p xml:id="p75" begin="2664740000t" end="2681850000t" style="style0"><span style="style1">untuk melihat anda sekilas.</span></p>
    <p xml:id="p76" begin="2681850000t" end="2694770000t" style="style0"><span style="style1">Anda akan kelihatan hebat. HAMBA 2:</span></p>
    <p xml:id="p77" begin="2694770000t" end="2711050000t" style="style0"><span style="style1">(MERENGENG LEMBUT)</span></p>
    <p xml:id="p78" begin="2711050000t" end="2723130000t" style="style0"><span style="style1">Akhirnya. (KEKEKkekek)</span></p>
    <p xml:id="p79" begin="2763170000t" end="2791130000t" style="style0"><span style="style1">♪ Gemilang, mulia Horus! ♪ HAMBA:</span></p>
    <p xml:id="p80" begin="2791130000t" end="2816980000t" style="style0"><span style="style1">BEK LEBIH TUA: Tetapi jangan diskaun lagi Horus.</span></p>
    <p xml:id="p81" begin="2816980000t" end="2835750000t" style="style0"><span style="style1">kepada nasib dunia Kerana apabila ia datang</span></p>
    <p xml:id="p82" begin="2835750000t" end="2857020000t" style="style0"><span style="style1">di tangan seseorang,</span></p>
    <p xml:id="p83" begin="2857020000t" end="2882880000t" style="style0"><span style="style1">dengan kekuatan yang mereka miliki. tuhan pun boleh terkejut</span></p>
    <p xml:id="p84" begin="2885380000t" end="2900400000t" style="style0"><span style="style1">(Mengeluh)</span></p>
    <p xml:id="p85" begin="2950030000t" end="2968380000t" style="style0"><span style="style1">Jika saya dinobatkan,</span></p>
    <p xml:id="p86" begin="2968380000t" end="2984230000t" style="style0"><span style="style1">Saya mungkin telah menghabiskan masa-masa sebelumnya</span></p>
    <p xml:id="p87" begin="2984230000t" end="3002590000t" style="style0"><span style="style1">mengarang mesej untuk umatku.</span></p>
    <p xml:id="p88" begin="3002590000t" end="3023430000t" style="style0"><span style="style1">Mungkinkah rakyat lebih menyayanginya?</span></p>
    <p xml:id="p89" begin="3023430000t" end="3045540000t" style="style0"><span style="style1">tidak fikir kita perlu Mungkin Lord Horus ucapan yang membosankan.</span></p>
    <p xml:id="p90" begin="3045540000t" end="3071410000t" style="style0"><span style="style1">untuk membakar kemuliaannya sendiri. Kecuali apabila ia datang</span></p>
    <p xml:id="p91" begin="3071410000t" end="3088500000t" style="style0"><span style="style1">Banyak roti bakar diperlukan.</span></p>
    <p xml:id="p92" begin="3088500000t" end="3112280000t" style="style0"><span style="style1">lagu mana yang akan dinyanyikan. Saya sedang melakukan perbuatan</span></p>
    <p xml:id="p93" begin="3112280000t" end="3135630000t" style="style0"><span style="style1">Singa besar yang dia bunuh itu mengganas kampung.</span></p>
    <p xml:id="p94" begin="3135630000t" end="3166910000t" style="style0"><span style="style1">Semua lebih layak lagu. Ia adalah? bagus.</span></p>
    <p xml:id="p95" begin="3174420000t" end="3187770000t" style="style0"><span style="style1">(Mengeluh)</span></p>
    <p xml:id="p96" begin="3187770000t" end="3202370000t" style="style0"><span style="style1">itu bagus.</span></p>
    <p xml:id="p97" begin="3233640000t" end="3249920000t" style="style0"><span style="style1">Tak apa, terima kasih... (GAGAP)</span></p>
    <p xml:id="p98" begin="3258260000t" end="3270350000t" style="style0"><span style="style1">awak.</span></p>
    <p xml:id="p99" begin="3270350000t" end="3293700000t" style="style0"><span style="style1">Sayang saya datang lambat.</span></p>
    <p xml:id="p100" begin="3293700000t" end="3321240000t" style="style0"><span style="style1">sedar dan berpakaian. Tetapi di sini saya,</span></p>
    <p xml:id="p101" begin="3327490000t" end="3342090000t" style="style0"><span style="style1">Jangan beritahu sesiapa.</span></p>
    <p xml:id="p102" begin="3342090000t" end="3362110000t" style="style0"><span style="style1">Saya mempunyai reputasi buruk untuk disimpan.</span></p>
    <p xml:id="p103" begin="3370870000t" end="3383790000t" style="style0"><span style="style1">(LEMBUT) Mari sini. Datang.</span></p>
    <p xml:id="p104" begin="3393800000t" end="3407570000t" style="style0"><span style="style1">Tidak. Tidak, tidak. Tidak, tidak!</span></p>
    <p xml:id="p105" begin="3407570000t" end="3416330000t" style="style0"><span style="style1">(JERIT)</span></p>
    <p xml:id="p106" begin="3416330000t" end="3430510000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p107" begin="3501000000t" end="3526860000t" style="style0"><span style="style1">HATHOR: Sukar untuk dipercayai, tetapi anda kelihatan seperti seorang raja.</span></p>
    <p xml:id="p108" begin="3526860000t" end="3551050000t" style="style0"><span style="style1">Jika itu yang menggembirakan anda, siapa saya untuk menilai?</span></p>
    <p xml:id="p109" begin="3551050000t" end="3565230000t" style="style0"><span style="style1">Barang kemas mengujakan saya.</span></p>
    <p xml:id="p110" begin="3568980000t" end="3583990000t" style="style0"><span style="style1">Kemudian lihat ke pergelangan tangan anda,</span></p>
    <p xml:id="p111" begin="3583990000t" end="3594000000t" style="style0"><span style="style1">tidaklah terlalu hebat. jika usaha</span></p>
    <p xml:id="p112" begin="3594000000t" end="3617780000t" style="style0"><span style="style1">Gelang 42 Bintang.</span></p>
    <p xml:id="p113" begin="3617780000t" end="3645720000t" style="style0"><span style="style1">Untuk mengingatkan anda tentang syaitan yang saya bunuh untuk anda.</span></p>
    <p xml:id="p114" begin="3645720000t" end="3666160000t" style="style0"><span style="style1">Khazanah yang lebih berharga Mesir tidak pernah tahu.</span></p>
    <p xml:id="p115" begin="3666160000t" end="3685760000t" style="style0"><span style="style1">Perkara lama ini?</span></p>
    <p xml:id="p116" begin="3685760000t" end="3709120000t" style="style0"><span style="style1">Bagaimana Dewi Cinta tidak tahu apa itu cinta?</span></p>
    <p xml:id="p117" begin="3709120000t" end="3740410000t" style="style0"><span style="style1">yang mengibaskan bulu matanya, Ia bukan tempat tidur mana-mana gadis</span></p>
    <p xml:id="p118" begin="3740410000t" end="3764170000t" style="style0"><span style="style1">pembunuh singa yang perkasa.</span></p>
    <p xml:id="p119" begin="3764170000t" end="3794620000t" style="style0"><span style="style1">Saya sedang meraikan pemburuan itu. Anda akan tahu sekiranya anda berada di sini.</span></p>
    <p xml:id="p120" begin="3794620000t" end="3824230000t" style="style0"><span style="style1">Binatang mati kurang begitu. Saya menghargai kebebasan saya.</span></p>
    <p xml:id="p121" begin="3824230000t" end="3843010000t" style="style0"><span style="style1">masalah memakainya. Nah, anda tidak mempunyai</span></p>
    <p xml:id="p122" begin="3843010000t" end="3865110000t" style="style0"><span style="style1">Hathor, jangan. Oh...</span></p>
    <p xml:id="p123" begin="3865110000t" end="3884290000t" style="style0"><span style="style1">jangan.</span></p>
    <p xml:id="p124" begin="3884290000t" end="3903490000t" style="style0"><span style="style1">Itu bukan cara untuk seorang ratu berkelakuan.</span></p>
    <p xml:id="p125" begin="3903490000t" end="3928090000t" style="style0"><span style="style1">Kemudian ia adalah perkara yang baik saya bukan seorang permaisuri.</span></p>
    <p xml:id="p126" begin="3928090000t" end="3949360000t" style="style0"><span style="style1">apa-apa lagi membosankan Bolehkah anda bayangkan daripada duduk</span></p>
    <p xml:id="p127" begin="3949360000t" end="3961460000t" style="style0"><span style="style1">di atas takhta sepanjang hari?</span></p>
    <p xml:id="p128" begin="3998580000t" end="4014000000t" style="style0"><span style="style1">awak tanya saya? Apa sebenarnya</span></p>
    <p xml:id="p129" begin="4029030000t" end="4044030000t" style="style0"><span style="style1">Ada saya tanya awak sesuatu?</span></p>
    <p xml:id="p130" begin="4061560000t" end="4074060000t" style="style0"><span style="style1">saya tak pasti. Adakah anda</span></p>
    <p xml:id="p131" begin="4124530000t" end="4135800000t" style="style0"><span style="style1">HAMBA: Tuanku.</span></p>
    <p xml:id="p132" begin="4142480000t" end="4154560000t" style="style0"><span style="style1">Ia bermula.</span></p>
    <p xml:id="p133" begin="4257170000t" end="4271350000t" style="style0"><span style="style1">(Mengeluh)</span></p>
    <p xml:id="p134" begin="4341840000t" end="4355180000t" style="style0"><span style="style1">(PUKUL DRAM)</span></p>
    <p xml:id="p135" begin="4385210000t" end="4402320000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p136" begin="4512850000t" end="4524930000t" style="style0"><span style="style1">(BURUNG BERKICANG)</span></p>
    <p xml:id="p137" begin="4658820000t" end="4705110000t" style="style0"><span style="style1">Hathor, Dewi Cinta!</span></p>
    <p xml:id="p138" begin="4705110000t" end="4720130000t" style="style0"><span style="style1">(ORANG RAMAI BERTEPUK)</span></p>
    <p xml:id="p139" begin="4836910000t" end="4885290000t" style="style0"><span style="style1">Dewi Perlindungan! Nephthys,</span></p>
    <p xml:id="p140" begin="4941190000t" end="4954950000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p141" begin="4963300000t" end="4976640000t" style="style0"><span style="style1">Tuan. Oh...</span></p>
    <p xml:id="p142" begin="4979980000t" end="4995820000t" style="style0"><span style="style1">Terima kasih, anak muda.</span></p>
    <p xml:id="p143" begin="5014180000t" end="5035440000t" style="style0"><span style="style1">baik kepada orang yang tidak dikenali hari ini. Anda telah sangat teruk</span></p>
    <p xml:id="p144" begin="5035440000t" end="5047960000t" style="style0"><span style="style1">Tunjukkan tangan awak.</span></p>
    <p xml:id="p145" begin="5070070000t" end="5088420000t" style="style0"><span style="style1">apa? Hadiah untuk Osiris.</span></p>
    <p xml:id="p146" begin="5088420000t" end="5101770000t" style="style0"><span style="style1">ZAYA: Cepatlah!</span></p>
    <p xml:id="p147" begin="5105510000t" end="5138470000t" style="style0"><span style="style1">Thoth, Tuhan Kebijaksanaan!</span></p>
    <p xml:id="p148" begin="5189770000t" end="5211880000t" style="style0"><span style="style1">Salam, Thoth.</span></p>
    <p xml:id="p149" begin="5211880000t" end="5235640000t" style="style0"><span style="style1">bahawa bekas pelajar anda Pernahkah anda bayangkan</span></p>
    <p xml:id="p150" begin="5235640000t" end="5248160000t" style="style0"><span style="style1">adakah suatu hari nanti akan memakai mahkota Mesir?</span></p>
    <p xml:id="p151" begin="5265670000t" end="5294040000t" style="style0"><span style="style1">pelbagai sifat, Horus evinced</span></p>
    <p xml:id="p152" begin="5294040000t" end="5315310000t" style="style0"><span style="style1">beberapa daripadanya mungkin merupakan jawatan kepimpinan. kaitkan dengan</span></p>
    <p xml:id="p153" begin="5322400000t" end="5335330000t" style="style0"><span style="style1">Jika dia bernasib baik.</span></p>
    <p xml:id="p154" begin="5344090000t" end="5359940000t" style="style0"><span style="style1">(TUMPET TIUP)</span></p>
    <p xml:id="p155" begin="5359940000t" end="5395390000t" style="style0"><span style="style1">Puji Osiris!</span></p>
    <p xml:id="p156" begin="5403740000t" end="5415820000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p157" begin="5415820000t" end="5448360000t" style="style0"><span style="style1">Raja seluruh Mesir!</span></p>
    <p xml:id="p158" begin="5465870000t" end="5495900000t" style="style0"><span style="style1">Salam Ra, Tuhan Cahaya.</span></p>
    <p xml:id="p159" begin="5495900000t" end="5523020000t" style="style0"><span style="style1">SEMUA: Salam Ra, Tuan Cahaya!</span></p>
    <p xml:id="p160" begin="5535940000t" end="5565560000t" style="style0"><span style="style1">patut untuk memberkati hari ini Ayah saya telah melihat</span></p>
    <p xml:id="p161" begin="5577650000t" end="5607270000t" style="style0"><span style="style1">kerana anda semua memberkati kami dengan kemurahan hati anda.</span></p>
    <p xml:id="p162" begin="5667740000t" end="5690690000t" style="style0"><span style="style1">seseorang yang mempunyai banyak. Token daripada</span></p>
    <p xml:id="p163" begin="5706110000t" end="5725720000t" style="style0"><span style="style1">Dan dari seseorang yang mempunyai sedikit.</span></p>
    <p xml:id="p164" begin="5746150000t" end="5771600000t" style="style0"><span style="style1">dan berdiri di Gerbang Akhir, Tetapi apabila kedua-duanya mati</span></p>
    <p xml:id="p165" begin="5782450000t" end="5803300000t" style="style0"><span style="style1">apakah nilai mereka kemudian?</span></p>
    <p xml:id="p166" begin="5803300000t" end="5825410000t" style="style0"><span style="style1">Saya katakan mereka sama rata.</span></p>
    <p xml:id="p167" begin="5825410000t" end="5851260000t" style="style0"><span style="style1">Simbol kehidupan yang baik.</span></p>
    <p xml:id="p168" begin="5866270000t" end="5895890000t" style="style0"><span style="style1">ke alam Akhirat. Semua dialu-alukan</span></p>
    <p xml:id="p169" begin="5912580000t" end="5926330000t" style="style0"><span style="style1">Ini adalah warisan saya.</span></p>
    <p xml:id="p170" begin="5936340000t" end="5975560000t" style="style0"><span style="style1">kami menobatkan raja baru. Tetapi hari ini,</span></p>
    <p xml:id="p171" begin="5975560000t" end="6006410000t" style="style0"><span style="style1">dia akan mempunyai warisan Dan suatu hari nanti, dia sendiri.</span></p>
    <p xml:id="p172" begin="6006410000t" end="6038530000t" style="style0"><span style="style1">Tuhan Udara. Anak saya Horus,</span></p>
    <p xml:id="p173" begin="6038530000t" end="6056460000t" style="style0"><span style="style1">(ORANG MERAUNG DAN BERTEPUK)</span></p>
    <p xml:id="p174" begin="6177000000t" end="6193270000t" style="style0"><span style="style1">Adakah anda bersedia? (Berbisik)</span></p>
    <p xml:id="p175" begin="6201200000t" end="6215380000t" style="style0"><span style="style1">saya.</span></p>
    <p xml:id="p176" begin="6265850000t" end="6279610000t" style="style0"><span style="style1">SET: Tunggu!</span></p>
    <p xml:id="p177" begin="6279610000t" end="6293370000t" style="style0"><span style="style1">Tunggu.</span></p>
    <p xml:id="p178" begin="6293370000t" end="6312980000t" style="style0"><span style="style1">Maaf saya lambat.</span></p>
    <p xml:id="p179" begin="6312980000t" end="6339670000t" style="style0"><span style="style1">untuk menyeberangi padang pasir. Eh, tiga hari</span></p>
    <p xml:id="p180" begin="6339670000t" end="6370950000t" style="style0"><span style="style1">Dan hampir satu lagi untuk melewati semua peminat anda.</span></p>
    <p xml:id="p181" begin="6370950000t" end="6385550000t" style="style0"><span style="style1">(KERAMAI KETAWA)</span></p>
    <p xml:id="p182" begin="6386790000t" end="6401400000t" style="style0"><span style="style1">Set!</span></p>
    <p xml:id="p183" begin="6401400000t" end="6422670000t" style="style0"><span style="style1">Senang jumpa awak. Abang.</span></p>
    <p xml:id="p184" begin="6422670000t" end="6437680000t" style="style0"><span style="style1">Dan awak, abang.</span></p>
    <p xml:id="p185" begin="6437680000t" end="6456450000t" style="style0"><span style="style1">tempat untuk anda di sini. sentiasa ada</span></p>
    <p xml:id="p186" begin="6469800000t" end="6491900000t" style="style0"><span style="style1">Anda mesti bangga. Hari yang begitu besar untuk keluarga.</span></p>
    <p xml:id="p187" begin="6500660000t" end="6516920000t" style="style0"><span style="style1">saya.</span></p>
    <p xml:id="p188" begin="6516920000t" end="6548620000t" style="style0"><span style="style1">Tengok awak, anak saudara. Hebat.</span></p>
    <p xml:id="p189" begin="6548620000t" end="6560300000t" style="style0"><span style="style1">di sini akan menjadi raja yang baik. Sekurang-kurangnya seseorang</span></p>
    <p xml:id="p190" begin="6566970000t" end="6581580000t" style="style0"><span style="style1">anda tidak akan datang. Saya takut</span></p>
    <p xml:id="p191" begin="6581580000t" end="6594930000t" style="style0"><span style="style1">Tidak, saya tidak akan terlepas.</span></p>
    <p xml:id="p192" begin="6594930000t" end="6606600000t" style="style0"><span style="style1">Ah.</span></p>
    <p xml:id="p193" begin="6617860000t" end="6633300000t" style="style0"><span style="style1">untuk awak. Oh...</span></p>
    <p xml:id="p194" begin="6651650000t" end="6675840000t" style="style0"><span style="style1">Tanduk memburu.</span></p>
    <p xml:id="p195" begin="6675840000t" end="6707110000t" style="style0"><span style="style1">seekor domba jantan yang meratakan 10 tuhan lebih lambat daripada saya. Dari tengkorak</span></p>
    <p xml:id="p196" begin="6707110000t" end="6722970000t" style="style0"><span style="style1">memang cantik.</span></p>
    <p xml:id="p197" begin="6722970000t" end="6736720000t" style="style0"><span style="style1">ya? Cubalah.</span></p>
    <p xml:id="p198" begin="6780110000t" end="6793870000t" style="style0"><span style="style1">Dari Set.</span></p>
    <p xml:id="p199" begin="6793870000t" end="6806790000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p200" begin="6816400000t" end="6843920000t" style="style0"><span style="style1">Biar Ra sendiri mendengar awak. Ayuh!</span></p>
    <p xml:id="p201" begin="6867270000t" end="6886050000t" style="style0"><span style="style1">(MENIPU TUNDA) (BERSORAK)</span></p>
    <p xml:id="p202" begin="6942350000t" end="6957780000t" style="style0"><span style="style1">(LELAKI MENJERIT)</span></p>
    <p xml:id="p203" begin="6957780000t" end="6982390000t" style="style0"><span style="style1">Saya rasa seseorang mendengar anda.</span></p>
    <p xml:id="p204" begin="6982390000t" end="6994490000t" style="style0"><span style="style1">(JAJAK KAKI BERARAH)</span></p>
    <p xml:id="p205" begin="7217620000t" end="7232230000t" style="style0"><span style="style1">Apa ini, Set?</span></p>
    <p xml:id="p206" begin="7268090000t" end="7282280000t" style="style0"><span style="style1">(ASKAR TERJERIT)</span></p>
    <p xml:id="p207" begin="7287690000t" end="7300210000t" style="style0"><span style="style1">(BERKEPING)</span></p>
    <p xml:id="p208" begin="7316900000t" end="7327730000t" style="style0"><span style="style1">(ASKAR-ASKAR MENJERIT)</span></p>
    <p xml:id="p209" begin="7345680000t" end="7357760000t" style="style0"><span style="style1">Anda mengenalinya?</span></p>
    <p xml:id="p210" begin="7397800000t" end="7410320000t" style="style0"><span style="style1">Ayah memberikannya kepada kamu.</span></p>
    <p xml:id="p211" begin="7430760000t" end="7461200000t" style="style0"><span style="style1">Membuat saya hidup selama beberapa malam di padang pasir.</span></p>
    <p xml:id="p212" begin="7491650000t" end="7507910000t" style="style0"><span style="style1">Lawan saya.</span></p>
    <p xml:id="p213" begin="7507910000t" end="7521260000t" style="style0"><span style="style1">Jauhi ini, nak. Ayah, jangan.</span></p>
    <p xml:id="p214" begin="7537120000t" end="7554630000t" style="style0"><span style="style1">kenapa?</span></p>
    <p xml:id="p215" begin="7554630000t" end="7593840000t" style="style0"><span style="style1">apa yang telah anda capai? Dalam 1,000 tahun damai,</span></p>
    <p xml:id="p216" begin="7593840000t" end="7628030000t" style="style0"><span style="style1">yang tidak bermimpi lagi. Tanah orang</span></p>
    <p xml:id="p217" begin="7628030000t" end="7642640000t" style="style0"><span style="style1">Sekarang giliran saya.</span></p>
    <p xml:id="p218" begin="7642640000t" end="7662240000t" style="style0"><span style="style1">Saya tidak akan melawan.</span></p>
    <p xml:id="p219" begin="7662240000t" end="7684760000t" style="style0"><span style="style1">Saya sayang awak, abang. Dengan sepenuh hati saya.</span></p>
    <p xml:id="p220" begin="7712290000t" end="7736070000t" style="style0"><span style="style1">(ISIS TERGAS) ORANG ramai: Tidak!</span></p>
    <p xml:id="p221" begin="7736070000t" end="7748990000t" style="style0"><span style="style1">Saya sayang awak juga, abang.</span></p>
    <p xml:id="p222" begin="7770680000t" end="7784860000t" style="style0"><span style="style1">Tidak!</span></p>
    <p xml:id="p223" begin="7796130000t" end="7808210000t" style="style0"><span style="style1">ISIS: Osiris!</span></p>
    <p xml:id="p224" begin="7858260000t" end="7892470000t" style="style0"><span style="style1">Nah, ini benar-benar untuk keluarga. adalah hari yang besar</span></p>
    <p xml:id="p225" begin="7908310000t" end="7925840000t" style="style0"><span style="style1">Saya, Set,</span></p>
    <p xml:id="p226" begin="7945440000t" end="7967550000t" style="style0"><span style="style1">akan menjadi rajamu yang sejati.</span></p>
    <p xml:id="p227" begin="7974640000t" end="7999240000t" style="style0"><span style="style1">Raja seluruh Mesir!</span></p>
    <p xml:id="p228" begin="7999240000t" end="8030940000t" style="style0"><span style="style1">daripada mereka yang berdiri Lihatlah nasib di jalan saya.</span></p>
    <p xml:id="p229" begin="8044290000t" end="8058040000t" style="style0"><span style="style1">Tuhan...</span></p>
    <p xml:id="p230" begin="8073070000t" end="8097260000t" style="style0"><span style="style1">Tunduklah di hadapan saya atau mati.</span></p>
    <p xml:id="p231" begin="8137720000t" end="8178160000t" style="style0"><span style="style1">Manusia, sembahlah aku atau jadilah hamba!</span></p>
    <p xml:id="p232" begin="8213620000t" end="8228210000t" style="style0"><span style="style1">(OMONGAN MENGGUGUH)</span></p>
    <p xml:id="p233" begin="8241150000t" end="8260750000t" style="style0"><span style="style1">(LEMBUT) Bek!</span></p>
    <p xml:id="p234" begin="8260750000t" end="8288270000t" style="style0"><span style="style1">akhirat adalah anugerah. Abang fikir</span></p>
    <p xml:id="p235" begin="8301210000t" end="8328310000t" style="style0"><span style="style1">Saya fikir seorang raja harus mempunyai standard yang lebih tinggi.</span></p>
    <p xml:id="p236" begin="8338740000t" end="8362940000t" style="style0"><span style="style1">anda perlu membeli Mulai sekarang, cara anda masuk</span></p>
    <p xml:id="p237" begin="8362940000t" end="8377960000t" style="style0"><span style="style1">dengan kekayaan yang diperolehi.</span></p>
    <p xml:id="p238" begin="8408810000t" end="8428830000t" style="style0"><span style="style1">(BERNAFAS TERGEGAR)</span></p>
    <p xml:id="p239" begin="8428830000t" end="8452190000t" style="style0"><span style="style1">baru sahaja bermula. perjalanan awak</span></p>
    <p xml:id="p240" begin="8467630000t" end="8481810000t" style="style0"><span style="style1">(TERKESAK) (TERESAK)</span></p>
    <p xml:id="p241" begin="8558960000t" end="8571480000t" style="style0"><span style="style1">(MENANGIS)</span></p>
    <p xml:id="p242" begin="8624030000t" end="8638630000t" style="style0"><span style="style1">Ia milik anda sekarang.</span></p>
    <p xml:id="p243" begin="8655730000t" end="8674080000t" style="style0"><span style="style1">tetapi sekarang bukan masanya. Ramai di antara kami akan berdiri bersama anda,</span></p>
    <p xml:id="p244" begin="8731640000t" end="8749150000t" style="style0"><span style="style1">-Saya memandang tinggi kepada awak. -Sudah tentu anda lakukan.</span></p>
    <p xml:id="p245" begin="8755420000t" end="8768760000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p246" begin="8779180000t" end="8793370000t" style="style0"><span style="style1">Itu tidak bijak.</span></p>
    <p xml:id="p247" begin="8853430000t" end="8869270000t" style="style0"><span style="style1">anda masih tidak pernah rindu? Adakah ia benar</span></p>
    <p xml:id="p248" begin="8869270000t" end="8883460000t" style="style0"><span style="style1">Tidakkah itu menjadi membosankan?</span></p>
    <p xml:id="p249" begin="8916410000t" end="8933510000t" style="style0"><span style="style1">(ORANG TERKESAK) (SET KETAWA)</span></p>
    <p xml:id="p250" begin="8933510000t" end="8946440000t" style="style0"><span style="style1">penglihatan adalah sempurna. Saya fikir awak</span></p>
    <p xml:id="p251" begin="9056130000t" end="9069060000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p252" begin="9147480000t" end="9159560000t" style="style0"><span style="style1">(KEDUA-DUA MENDERENG)</span></p>
    <p xml:id="p253" begin="9209610000t" end="9221710000t" style="style0"><span style="style1">Anda berlawan dengan baik.</span></p>
    <p xml:id="p254" begin="9230050000t" end="9246320000t" style="style0"><span style="style1">Adakah anda pasti anda anaknya?</span></p>
    <p xml:id="p255" begin="9347680000t" end="9359760000t" style="style0"><span style="style1">(MENYEDUT TAMAT)</span></p>
    <p xml:id="p256" begin="9378540000t" end="9390630000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p257" begin="9429830000t" end="9442350000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p258" begin="9466540000t" end="9479470000t" style="style0"><span style="style1">(MERENGANG)</span></p>
    <p xml:id="p259" begin="9530350000t" end="9545370000t" style="style0"><span style="style1">(ORANG RAMAI MENJERIT)</span></p>
    <p xml:id="p260" begin="9716380000t" end="9729720000t" style="style0"><span style="style1">(SET MENGERUM)</span></p>
    <p xml:id="p261" begin="9835240000t" end="9849430000t" style="style0"><span style="style1">Ia akan!</span></p>
    <p xml:id="p262" begin="9860260000t" end="9875700000t" style="style0"><span style="style1">Tunggu! Zaya!</span></p>
    <p xml:id="p263" begin="9881120000t" end="9890710000t" style="style0"><span style="style1">Pembela!</span></p>
    <p xml:id="p264" begin="9890710000t" end="9907820000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p265" begin="9918250000t" end="9934510000t" style="style0"><span style="style1">(ASKAR TERJERIT)</span></p>
    <p xml:id="p266" begin="9934510000t" end="9949110000t" style="style0"><span style="style1">(HORUS mendengus)</span></p>
    <p xml:id="p267" begin="10203530000t" end="10233560000t" style="style0"><span style="style1">Awak tak layak jadi Raja. Saya membantu Mesir.</span></p>
    <p xml:id="p268" begin="10248990000t" end="10260660000t" style="style0"><span style="style1">(MENGERING)</span></p>
    <p xml:id="p269" begin="10300700000t" end="10315310000t" style="style0"><span style="style1">(HORUS TERUS MENGERANG)</span></p>
    <p xml:id="p270" begin="10353680000t" end="10376620000t" style="style0"><span style="style1">(MENJERIT) Tidak!</span></p>
    <p xml:id="p271" begin="10376620000t" end="10390380000t" style="style0"><span style="style1">Tidak!</span></p>
    <p xml:id="p272" begin="10447940000t" end="10464200000t" style="style0"><span style="style1">(HORUS MENGERANG)</span></p>
    <p xml:id="p273" begin="10513000000t" end="10530520000t" style="style0"><span style="style1">(MENANGIS)</span></p>
    <p xml:id="p274" begin="10563470000t" end="10577650000t" style="style0"><span style="style1">Set!</span></p>
    <p xml:id="p275" begin="10739900000t" end="10750740000t" style="style0"><span style="style1">(LEMBUT) Maafkan saya, Bapa.</span></p>
    <p xml:id="p276" begin="10771170000t" end="10786190000t" style="style0"><span style="style1">(ASKAR MENJERIT)</span></p>
    <p xml:id="p277" begin="10812880000t" end="10828320000t" style="style0"><span style="style1">(GROWLES)</span></p>
    <p xml:id="p278" begin="10828320000t" end="10840830000t" style="style0"><span style="style1">BEK: Zaya!</span></p>
    <p xml:id="p279" begin="10844170000t" end="10858350000t" style="style0"><span style="style1">Ia akan!</span></p>
    <p xml:id="p280" begin="10924250000t" end="10958450000t" style="style0"><span style="style1">Jadi Set adalah Raja. BEK LAMA:</span></p>
    <p xml:id="p281" begin="10958450000t" end="10994320000t" style="style0"><span style="style1">banyak tuhan menentangnya. Pada tahun berikutnya,</span></p>
    <p xml:id="p282" begin="10994320000t" end="11034360000t" style="style0"><span style="style1">mereka membayar dengan nyawa mereka. satu persatu,</span></p>
    <p xml:id="p283" begin="11034360000t" end="11061460000t" style="style0"><span style="style1">keadaan menjadi lebih teruk. Untuk manusia,</span></p>
    <p xml:id="p284" begin="11070230000t" end="11091490000t" style="style0"><span style="style1">Kebanyakan dipaksa menjadi hamba,</span></p>
    <p xml:id="p285" begin="11091490000t" end="11111510000t" style="style0"><span style="style1">sen terkecil dan dinafikan walaupun</span></p>
    <p xml:id="p286" begin="11111510000t" end="11141540000t" style="style0"><span style="style1">ke alam Akhirat. untuk membeli cara kami</span></p>
    <p xml:id="p287" begin="11141540000t" end="11181580000t" style="style0"><span style="style1">Horus berundur ke dalam buangan. Buta dan kalah,</span></p>
    <p xml:id="p288" begin="11181580000t" end="11203690000t" style="style0"><span style="style1">Mereka yang berdoa untuknya menyelamatkan Mesir</span></p>
    <p xml:id="p289" begin="11203690000t" end="11221210000t" style="style0"><span style="style1">sangat kecewa.</span></p>
    <p xml:id="p290" begin="11230390000t" end="11256660000t" style="style0"><span style="style1">Tetapi saya tidak pernah banyak untuk solat.</span></p>
    <p xml:id="p291" begin="11256660000t" end="11282940000t" style="style0"><span style="style1">menjadi hamba kepada tuan yang kejam. Saya telah menemui Zaya</span></p>
    <p xml:id="p292" begin="11301700000t" end="11330490000t" style="style0"><span style="style1">Tetapi bagaimana saya boleh membebaskannya daripada semua ini?</span></p>
    <p xml:id="p293" begin="11330490000t" end="11352590000t" style="style0"><span style="style1">Ia adalah rancangan yang paling gila.</span></p>
    <p xml:id="p294" begin="11482300000t" end="11501900000t" style="style0"><span style="style1">kawal angin, Zaya, Anda mungkin tidak</span></p>
    <p xml:id="p295" begin="11501900000t" end="11517340000t" style="style0"><span style="style1">boleh menutup pengatup. tetapi saya fikir awak</span></p>
    <p xml:id="p296" begin="11524430000t" end="11539030000t" style="style0"><span style="style1">Maaf, Tuanku.</span></p>
    <p xml:id="p297" begin="11566560000t" end="11602000000t" style="style0"><span style="style1">Cantik, jika saya mendapati meja saya tidak teratur lagi,</span></p>
    <p xml:id="p298" begin="11602000000t" end="11620360000t" style="style0"><span style="style1">Saya akan baling awak ke luar untuk menolak batu.</span></p>
    <p xml:id="p299" begin="11620360000t" end="11632870000t" style="style0"><span style="style1">Adakah itu jelas?</span></p>
    <p xml:id="p300" begin="11687930000t" end="11703360000t" style="style0"><span style="style1">URSHU: Ayuh, ayuh! Tidak mendapat sepanjang hari.</span></p>
    <p xml:id="p301" begin="11756330000t" end="11781360000t" style="style0"><span style="style1">Saya ingin menjatuhkannya dari ketinggian yang tinggi. (KECEWA)</span></p>
    <p xml:id="p302" begin="11781360000t" end="11800540000t" style="style0"><span style="style1">Pagi. (KECEWA)</span></p>
    <p xml:id="p303" begin="11800540000t" end="11815140000t" style="style0"><span style="style1">(URSHU DESA) (WHIPLASH)</span></p>
    <p xml:id="p304" begin="11815140000t" end="11837240000t" style="style0"><span style="style1">Satu hari nanti, saya akan rampas awak dari dia.</span></p>
    <p xml:id="p305" begin="11837240000t" end="11853920000t" style="style0"><span style="style1">selalu jawapannya? ZAYA: Adakah kecurian</span></p>
    <p xml:id="p306" begin="11853920000t" end="11880210000t" style="style0"><span style="style1">Anda sama ada kaya atau tidak. Ia kini berada di dunia ini.</span></p>
    <p xml:id="p307" begin="11880210000t" end="11893550000t" style="style0"><span style="style1">(TERKECAK LEMBUT)</span></p>
    <p xml:id="p308" begin="11898140000t" end="11914400000t" style="style0"><span style="style1">Walaupun awak boleh membebaskan saya,</span></p>
    <p xml:id="p309" begin="11914400000t" end="11941520000t" style="style0"><span style="style1">bagaimana dengan keluarga saya? kawan kita?</span></p>
    <p xml:id="p310" begin="11941520000t" end="11962360000t" style="style0"><span style="style1">Bolehkah anda mencuri semua Mesir dari Set?</span></p>
    <p xml:id="p311" begin="11962360000t" end="11983220000t" style="style0"><span style="style1">Hanya Horus yang boleh membebaskan kita. (SCOFFS)</span></p>
    <p xml:id="p312" begin="11983220000t" end="11999490000t" style="style0"><span style="style1">Anda benar-benar percaya tuhan peduli?</span></p>
    <p xml:id="p313" begin="11999490000t" end="12012000000t" style="style0"><span style="style1">Jika Horus boleh datang, dia akan datang.</span></p>
    <p xml:id="p314" begin="12024090000t" end="12039950000t" style="style0"><span style="style1">Saya nak tunjukkan sesuatu.</span></p>
    <p xml:id="p315" begin="12122520000t" end="12148810000t" style="style0"><span style="style1">ZAYA: Tentera Set pulang membawa rampasan perang.</span></p>
    <p xml:id="p316" begin="12148810000t" end="12162980000t" style="style0"><span style="style1">Bilik kebalnya akan dibuka malam ini.</span></p>
    <p xml:id="p317" begin="12162980000t" end="12177170000t" style="style0"><span style="style1">Masa yang sesuai</span></p>
    <p xml:id="p318" begin="12177170000t" end="12190930000t" style="style0"><span style="style1">untuk menyelinap masuk. untuk seseorang</span></p>
    <p xml:id="p319" begin="12190930000t" end="12207200000t" style="style0"><span style="style1">kenapa?</span></p>
    <p xml:id="p320" begin="12207200000t" end="12229720000t" style="style0"><span style="style1">Mereka mengatakan mata Horus disimpan di sana.</span></p>
    <p xml:id="p321" begin="12229720000t" end="12242640000t" style="style0"><span style="style1">kuasanya lagi. Dia akan mempunyai</span></p>
    <p xml:id="p322" begin="12242640000t" end="12257660000t" style="style0"><span style="style1">Mencuri dari tuhan?</span></p>
    <p xml:id="p323" begin="12257660000t" end="12282680000t" style="style0"><span style="style1">Hanya orang gila yang akan mencuba perkara sedemikian.</span></p>
    <p xml:id="p324" begin="12282680000t" end="12302290000t" style="style0"><span style="style1">kita boleh cari seseorang yang sangat marah? Mana agaknya</span></p>
    <p xml:id="p325" begin="12318560000t" end="12335660000t" style="style0"><span style="style1">Perancangan sepatutnya ada di sini.</span></p>
    <p xml:id="p326" begin="12335660000t" end="12352340000t" style="style0"><span style="style1">Urshu membina peti besi. Dia arkitek Set.</span></p>
    <p xml:id="p327" begin="12369030000t" end="12383200000t" style="style0"><span style="style1">Apa ini?</span></p>
    <p xml:id="p328" begin="12390720000t" end="12402390000t" style="style0"><span style="style1">Eh, piramid pasir Set.</span></p>
    <p xml:id="p329" begin="12424490000t" end="12442840000t" style="style0"><span style="style1">BEK: Dia telah membina dirinya sendiri sebagai lubang api.</span></p>
    <p xml:id="p330" begin="12442840000t" end="12464530000t" style="style0"><span style="style1">Dia mesti memasak jamuan besar-besaran.</span></p>
    <p xml:id="p331" begin="12464530000t" end="12482880000t" style="style0"><span style="style1">Ia adalah lubang ke pusat dunia.</span></p>
    <p xml:id="p332" begin="12482880000t" end="12507500000t" style="style0"><span style="style1">Sumber kuasanya. Tiada kenduri.</span></p>
    <p xml:id="p333" begin="12521260000t" end="12532520000t" style="style0"><span style="style1">Terjumpa.</span></p>
    <p xml:id="p334" begin="12546700000t" end="12572970000t" style="style0"><span style="style1">Harta itu akan melalui pintu pagar hadapan.</span></p>
    <p xml:id="p335" begin="12572970000t" end="12582980000t" style="style0"><span style="style1">bukan masalahnya. Pintu pagar hadapan</span></p>
    <p xml:id="p336" begin="12582980000t" end="12603000000t" style="style0"><span style="style1">Ia adalah apa yang datang selepas.</span></p>
    <p xml:id="p337" begin="12603000000t" end="12623020000t" style="style0"><span style="style1">diikat dengan perangkap. Dua jambatan</span></p>
    <p xml:id="p338" begin="12623020000t" end="12633450000t" style="style0"><span style="style1">daripada mereka tanpa henti. Urshu bermegah</span></p>
    <p xml:id="p339" begin="12642220000t" end="12655140000t" style="style0"><span style="style1">Nasib baik saya menipu.</span></p>
    <p xml:id="p340" begin="12803200000t" end="12817390000t" style="style0"><span style="style1">betul, askar. Selamat datang saya</span></p>
    <p xml:id="p341" begin="12833230000t" end="12852010000t" style="style0"><span style="style1">Ratu Mesir menunggu. jangan simpan</span></p>
    <p xml:id="p342" begin="13005070000t" end="13030100000t" style="style0"><span style="style1">SET: Saya rasa awak merindui saya. (KECEWA)</span></p>
    <p xml:id="p343" begin="13030100000t" end="13053450000t" style="style0"><span style="style1">Saya mesti rindu awak.</span></p>
    <p xml:id="p344" begin="13053450000t" end="13065550000t" style="style0"><span style="style1">Lagipun saya banduan awak.</span></p>
    <p xml:id="p345" begin="13065550000t" end="13084320000t" style="style0"><span style="style1">Oh, penjara ini tidak begitu teruk.</span></p>
    <p xml:id="p346" begin="13084320000t" end="13100170000t" style="style0"><span style="style1">Well, saya sengsara.</span></p>
    <p xml:id="p347" begin="13113930000t" end="13129790000t" style="style0"><span style="style1">Anda mempunyai cara yang lucu untuk menunjukkannya.</span></p>
    <p xml:id="p348" begin="13133530000t" end="13157310000t" style="style0"><span style="style1">Bolehkah saya meminjam pisau anda?</span></p>
    <p xml:id="p349" begin="13157310000t" end="13199860000t" style="style0"><span style="style1">Jadi jika anda mempunyai peluang, anda akan membunuh saya?</span></p>
    <p xml:id="p350" begin="13209450000t" end="13221960000t" style="style0"><span style="style1">Bagaimana saya boleh membunuh awak?</span></p>
    <p xml:id="p351" begin="13235300000t" end="13251160000t" style="style0"><span style="style1">Tetapi anda akan melakukannya jika anda boleh.</span></p>
    <p xml:id="p352" begin="13263660000t" end="13280350000t" style="style0"><span style="style1">Lebih baik buka mata. (Berbisik)</span></p>
    <p xml:id="p353" begin="13383780000t" end="13395880000t" style="style0"><span style="style1">Set Tuhan.</span></p>
    <p xml:id="p354" begin="13403800000t" end="13418410000t" style="style0"><span style="style1">(KETAWA) Oh...</span></p>
    <p xml:id="p355" begin="13418410000t" end="13433010000t" style="style0"><span style="style1">Dan, eh... Puan.</span></p>
    <p xml:id="p356" begin="13443840000t" end="13463860000t" style="style0"><span style="style1">datang pada masa yang lebih baik. Mungkin saya boleh</span></p>
    <p xml:id="p357" begin="13463860000t" end="13484720000t" style="style0"><span style="style1">SET: Tidak, masuklah. Jangan malu.</span></p>
    <p xml:id="p358" begin="13484720000t" end="13500160000t" style="style0"><span style="style1">(SET MENGELUPASKAN)</span></p>
    <p xml:id="p359" begin="13524760000t" end="13538940000t" style="style0"><span style="style1">Ayuh.</span></p>
    <p xml:id="p360" begin="13614010000t" end="13654050000t" style="style0"><span style="style1">Tiada siapa yang pernah begitu menghormati Tuhan Ra.</span></p>
    <p xml:id="p361" begin="13654050000t" end="13677830000t" style="style0"><span style="style1">di atas puncaknya dan keajaiban Dia akan berlalu</span></p>
    <p xml:id="p362" begin="13677830000t" end="13695350000t" style="style0"><span style="style1">pada penghormatan yang telah kamu bina dalam nama-Nya.</span></p>
    <p xml:id="p363" begin="13710780000t" end="13723700000t" style="style0"><span style="style1">Adakah itu?</span></p>
    <p xml:id="p364" begin="13732470000t" end="13745400000t" style="style0"><span style="style1">saya minta maaf?</span></p>
    <p xml:id="p365" begin="13753330000t" end="13766250000t" style="style0"><span style="style1">Nah, bolehkah anda menjadikannya lebih tinggi?</span></p>
    <p xml:id="p366" begin="13785020000t" end="13800460000t" style="style0"><span style="style1">Lebih tinggi?</span></p>
    <p xml:id="p367" begin="13800460000t" end="13825060000t" style="style0"><span style="style1">Ya, ia adalah soalan mudah.</span></p>
    <p xml:id="p368" begin="13825060000t" end="13843820000t" style="style0"><span style="style1">itu mungkin sukar, emm, (GAGAP) Nah,</span></p>
    <p xml:id="p369" begin="13854250000t" end="13871360000t" style="style0"><span style="style1">sekarang, maksud saya...</span></p>
    <p xml:id="p370" begin="13871360000t" end="13889710000t" style="style0"><span style="style1">Tenang, Urshu. Saya bergurau.</span></p>
    <p xml:id="p371" begin="13902640000t" end="13914310000t" style="style0"><span style="style1">(KETAWA)</span></p>
    <p xml:id="p372" begin="13924320000t" end="13937260000t" style="style0"><span style="style1">beritahu saya,</span></p>
    <p xml:id="p373" begin="13948100000t" end="13974370000t" style="style0"><span style="style1">kenapa bapa kamu memilih kamu untuk menjadi pembina tuan</span></p>
    <p xml:id="p374" begin="13974370000t" end="13996900000t" style="style0"><span style="style1">salah seorang abang awak? bukannya</span></p>
    <p xml:id="p375" begin="13996900000t" end="14020260000t" style="style0"><span style="style1">Saya rasa kerana saya terbukti menjadi yang terbaik, Tuhanku.</span></p>
    <p xml:id="p376" begin="14020260000t" end="14045280000t" style="style0"><span style="style1">menjadi yang terbaik buat ayah. Seperti yang saya akan buktikan</span></p>
    <p xml:id="p377" begin="14064460000t" end="14098250000t" style="style0"><span style="style1">dari subuh hingga senja. Dia akan melihatnya</span></p>
    <p xml:id="p378" begin="14098250000t" end="14115770000t" style="style0"><span style="style1">bernilai lebih daripada emas. kepuasan anda</span></p>
    <p xml:id="p379" begin="14124520000t" end="14144540000t" style="style0"><span style="style1">Oh, emas, emas!</span></p>
    <p xml:id="p380" begin="14144540000t" end="14159560000t" style="style0"><span style="style1">Anda akan mempunyai banyak untuk Kehidupan Akhirat. emas secukupnya</span></p>
    <p xml:id="p381" begin="14159560000t" end="14173330000t" style="style0"><span style="style1">Dan roti bakar!</span></p>
    <p xml:id="p382" begin="14182920000t" end="14199600000t" style="style0"><span style="style1">Kepada pembina terhebat Mesir.</span></p>
    <p xml:id="p383" begin="14219620000t" end="14247980000t" style="style0"><span style="style1">Roti bakar untuk legasi saya.</span></p>
    <p xml:id="p384" begin="14264660000t" end="14277180000t" style="style0"><span style="style1">(GAJAH TRUMPET)</span></p>
    <p xml:id="p385" begin="14409810000t" end="14424000000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p386" begin="14471960000t" end="14484880000t" style="style0"><span style="style1">(BERNAFAS BERAT)</span></p>
    <p xml:id="p387" begin="14794370000t" end="14806460000t" style="style0"><span style="style1">(BEK MENJERIT)</span></p>
    <p xml:id="p388" begin="14821480000t" end="14834810000t" style="style0"><span style="style1">Whoa!</span></p>
    <p xml:id="p389" begin="14842330000t" end="14854830000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p390" begin="15000400000t" end="15014990000t" style="style0"><span style="style1">(BERCERITA)</span></p>
    <p xml:id="p391" begin="15027510000t" end="15043780000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p392" begin="15054630000t" end="15069640000t" style="style0"><span style="style1">dapat kala jengking sebanyak itu? Di mana anda juga</span></p>
    <p xml:id="p393" begin="15426240000t" end="15446680000t" style="style0"><span style="style1">Cukup untuk membuat anda takut pada bayang-bayang anda sendiri.</span></p>
    <p xml:id="p394" begin="15746140000t" end="15765740000t" style="style0"><span style="style1">&quot;Bulatan adalah pencetus.&quot;</span></p>
    <p xml:id="p395" begin="15794950000t" end="15807460000t" style="style0"><span style="style1">Jadi saya akan pergi pusingan.</span></p>
    <p xml:id="p396" begin="15851250000t" end="15867520000t" style="style0"><span style="style1">Nah, itu mudah.</span></p>
    <p xml:id="p397" begin="15896290000t" end="15909230000t" style="style0"><span style="style1">(BERGERAK)</span></p>
    <p xml:id="p398" begin="16140710000t" end="16155730000t" style="style0"><span style="style1">(BERNAFAS TERGEGAR)</span></p>
    <p xml:id="p399" begin="16175750000t" end="16187840000t" style="style0"><span style="style1">(TERHANGAT)</span></p>
    <p xml:id="p400" begin="16233300000t" end="16246220000t" style="style0"><span style="style1">Jambatan ketiga.</span></p>
    <p xml:id="p401" begin="16279600000t" end="16298780000t" style="style0"><span style="style1">Tidak mengatakan apa-apa tentang jambatan ketiga.</span></p>
    <p xml:id="p402" begin="16316710000t" end="16329650000t" style="style0"><span style="style1">Ini penjenayah.</span></p>
    <p xml:id="p403" begin="16349670000t" end="16363850000t" style="style0"><span style="style1">Dan hanya satu mata.</span></p>
    <p xml:id="p404" begin="16410560000t" end="16427660000t" style="style0"><span style="style1">Hebat.</span></p>
    <p xml:id="p405" begin="16427660000t" end="16462280000t" style="style0"><span style="style1">Zaya, awak akan berdoa, saya akan gulung tulang.</span></p>
    <p xml:id="p406" begin="16492730000t" end="16506480000t" style="style0"><span style="style1">(BERGERAK)</span></p>
    <p xml:id="p407" begin="16576970000t" end="16589490000t" style="style0"><span style="style1">(JERENG)</span></p>
    <p xml:id="p408" begin="16671660000t" end="16686260000t" style="style0"><span style="style1">(JENGKENG KENGKENG BERCERITA)</span></p>
    <p xml:id="p409" begin="16689590000t" end="16703770000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p410" begin="16770920000t" end="16784690000t" style="style0"><span style="style1">(KECIK)</span></p>
    <p xml:id="p411" begin="16865600000t" end="16877270000t" style="style0"><span style="style1">Ia akan!</span></p>
    <p xml:id="p412" begin="16897290000t" end="16909810000t" style="style0"><span style="style1">(BERBISIK) Saya minta maaf.</span></p>
    <p xml:id="p413" begin="16944010000t" end="16976950000t" style="style0"><span style="style1">tidak mencukupi... Seolah-olah menggunakan rumah saya untuk perzinaan kamu</span></p>
    <p xml:id="p414" begin="17027420000t" end="17042860000t" style="style0"><span style="style1">Anda berani mencuri daripada Raja?</span></p>
    <p xml:id="p415" begin="17110430000t" end="17140460000t" style="style0"><span style="style1">di pejabat yang teratur, Zaya. Saya bangga diri</span></p>
    <p xml:id="p416" begin="17156730000t" end="17183420000t" style="style0"><span style="style1">faham itu, adakah anda? Awak tak pernah buat</span></p>
    <p xml:id="p417" begin="17183420000t" end="17207600000t" style="style0"><span style="style1">Oh, dan perhiasan kecil awak yang menyedihkan ini</span></p>
    <p xml:id="p418" begin="17207600000t" end="17227620000t" style="style0"><span style="style1">awak, saya takut. tidak akan menyelamatkan kedua-duanya</span></p>
    <p xml:id="p419" begin="17227620000t" end="17241810000t" style="style0"><span style="style1">(LEMBUT) Set adalah tuhan anda.</span></p>
    <p xml:id="p420" begin="17241810000t" end="17257240000t" style="style0"><span style="style1">-Itu semua idea saya. -Pembohong!</span></p>
    <p xml:id="p421" begin="17317710000t" end="17332730000t" style="style0"><span style="style1">apa yang anda ambil. Kembalikan saya</span></p>
    <p xml:id="p422" begin="17399460000t" end="17416990000t" style="style0"><span style="style1">terima kasih.</span></p>
    <p xml:id="p423" begin="17432420000t" end="17451180000t" style="style0"><span style="style1">kepada serigala. -Makan mereka -Tunggu!</span></p>
    <p xml:id="p424" begin="17464530000t" end="17486220000t" style="style0"><span style="style1">(BERNAFAS BERAT)</span></p>
    <p xml:id="p425" begin="17486220000t" end="17503320000t" style="style0"><span style="style1">Saya mengambil sesuatu yang lain. (URSHU MENJERIT)</span></p>
    <p xml:id="p426" begin="17553790000t" end="17569220000t" style="style0"><span style="style1">(Merengus) Lari!</span></p>
    <p xml:id="p427" begin="17632620000t" end="17644710000t" style="style0"><span style="style1">(MENANGKUNG KUDA) (Mendesak)</span></p>
    <p xml:id="p428" begin="17751070000t" end="17776930000t" style="style0"><span style="style1">(KECEWA) Awak berjaya. mana yang lain?</span></p>
    <p xml:id="p429" begin="17789850000t" end="17808620000t" style="style0"><span style="style1">Anda tahu betapa sukarnya untuk mencuri yang itu?</span></p>
    <p xml:id="p430" begin="17808620000t" end="17823220000t" style="style0"><span style="style1">(KEDUANYA KETAWA)</span></p>
    <p xml:id="p431" begin="17848240000t" end="17860760000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p432" begin="17885370000t" end="17897880000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p433" begin="17990470000t" end="18005490000t" style="style0"><span style="style1">(Tercungap-cungap)</span></p>
    <p xml:id="p434" begin="18005490000t" end="18018000000t" style="style0"><span style="style1">Saya akan sayang awak selamanya.</span></p>
    <p xml:id="p435" begin="18021340000t" end="18033430000t" style="style0"><span style="style1">Ia akan.</span></p>
    <p xml:id="p436" begin="18033430000t" end="18048030000t" style="style0"><span style="style1">Kematian bukanlah penamat.</span></p>
    <p xml:id="p437" begin="18050950000t" end="18065130000t" style="style0"><span style="style1">Ia akan.</span></p>
    <p xml:id="p438" begin="18214870000t" end="18224460000t" style="style0"><span style="style1">(KUDA MENGERANG)</span></p>
    <p xml:id="p439" begin="18224460000t" end="18236970000t" style="style0"><span style="style1">Wah.</span></p>
    <p xml:id="p440" begin="18298690000t" end="18314970000t" style="style0"><span style="style1">Saya akan perbetulkan, Zaya.</span></p>
    <p xml:id="p441" begin="18740800000t" end="18761240000t" style="style0"><span style="style1">mana-mana jemaah lagi. HORUS: Saya tidak perlu</span></p>
    <p xml:id="p442" begin="18777510000t" end="18799190000t" style="style0"><span style="style1">Penghormatan yang busuk dan busuk.</span></p>
    <p xml:id="p443" begin="18812130000t" end="18837570000t" style="style0"><span style="style1">Melainkan anda membawa lebih banyak wain, keluar.</span></p>
    <p xml:id="p444" begin="18847170000t" end="18859250000t" style="style0"><span style="style1">Saya bukan ahli ibadah.</span></p>
    <p xml:id="p445" begin="18869260000t" end="18888870000t" style="style0"><span style="style1">awak ni apa? Pencuri?</span></p>
    <p xml:id="p446" begin="18899290000t" end="18918490000t" style="style0"><span style="style1">ya. Seorang pencuri.</span></p>
    <p xml:id="p447" begin="18933080000t" end="18949340000t" style="style0"><span style="style1">Set mengambil daripada anda. Saya ada sesuatu</span></p>
    <p xml:id="p448" begin="18961020000t" end="18978130000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p449" begin="19049440000t" end="19069880000t" style="style0"><span style="style1">Tiada manusia yang boleh merompak bilik kebal Set.</span></p>
    <p xml:id="p450" begin="19084070000t" end="19107430000t" style="style0"><span style="style1">Anda merompak salah seorang mayat pengikut saya.</span></p>
    <p xml:id="p451" begin="19107430000t" end="19119100000t" style="style0"><span style="style1">Mereka tidak pernah rapat pun.</span></p>
    <p xml:id="p452" begin="19126610000t" end="19139120000t" style="style0"><span style="style1">Berikan mereka kepada saya.</span></p>
    <p xml:id="p453" begin="19141620000t" end="19154550000t" style="style0"><span style="style1">belum lagi.</span></p>
    <p xml:id="p454" begin="19154550000t" end="19169560000t" style="style0"><span style="style1">Berikan saya mata saya.</span></p>
    <p xml:id="p455" begin="19169560000t" end="19185420000t" style="style0"><span style="style1">Saya ada cadangan.</span></p>
    <p xml:id="p456" begin="19185420000t" end="19199180000t" style="style0"><span style="style1">Awak tawar-menawar dengan saya?</span></p>
    <p xml:id="p457" begin="19209600000t" end="19222950000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p458" begin="19288860000t" end="19306370000t" style="style0"><span style="style1">saya sanggup. awak bertuah</span></p>
    <p xml:id="p459" begin="19306370000t" end="19319710000t" style="style0"><span style="style1">seekor gajah berkaki tiga. Anda tidak boleh menyerang</span></p>
    <p xml:id="p460" begin="19333480000t" end="19358090000t" style="style0"><span style="style1">Anda mahukan ganjaran, saya rasa? emas?</span></p>
    <p xml:id="p461" begin="19358090000t" end="19371850000t" style="style0"><span style="style1">Emas saya boleh curi. (Merengus)</span></p>
    <p xml:id="p462" begin="19539930000t" end="19554120000t" style="style0"><span style="style1">(BERKEPEK) (HELUH)</span></p>
    <p xml:id="p463" begin="19585820000t" end="19598750000t" style="style0"><span style="style1">Ada seseorang yang saya mahu selamatkan.</span></p>
    <p xml:id="p464" begin="19632110000t" end="19646710000t" style="style0"><span style="style1">Dari apa?</span></p>
    <p xml:id="p465" begin="19658390000t" end="19670480000t" style="style0"><span style="style1">Kematian.</span></p>
    <p xml:id="p466" begin="19670480000t" end="19690920000t" style="style0"><span style="style1">(SCOFFS)</span></p>
    <p xml:id="p467" begin="19690920000t" end="19703850000t" style="style0"><span style="style1">Bukankah ayahmu mengajar bahawa kematian bukanlah penamat?</span></p>
    <p xml:id="p468" begin="19703850000t" end="19725120000t" style="style0"><span style="style1">Ia tidak boleh dilakukan.</span></p>
    <p xml:id="p469" begin="19725120000t" end="19750980000t" style="style0"><span style="style1">Nah, fikirkan. Tuhan Udara! awak Horus,</span></p>
    <p xml:id="p470" begin="19750980000t" end="19773090000t" style="style0"><span style="style1">Atau mungkin saya akan melemparkan apa yang saya ada di Sungai Nil.</span></p>
    <p xml:id="p471" begin="19773090000t" end="19787270000t" style="style0"><span style="style1">Tunggu.</span></p>
    <p xml:id="p472" begin="19890280000t" end="19901130000t" style="style0"><span style="style1">HORUS: Tetap bersama yang hidup.</span></p>
    <p xml:id="p473" begin="19910300000t" end="19924490000t" style="style0"><span style="style1">Tetap bersama yang hidup.</span></p>
    <p xml:id="p474" begin="19937000000t" end="19949100000t" style="style0"><span style="style1">Tetap bersama yang hidup.</span></p>
    <p xml:id="p475" begin="19987050000t" end="20010400000t" style="style0"><span style="style1">di mana saya boleh menghubunginya. -Dia sudah melampaui -Tetapi awak adalah tuhan.</span></p>
    <p xml:id="p476" begin="20010400000t" end="20029600000t" style="style0"><span style="style1">1,000 tahun anda, Tuhan boleh hidup</span></p>
    <p xml:id="p477" begin="20029600000t" end="20045030000t" style="style0"><span style="style1">mengubati kematian. tetapi kita tidak boleh</span></p>
    <p xml:id="p478" begin="20060450000t" end="20080470000t" style="style0"><span style="style1">Sudah tiba masanya untuk dia berjalan di laluan itu.</span></p>
    <p xml:id="p479" begin="20080470000t" end="20090480000t" style="style0"><span style="style1">sesuatu yang boleh anda lakukan. mesti ada</span></p>
    <p xml:id="p480" begin="20090480000t" end="20103000000t" style="style0"><span style="style1">Saya telah melakukan semua yang saya boleh.</span></p>
    <p xml:id="p481" begin="20121350000t" end="20146380000t" style="style0"><span style="style1">Oh, engkau yang kekal,</span></p>
    <p xml:id="p482" begin="20146380000t" end="20167650000t" style="style0"><span style="style1">utuskan hambamu untuk membimbing orang mati kepada kehidupan baru.</span></p>
    <p xml:id="p483" begin="20227710000t" end="20245640000t" style="style0"><span style="style1">Anubis, keluar.</span></p>
    <p xml:id="p484" begin="20245640000t" end="20260240000t" style="style0"><span style="style1">(ANGIN MENGERUNG)</span></p>
    <p xml:id="p485" begin="20381190000t" end="20398300000t" style="style0"><span style="style1">Anda dibebaskan.</span></p>
    <p xml:id="p486" begin="20483800000t" end="20519670000t" style="style0"><span style="style1">Pintu Bumi terbuka untuk anda.</span></p>
    <p xml:id="p487" begin="20519670000t" end="20540110000t" style="style0"><span style="style1">Anda mesti memulakan perjalanan anda.</span></p>
    <p xml:id="p488" begin="20540110000t" end="20555120000t" style="style0"><span style="style1">Dia mati sebagai hamba.</span></p>
    <p xml:id="p489" begin="20555120000t" end="20568050000t" style="style0"><span style="style1">dia tidak akan dibenarkan Tanpa harta,</span></p>
    <p xml:id="p490" begin="20568050000t" end="20580560000t" style="style0"><span style="style1">melalui Pintu Akhir.</span></p>
    <p xml:id="p491" begin="20585150000t" end="20601410000t" style="style0"><span style="style1">Apa yang anda tawarkan?</span></p>
    <p xml:id="p492" begin="20601410000t" end="20620600000t" style="style0"><span style="style1">ke alam Akhirat. Dia tidak boleh lulus</span></p>
    <p xml:id="p493" begin="20636030000t" end="20656890000t" style="style0"><span style="style1">Untukmu, Tuhan Anubis,</span></p>
    <p xml:id="p494" begin="20656890000t" end="20677740000t" style="style0"><span style="style1">yang berada di atas gunungnya, Gabenor Busur,</span></p>
    <p xml:id="p495" begin="20707770000t" end="20722370000t" style="style0"><span style="style1">Saya hanya mempunyai senyuman saya.</span></p>
    <p xml:id="p496" begin="20733210000t" end="20748230000t" style="style0"><span style="style1">Jadilah ia.</span></p>
    <p xml:id="p497" begin="20782840000t" end="20800370000t" style="style0"><span style="style1">BEK: Zaya!</span></p>
    <p xml:id="p498" begin="20802030000t" end="20821210000t" style="style0"><span style="style1">Ia akan!</span></p>
    <p xml:id="p499" begin="20821210000t" end="20830810000t" style="style0"><span style="style1">Orang mati tidak bercakap dengan orang hidup.</span></p>
    <p xml:id="p500" begin="20957610000t" end="20972620000t" style="style0"><span style="style1">Tetap di jalan.</span></p>
    <p xml:id="p501" begin="21080650000t" end="21093990000t" style="style0"><span style="style1">HORUS: Sekarang berikan mereka kepada saya.</span></p>
    <p xml:id="p502" begin="21109840000t" end="21129450000t" style="style0"><span style="style1">-Anda tidak melakukan apa-apa! -Mata saya.</span></p>
    <p xml:id="p503" begin="21129450000t" end="21151540000t" style="style0"><span style="style1">Habiskan sisa hari anda dengan mengembara tanpa penglihatan.</span></p>
    <p xml:id="p504" begin="21151540000t" end="21163640000t" style="style0"><span style="style1">Saya tidak mempunyai apa-apa untuk kehilangan. Adakah anda faham?</span></p>
    <p xml:id="p505" begin="21163640000t" end="21185330000t" style="style0"><span style="style1">Berikan saya mata saya.</span></p>
    <p xml:id="p506" begin="21185330000t" end="21200350000t" style="style0"><span style="style1">dia lagi atau saya akan mati mencuba. Saya akan melakukan apa sahaja untuk melihat</span></p>
    <p xml:id="p507" begin="21215360000t" end="21232460000t" style="style0"><span style="style1">Awak nak sembunyi dari saya? Belajar kurang bercakap.</span></p>
    <p xml:id="p508" begin="21265830000t" end="21280850000t" style="style0"><span style="style1">(Merengus) Di sini.</span></p>
    <p xml:id="p509" begin="21293770000t" end="21308370000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p510" begin="21377610000t" end="21390540000t" style="style0"><span style="style1">(Mengeluh)</span></p>
    <p xml:id="p511" begin="21390540000t" end="21402210000t" style="style0"><span style="style1">mana yang lain?</span></p>
    <p xml:id="p512" begin="21406390000t" end="21420990000t" style="style0"><span style="style1">(GAGAP)</span></p>
    <p xml:id="p513" begin="21426820000t" end="21442250000t" style="style0"><span style="style1">mana yang lain?</span></p>
    <p xml:id="p514" begin="21442250000t" end="21461850000t" style="style0"><span style="style1">Nah, saya tidak pasti, tetapi saya...</span></p>
    <p xml:id="p515" begin="21461850000t" end="21477710000t" style="style0"><span style="style1">Saya akan memenggal leher awak.</span></p>
    <p xml:id="p516" begin="21477710000t" end="21494390000t" style="style0"><span style="style1">(TERSEKIK)</span></p>
    <p xml:id="p517" begin="21494390000t" end="21516910000t" style="style0"><span style="style1">Awak mesti benci Set atas apa yang dia buat pada ayah awak.</span></p>
    <p xml:id="p518" begin="21555700000t" end="21572380000t" style="style0"><span style="style1">Piramid itu.</span></p>
    <p xml:id="p519" begin="21572380000t" end="21584900000t" style="style0"><span style="style1">Saya tahu cara masuk ke piramid Set.</span></p>
    <p xml:id="p520" begin="21597830000t" end="21611590000t" style="style0"><span style="style1">Bagaimana?</span></p>
    <p xml:id="p521" begin="21622010000t" end="21633280000t" style="style0"><span style="style1">Bagaimana?</span></p>
    <p xml:id="p522" begin="21644960000t" end="21659140000t" style="style0"><span style="style1">Oh...</span></p>
    <p xml:id="p523" begin="21666650000t" end="21683740000t" style="style0"><span style="style1">(Tercungap-cungap)</span></p>
    <p xml:id="p524" begin="21683740000t" end="21704600000t" style="style0"><span style="style1">kuasanya terkunci, bukan? Ia adalah tempat dia menyimpan</span></p>
    <p xml:id="p525" begin="21704600000t" end="21730460000t" style="style0"><span style="style1">Kalau saya boleh bawa awak masuk, boleh awak bunuh dia?</span></p>
    <p xml:id="p526" begin="21734630000t" end="21749230000t" style="style0"><span style="style1">(TANAH BEK)</span></p>
    <p xml:id="p527" begin="21770090000t" end="21782170000t" style="style0"><span style="style1">Bagaimana anda akan melakukannya?</span></p>
    <p xml:id="p528" begin="21787180000t" end="21802610000t" style="style0"><span style="style1">Saya melihat rancangan itu.</span></p>
    <p xml:id="p529" begin="21802610000t" end="21819300000t" style="style0"><span style="style1">Beritahu saya.</span></p>
    <p xml:id="p530" begin="21819300000t" end="21828480000t" style="style0"><span style="style1">-Saya akan tunjukkan kepada anda. -Teruskan.</span></p>
    <p xml:id="p531" begin="21828480000t" end="21842230000t" style="style0"><span style="style1">Kalau awak bawak Zaya balik.</span></p>
    <p xml:id="p532" begin="21879360000t" end="21892280000t" style="style0"><span style="style1">Mungkin ada caranya.</span></p>
    <p xml:id="p533" begin="21916060000t" end="21942330000t" style="style0"><span style="style1">akhirat pernah masuk. HORUS: Tiada siapa boleh pergi</span></p>
    <p xml:id="p534" begin="21942330000t" end="21954430000t" style="style0"><span style="style1">melalui Nine Gates Tetapi perjalanan</span></p>
    <p xml:id="p535" begin="21954430000t" end="21967780000t" style="style0"><span style="style1">akan mengambil masa beberapa hari untuk disiapkan.</span></p>
    <p xml:id="p536" begin="21982370000t" end="22005320000t" style="style0"><span style="style1">boleh buat Anubis berpatah balik. Dan hanya Raja</span></p>
    <p xml:id="p537" begin="22020750000t" end="22052440000t" style="style0"><span style="style1">dan mengambil kembali mahkota Jika saya membunuh Set</span></p>
    <p xml:id="p538" begin="22052440000t" end="22071640000t" style="style0"><span style="style1">sampai ke Gerbang Akhir, di hadapan kekasihmu</span></p>
    <p xml:id="p539" begin="22082470000t" end="22097490000t" style="style0"><span style="style1">Saya mungkin dapat menyelamatkannya.</span></p>
    <p xml:id="p540" begin="22112500000t" end="22127940000t" style="style0"><span style="style1">(GEMPAR)</span></p>
    <p xml:id="p541" begin="22175070000t" end="22189670000t" style="style0"><span style="style1">Cuba untuk teruskan.</span></p>
    <p xml:id="p542" begin="22249310000t" end="22272660000t" style="style0"><span style="style1">SET: Anjing berdarah saya yang hebat.</span></p>
    <p xml:id="p543" begin="22272660000t" end="22293520000t" style="style0"><span style="style1">(ASKAR BERSORAK)</span></p>
    <p xml:id="p544" begin="22293520000t" end="22332720000t" style="style0"><span style="style1">Kamu adalah anak-anak Mesir yang sejati.</span></p>
    <p xml:id="p545" begin="22332720000t" end="22352330000t" style="style0"><span style="style1">Anda adalah anak-anak besi dan darah saya.</span></p>
    <p xml:id="p546" begin="22369850000t" end="22386950000t" style="style0"><span style="style1">Tiada ayah yang lebih berbangga.</span></p>
    <p xml:id="p547" begin="22407390000t" end="22423650000t" style="style0"><span style="style1">telah tercekik lembing kami. Dewa-dewa pemberontak</span></p>
    <p xml:id="p548" begin="22437420000t" end="22462850000t" style="style0"><span style="style1">Selebihnya telah berundur ke kubu Nephthys</span></p>
    <p xml:id="p549" begin="22462850000t" end="22492880000t" style="style0"><span style="style1">di mana mereka kini bersedia untuk menghadapi kita.</span></p>
    <p xml:id="p550" begin="22492880000t" end="22520000000t" style="style0"><span style="style1">Tetapi anda, legion saya di padang pasir,</span></p>
    <p xml:id="p551" begin="22520000000t" end="22541690000t" style="style0"><span style="style1">akan membawa mereka perhitungan!</span></p>
    <p xml:id="p552" begin="22541690000t" end="22553780000t" style="style0"><span style="style1">(BERSORAK)</span></p>
    <p xml:id="p553" begin="22572960000t" end="22589650000t" style="style0"><span style="style1">Jadi penuhi emas anda! (Merengus)</span></p>
    <p xml:id="p554" begin="22621770000t" end="22633860000t" style="style0"><span style="style1">Dan jika kamu gugur dalam peperangan</span></p>
    <p xml:id="p555" begin="22633860000t" end="22653040000t" style="style0"><span style="style1">dan mengembara ke Sembilan Pintu,</span></p>
    <p xml:id="p556" begin="22653040000t" end="22683070000t" style="style0"><span style="style1">siapakah yang kamu sembah! beritahu abang</span></p>
    <p xml:id="p557" begin="22683070000t" end="22707690000t" style="style0"><span style="style1">UMUM: Set Bahagian! Amarn! Ta! Rai!</span></p>
    <p xml:id="p558" begin="22713100000t" end="22727290000t" style="style0"><span style="style1">Jatuh!</span></p>
    <p xml:id="p559" begin="22736050000t" end="22754400000t" style="style0"><span style="style1">Perarakan ke hadapan!</span></p>
    <p xml:id="p560" begin="22857000000t" end="22871600000t" style="style0"><span style="style1">(MNEVIS GROUND)</span></p>
    <p xml:id="p561" begin="22871600000t" end="22883270000t" style="style0"><span style="style1">Tuanku.</span></p>
    <p xml:id="p562" begin="22908300000t" end="22930830000t" style="style0"><span style="style1">Perbendaharaan diraja anda telah dilanggar.</span></p>
    <p xml:id="p563" begin="22951270000t" end="22973780000t" style="style0"><span style="style1">SET: Urshu...</span></p>
    <p xml:id="p564" begin="22973780000t" end="23002980000t" style="style0"><span style="style1">Bukankah mata itu bertujuan untuk memikat mereka yang setia kepada Horus sehingga mati?</span></p>
    <p xml:id="p565" begin="23013400000t" end="23029260000t" style="style0"><span style="style1">(MNEVIS merengus) Ya, Tuhan.</span></p>
    <p xml:id="p566" begin="23029260000t" end="23048030000t" style="style0"><span style="style1">Dan bukankah perangkapmu...</span></p>
    <p xml:id="p567" begin="23060120000t" end="23076800000t" style="style0"><span style="style1">Apakah istilah yang anda gunakan?</span></p>
    <p xml:id="p568" begin="23087230000t" end="23101830000t" style="style0"><span style="style1">Kalis pencuri?</span></p>
    <p xml:id="p569" begin="23108090000t" end="23123100000t" style="style0"><span style="style1">Ya, Tuhan.</span></p>
    <p xml:id="p570" begin="23128520000t" end="23141870000t" style="style0"><span style="style1">Bolehkah anda mengambil jejak?</span></p>
    <p xml:id="p571" begin="23141870000t" end="23155210000t" style="style0"><span style="style1">Saya akan cari dia.</span></p>
    <p xml:id="p572" begin="23155210000t" end="23173980000t" style="style0"><span style="style1">Dan carilah mana-mana sekutunya</span></p>
    <p xml:id="p573" begin="23173980000t" end="23196510000t" style="style0"><span style="style1">untuk mencuri kembali matanya. cukup cerdik</span></p>
    <p xml:id="p574" begin="23228620000t" end="23246970000t" style="style0"><span style="style1">Ia adalah seorang manusia, Tuhan.</span></p>
    <p xml:id="p575" begin="23267410000t" end="23277840000t" style="style0"><span style="style1">Seorang fana?</span></p>
    <p xml:id="p576" begin="23277840000t" end="23292860000t" style="style0"><span style="style1">(TERKECIK gugup)</span></p>
    <p xml:id="p577" begin="23353740000t" end="23366260000t" style="style0"><span style="style1">Siapa dia?</span></p>
    <p xml:id="p578" begin="23366260000t" end="23378360000t" style="style0"><span style="style1">hambaNya.</span></p>
    <p xml:id="p579" begin="23378360000t" end="23398380000t" style="style0"><span style="style1">Dalam pembelaan saya, Tuhan...</span></p>
    <p xml:id="p580" begin="23398380000t" end="23429660000t" style="style0"><span style="style1">Percayalah, saya sangat ingin tahu apa alasan anda.</span></p>
    <p xml:id="p581" begin="23429660000t" end="23440090000t" style="style0"><span style="style1">Tapi bukan sekarang.</span></p>
    <p xml:id="p582" begin="23440090000t" end="23453430000t" style="style0"><span style="style1">Ya, Tuhan.</span></p>
    <p xml:id="p583" begin="23493060000t" end="23509740000t" style="style0"><span style="style1">Nah, nampaknya anda tidak</span></p>
    <p xml:id="p584" begin="23509740000t" end="23526840000t" style="style0"><span style="style1">manusia yang paling cerdik di Mesir.</span></p>
    <p xml:id="p585" begin="23533920000t" end="23547270000t" style="style0"><span style="style1">Pencuri ini adalah.</span></p>
    <p xml:id="p586" begin="23574380000t" end="23594400000t" style="style0"><span style="style1">BEK: Jadi apa rancangan awak?</span></p>
    <p xml:id="p587" begin="23594400000t" end="23612760000t" style="style0"><span style="style1">Tuhan Gurun, HORUS: Untuk membunuh</span></p>
    <p xml:id="p588" begin="23612760000t" end="23626520000t" style="style0"><span style="style1">padang pasir itu sendiri. kita mesti membunuh</span></p>
    <p xml:id="p589" begin="23634020000t" end="23646960000t" style="style0"><span style="style1">Bunuh padang pasir?</span></p>
    <p xml:id="p590" begin="23654460000t" end="23671570000t" style="style0"><span style="style1">Bagaimana anda membunuh padang pasir?</span></p>
    <p xml:id="p591" begin="23734120000t" end="23754140000t" style="style0"><span style="style1">kepada datuk saya. Kita mesti pergi</span></p>
    <p xml:id="p592" begin="23754140000t" end="23767080000t" style="style0"><span style="style1">Dia akan membantu kita dengan tugas kita.</span></p>
    <p xml:id="p593" begin="23767080000t" end="23784170000t" style="style0"><span style="style1">datuk awak?</span></p>
    <p xml:id="p594" begin="23784170000t" end="23798780000t" style="style0"><span style="style1">Dewa Matahari Ra? Anda maksudkan Ra?</span></p>
    <p xml:id="p595" begin="23816710000t" end="23833400000t" style="style0"><span style="style1">adakah datuk anda? Jadi di mana sebenarnya</span></p>
    <p xml:id="p596" begin="23872600000t" end="23892620000t" style="style0"><span style="style1">Awak kelakar kan?</span></p>
    <p xml:id="p597" begin="23892620000t" end="23907220000t" style="style0"><span style="style1">Anda fikir saya akan berusaha untuk menghiburkan anda?</span></p>
    <p xml:id="p598" begin="23918480000t" end="23939330000t" style="style0"><span style="style1">akan berguna sekarang. Nampaknya terbang</span></p>
    <p xml:id="p599" begin="23939330000t" end="23963110000t" style="style0"><span style="style1">Tanpa kedua-dua mata saya, saya tidak boleh berubah.</span></p>
    <p xml:id="p600" begin="23963110000t" end="23975620000t" style="style0"><span style="style1">Saya perlu berdoa untuk kekuatan.</span></p>
    <p xml:id="p601" begin="23983130000t" end="23999390000t" style="style0"><span style="style1">Oh, itu tidak menggalakkan.</span></p>
    <p xml:id="p602" begin="23999390000t" end="24017330000t" style="style0"><span style="style1">dasar gunung ini Senyap atau anda akan sampai</span></p>
    <p xml:id="p603" begin="24017330000t" end="24034010000t" style="style0"><span style="style1">daripada anda mencapai puncak. lebih cepat</span></p>
    <p xml:id="p604" begin="24044430000t" end="24056950000t" style="style0"><span style="style1">(ANGIN MENGERUNG) (TERGAS)</span></p>
    <p xml:id="p605" begin="24220870000t" end="24250060000t" style="style0"><span style="style1">Ra hebat, tahu nama saya.</span></p>
    <p xml:id="p606" begin="24264650000t" end="24278000000t" style="style0"><span style="style1">Lord of the Air mencari pelukan anda.</span></p>
    <p xml:id="p607" begin="24345570000t" end="24371430000t" style="style0"><span style="style1">Saya perlukan bantuan awak. Tolonglah! (BISIK) Datuk,</span></p>
    <p xml:id="p608" begin="24525750000t" end="24539930000t" style="style0"><span style="style1">kagum!</span></p>
    <p xml:id="p609" begin="24544930000t" end="24562040000t" style="style0"><span style="style1">(KETAWA)</span></p>
    <p xml:id="p610" begin="24795180000t" end="24808530000t" style="style0"><span style="style1">(TANAH BEK)</span></p>
    <p xml:id="p611" begin="24873190000t" end="24884860000t" style="style0"><span style="style1">HORUS: Tetap dalam bayang-bayang saya.</span></p>
    <p xml:id="p612" begin="24892370000t" end="24910300000t" style="style0"><span style="style1">-Lakukan sahaja seperti yang saya katakan. -Kenapa?</span></p>
    <p xml:id="p613" begin="24910300000t" end="24922400000t" style="style0"><span style="style1">(KULIT SAKIT) (MENGERUNG)</span></p>
    <p xml:id="p614" begin="24939080000t" end="24954930000t" style="style0"><span style="style1">HORUS: Salam, Tuhan Ra.</span></p>
    <p xml:id="p615" begin="24968280000t" end="24994560000t" style="style0"><span style="style1">Biasanya, apabila seekor burung mendarat di atas bot saya,</span></p>
    <p xml:id="p616" begin="24994560000t" end="25007900000t" style="style0"><span style="style1">Saya membunuhnya sebelum ia boleh najis.</span></p>
    <p xml:id="p617" begin="25029590000t" end="25045850000t" style="style0"><span style="style1">Apakah ini?</span></p>
    <p xml:id="p618" begin="25045850000t" end="25069210000t" style="style0"><span style="style1">kepada sumber Penciptaan? Anda berani membawa seorang fana</span></p>
    <p xml:id="p619" begin="25069210000t" end="25094660000t" style="style0"><span style="style1">Saya tidak dapat meninggalkannya. Dia berharga bagi saya.</span></p>
    <p xml:id="p620" begin="25094660000t" end="25127180000t" style="style0"><span style="style1">Kenapa awak datang? Ah.</span></p>
    <p xml:id="p621" begin="25127180000t" end="25144290000t" style="style0"><span style="style1">Saya hanya akan meminta sesuatu daripada anda.</span></p>
    <p xml:id="p622" begin="25144290000t" end="25161390000t" style="style0"><span style="style1">Oh, dalam kes itu,</span></p>
    <p xml:id="p623" begin="25161390000t" end="25196420000t" style="style0"><span style="style1">Saya akan menghentikan apa yang saya lakukan dan mematuhi arahan anda.</span></p>
    <p xml:id="p624" begin="25196420000t" end="25214360000t" style="style0"><span style="style1">Atuk, saya minta maaf. Maksud saya tiada rasa tidak hormat.</span></p>
    <p xml:id="p625" begin="25214360000t" end="25233960000t" style="style0"><span style="style1">Anda tidak tahu perbezaannya.</span></p>
    <p xml:id="p626" begin="25233960000t" end="25246890000t" style="style0"><span style="style1">(MERANGKANG DALAM JAUH)</span></p>
    <p xml:id="p627" begin="25287760000t" end="25306530000t" style="style0"><span style="style1">Tinggal di sana. Diamlah.</span></p>
    <p xml:id="p628" begin="25325710000t" end="25343240000t" style="style0"><span style="style1">Saya ada kerja nak buat.</span></p>
    <p xml:id="p629" begin="25372020000t" end="25385360000t" style="style0"><span style="style1">(Merengus perlahan)</span></p>
    <p xml:id="p630" begin="25528840000t" end="25546770000t" style="style0"><span style="style1">Dan letakkan manusia di bawah dek jika anda mahu dia hidup.</span></p>
    <p xml:id="p631" begin="25765330000t" end="25777000000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p632" begin="25963020000t" end="25976780000t" style="style0"><span style="style1">(MENGERAM)</span></p>
    <p xml:id="p633" begin="26053110000t" end="26068960000t" style="style0"><span style="style1">(APOPHIS MENGERUNG)</span></p>
    <p xml:id="p634" begin="26090230000t" end="26104000000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p635" begin="26356740000t" end="26388030000t" style="style0"><span style="style1">Merangkak kembali ke bayangan, wahai cacing busuk!</span></p>
    <p xml:id="p636" begin="26403460000t" end="26434330000t" style="style0"><span style="style1">Anda tidak akan pernah menikmati ciptaan saya!</span></p>
    <p xml:id="p637" begin="26452680000t" end="26471450000t" style="style0"><span style="style1">Cuba seboleh mungkin.</span></p>
    <p xml:id="p638" begin="26507730000t" end="26527330000t" style="style0"><span style="style1">Perkara akan berbeza jika saya boleh tinggal</span></p>
    <p xml:id="p639" begin="26527330000t" end="26554870000t" style="style0"><span style="style1">di taman Sungai Nil. antara anak-anak saya</span></p>
    <p xml:id="p640" begin="26554870000t" end="26582810000t" style="style0"><span style="style1">untuk melawan syaitan Apophis Ini adalah beban saya</span></p>
    <p xml:id="p641" begin="26582810000t" end="26597820000t" style="style0"><span style="style1">malam demi malam.</span></p>
    <p xml:id="p642" begin="26597820000t" end="26616590000t" style="style0"><span style="style1">Mesir tidak boleh dimusnahkan oleh Chaos.</span></p>
    <p xml:id="p643" begin="26626190000t" end="26644960000t" style="style0"><span style="style1">Jadi, anda lihat,</span></p>
    <p xml:id="p644" begin="26644960000t" end="26666640000t" style="style0"><span style="style1">ada perkara yang lebih teruk daripada Set.</span></p>
    <p xml:id="p645" begin="26677060000t" end="26691670000t" style="style0"><span style="style1">Awak silap.</span></p>
    <p xml:id="p646" begin="26691670000t" end="26712940000t" style="style0"><span style="style1">Iblis itu bukan yang membunuh ayah saya.</span></p>
    <p xml:id="p647" begin="26712940000t" end="26724200000t" style="style0"><span style="style1">Membunuh anak anda.</span></p>
    <p xml:id="p648" begin="26724200000t" end="26750890000t" style="style0"><span style="style1">Mereka berdua anak lelaki saya.</span></p>
    <p xml:id="p649" begin="26750890000t" end="26767150000t" style="style0"><span style="style1">Mereka berdua sama rata di mata saya.</span></p>
    <p xml:id="p650" begin="26767150000t" end="26785100000t" style="style0"><span style="style1">Seperti semua ciptaan saya.</span></p>
    <p xml:id="p651" begin="26785100000t" end="26809700000t" style="style0"><span style="style1">takdirnya adalah kehendak saya. Dan ketidakpastian</span></p>
    <p xml:id="p652" begin="26820130000t" end="26835560000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p653" begin="26887690000t" end="26917300000t" style="style0"><span style="style1">Jadi apa sebenarnya yang membawa anda ke sini?</span></p>
    <p xml:id="p654" begin="26929400000t" end="26949420000t" style="style0"><span style="style1">Izinkan saya mengisi kelalang saya dengan air ini.</span></p>
    <p xml:id="p655" begin="26993640000t" end="27006970000t" style="style0"><span style="style1">Air itu bukan milik saya.</span></p>
    <p xml:id="p656" begin="27277660000t" end="27295190000t" style="style0"><span style="style1">Anda merancang untuk memadamkan api padang pasir.</span></p>
    <p xml:id="p657" begin="27314790000t" end="27331890000t" style="style0"><span style="style1">Untuk menjadi Raja Untuk membunuh Set.</span></p>
    <p xml:id="p658" begin="27331890000t" end="27348150000t" style="style0"><span style="style1">seperti yang ayah kamu kehendaki.</span></p>
    <p xml:id="p659" begin="27348150000t" end="27364420000t" style="style0"><span style="style1">Berikan saya kuasa untuk terbang semula.</span></p>
    <p xml:id="p660" begin="27364420000t" end="27387770000t" style="style0"><span style="style1">Saya mendengar doa anda kali pertama.</span></p>
    <p xml:id="p661" begin="27387770000t" end="27399870000t" style="style0"><span style="style1">Saya benarkan awak datang ke sini</span></p>
    <p xml:id="p662" begin="27399870000t" end="27412800000t" style="style0"><span style="style1">dan saya memberi anda laluan pulang.</span></p>
    <p xml:id="p663" begin="27412800000t" end="27435750000t" style="style0"><span style="style1">Tetapi selepas itu?</span></p>
    <p xml:id="p664" begin="27435750000t" end="27458260000t" style="style0"><span style="style1">Tanpa kedua-dua mataku,</span></p>
    <p xml:id="p665" begin="27458260000t" end="27476620000t" style="style0"><span style="style1">Saya ragu saya cukup kuat untuk mengalahkan Set.</span></p>
    <p xml:id="p666" begin="27476620000t" end="27488290000t" style="style0"><span style="style1">Jadi menjadi lebih kuat.</span></p>
    <p xml:id="p667" begin="27498300000t" end="27522910000t" style="style0"><span style="style1">jadi malas sekian lama Adakah anda telah</span></p>
    <p xml:id="p668" begin="27522910000t" end="27552110000t" style="style0"><span style="style1">bahawa anda telah lupa setiap kehidupan tuhan adalah perjalanan?</span></p>
    <p xml:id="p669" begin="27552110000t" end="27587970000t" style="style0"><span style="style1">Apabila anda menyimpang dari jalan anda, anda menjadi lemah.</span></p>
    <p xml:id="p670" begin="27587970000t" end="27600070000t" style="style0"><span style="style1">(BERDEBAR) BEK: Hei!</span></p>
    <p xml:id="p671" begin="27610080000t" end="27640110000t" style="style0"><span style="style1">menyelubungi manusia ini? kenapa awak</span></p>
    <p xml:id="p672" begin="27640110000t" end="27657620000t" style="style0"><span style="style1">Dia mempunyai hempedu untuk membuat tawar-menawar dengan saya.</span></p>
    <p xml:id="p673" begin="27663890000t" end="27682660000t" style="style0"><span style="style1">Ah.</span></p>
    <p xml:id="p674" begin="27682660000t" end="27709760000t" style="style0"><span style="style1">Tidak berbaloi dengan papirus yang ditulis, hmm?</span></p>
    <p xml:id="p675" begin="27709760000t" end="27735210000t" style="style0"><span style="style1">(Mengeluh) Apa yang penting? Dia hanyalah seorang fana.</span></p>
    <p xml:id="p676" begin="27834060000t" end="27862420000t" style="style0"><span style="style1">Saya tidak meluluskan cara Tetapkan peraturan.</span></p>
    <p xml:id="p677" begin="27862420000t" end="27885780000t" style="style0"><span style="style1">anda akan menjadi lebih baik. Tetapi saya tidak pasti</span></p>
    <p xml:id="p678" begin="28023000000t" end="28048430000t" style="style0"><span style="style1">yang terakhir dari tuhan pemberontak UMUM: Tuhan,</span></p>
    <p xml:id="p679" begin="28048430000t" end="28061780000t" style="style0"><span style="style1">di sebalik dindingnya. telah berundur</span></p>
    <p xml:id="p680" begin="28073050000t" end="28088050000t" style="style0"><span style="style1">Setiap yang terakhir?</span></p>
    <p xml:id="p681" begin="28090980000t" end="28108910000t" style="style0"><span style="style1">Ya, tuan.</span></p>
    <p xml:id="p682" begin="28108910000t" end="28129770000t" style="style0"><span style="style1">bagus. Kemudian mereka sudah masak untuk dipetik.</span></p>
    <p xml:id="p683" begin="28152290000t" end="28165640000t" style="style0"><span style="style1">agak berlebihan? bukankah ini</span></p>
    <p xml:id="p684" begin="28172730000t" end="28191910000t" style="style0"><span style="style1">Dia mahu mereka bertarung bermati-matian.</span></p>
    <p xml:id="p685" begin="28204430000t" end="28220690000t" style="style0"><span style="style1">Dia isteri awak.</span></p>
    <p xml:id="p686" begin="28220690000t" end="28237380000t" style="style0"><span style="style1">Lebih-lebih lagi alasan untuk membunuhnya.</span></p>
    <p xml:id="p687" begin="28251140000t" end="28267410000t" style="style0"><span style="style1">Mulai sekarang,</span></p>
    <p xml:id="p688" begin="28267410000t" end="28281170000t" style="style0"><span style="style1">cara sesuatu. ini akan menjadi</span></p>
    <p xml:id="p689" begin="28288670000t" end="28308690000t" style="style0"><span style="style1">cara kita.</span></p>
    <p xml:id="p690" begin="28308690000t" end="28323710000t" style="style0"><span style="style1">Lebih baik biasakan diri. (Hembus MELALUI GIGI)</span></p>
    <p xml:id="p691" begin="28367930000t" end="28383360000t" style="style0"><span style="style1">(ASKAR MENJERIT)</span></p>
    <p xml:id="p692" begin="28598980000t" end="28618580000t" style="style0"><span style="style1">(KEDUA-DUA MENDERENG)</span></p>
    <p xml:id="p693" begin="28708270000t" end="28721610000t" style="style0"><span style="style1">(ASKAR-ASKAR MENJERIT)</span></p>
    <p xml:id="p694" begin="28905960000t" end="28937660000t" style="style0"><span style="style1">Adakah betul bahawa seorang dewi harus melakukan kerja sedemikian?</span></p>
    <p xml:id="p695" begin="28946420000t" end="28962270000t" style="style0"><span style="style1">Sejak kamu menjadi Raja,</span></p>
    <p xml:id="p696" begin="28962270000t" end="28989370000t" style="style0"><span style="style1">keperluan untuk kain kafan pengebumian sangat besar.</span></p>
    <p xml:id="p697" begin="29009390000t" end="29031500000t" style="style0"><span style="style1">Anda boleh menjadi seorang ratu.</span></p>
    <p xml:id="p698" begin="29031500000t" end="29049850000t" style="style0"><span style="style1">NEPHTHYS: Anda sepatutnya tahu mengapa saya tidak boleh.</span></p>
    <p xml:id="p699" begin="29061110000t" end="29074460000t" style="style0"><span style="style1">SET: Kemudian, apabila saya meminta awak untuk berkahwin dengan saya,</span></p>
    <p xml:id="p700" begin="29094070000t" end="29109910000t" style="style0"><span style="style1">kenapa awak kata ya?</span></p>
    <p xml:id="p701" begin="29109910000t" end="29130350000t" style="style0"><span style="style1">menunggang keluar dari padang pasir. Saya ingat bila awak</span></p>
    <p xml:id="p702" begin="29143280000t" end="29190410000t" style="style0"><span style="style1">terburu-buru. Bergaduh. sangat kacak.</span></p>
    <p xml:id="p703" begin="29190410000t" end="29215020000t" style="style0"><span style="style1">Saya mengharungi angin yang menyengat itu hanya untuk berada di sisi awak.</span></p>
    <p xml:id="p704" begin="29227950000t" end="29241290000t" style="style0"><span style="style1">perbuatan besar Dan dibayangkan</span></p>
    <p xml:id="p705" begin="29241290000t" end="29255060000t" style="style0"><span style="style1">capai bersama. kami akan</span></p>
    <p xml:id="p706" begin="29258820000t" end="29272990000t" style="style0"><span style="style1">Ia tidak semua menyengat.</span></p>
    <p xml:id="p707" begin="29289670000t" end="29304690000t" style="style0"><span style="style1">Beberapa bahagian adalah manis.</span></p>
    <p xml:id="p708" begin="29317630000t" end="29337650000t" style="style0"><span style="style1">NEPHTHYS: Mungkin.</span></p>
    <p xml:id="p709" begin="29337650000t" end="29358500000t" style="style0"><span style="style1">Saya masih fikir kita boleh gembira.</span></p>
    <p xml:id="p710" begin="29369750000t" end="29389770000t" style="style0"><span style="style1">Saya sepatutnya sudah cukup untuk memenuhi anda.</span></p>
    <p xml:id="p711" begin="29389770000t" end="29402290000t" style="style0"><span style="style1">(ELUPAS)</span></p>
    <p xml:id="p712" begin="29425650000t" end="29444000000t" style="style0"><span style="style1">Tiada apa yang dapat memenuhi saya.</span></p>
    <p xml:id="p713" begin="29479860000t" end="29499880000t" style="style0"><span style="style1">Sebab itu Ra bijak</span></p>
    <p xml:id="p714" begin="29499880000t" end="29520740000t" style="style0"><span style="style1">untuk memastikan anda tidak akan mempunyai anak.</span></p>
    <p xml:id="p715" begin="29564540000t" end="29576630000t" style="style0"><span style="style1">(NEPHTHYS MENGERUNG)</span></p>
    <p xml:id="p716" begin="29625010000t" end="29639200000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p717" begin="29668810000t" end="29680900000t" style="style0"><span style="style1">(MERENGEK)</span></p>
    <p xml:id="p718" begin="29730110000t" end="29752640000t" style="style0"><span style="style1">kenapa?</span></p>
    <p xml:id="p719" begin="29752640000t" end="29779740000t" style="style0"><span style="style1">sehingga terlambat. Tiada siapa yang akan tahu,</span></p>
    <p xml:id="p720" begin="29786010000t" end="29797270000t" style="style0"><span style="style1">(NEPHTHYS MENJERIT)</span></p>
    <p xml:id="p721" begin="29925310000t" end="29939900000t" style="style0"><span style="style1">(BEK MENJERIT)</span></p>
    <p xml:id="p722" begin="29955340000t" end="29970350000t" style="style0"><span style="style1">(HORUS MENGANDUNG)</span></p>
    <p xml:id="p723" begin="29970350000t" end="29982870000t" style="style0"><span style="style1">(KEDUA-DUA MENGERENG)</span></p>
    <p xml:id="p724" begin="30010390000t" end="30027500000t" style="style0"><span style="style1">(MELUDAH)</span></p>
    <p xml:id="p725" begin="30027500000t" end="30042510000t" style="style0"><span style="style1">Mungkin lain kali, terus terbang</span></p>
    <p xml:id="p726" begin="30042510000t" end="30057530000t" style="style0"><span style="style1">sehingga kita benar-benar berada di atas tanah.</span></p>
    <p xml:id="p727" begin="30057530000t" end="30083390000t" style="style0"><span style="style1">Apa yang Ra beri, dia ambil balik.</span></p>
    <p xml:id="p728" begin="30083390000t" end="30102990000t" style="style0"><span style="style1">(KEDUA-DUA MENGERUNG)</span></p>
    <p xml:id="p729" begin="30102990000t" end="30115500000t" style="style0"><span style="style1">Saya fikir dia membantu awak.</span></p>
    <p xml:id="p730" begin="30115500000t" end="30128020000t" style="style0"><span style="style1">Saya mendapat apa yang saya perlukan.</span></p>
    <p xml:id="p731" begin="30141360000t" end="30173480000t" style="style0"><span style="style1">tidak dapat memadamkan api Set. Seluruh Sungai Nil</span></p>
    <p xml:id="p732" begin="30173480000t" end="30195580000t" style="style0"><span style="style1">air Penciptaan boleh. Tetapi beberapa titis dari</span></p>
    <p xml:id="p733" begin="30202670000t" end="30221020000t" style="style0"><span style="style1">Bunuh padang pasir.</span></p>
    <p xml:id="p734" begin="30221020000t" end="30245220000t" style="style0"><span style="style1">Set akan menjadi lemah. Dengan apinya hilang,</span></p>
    <p xml:id="p735" begin="30245220000t" end="30260640000t" style="style0"><span style="style1">Terdedah.</span></p>
    <p xml:id="p736" begin="30260640000t" end="30270650000t" style="style0"><span style="style1">Apa yang akan berlaku jika saya minum itu?</span></p>
    <p xml:id="p737" begin="30281500000t" end="30323210000t" style="style0"><span style="style1">Anda akan segar semula. Kemudian anda akan mati.</span></p>
    <p xml:id="p738" begin="30323210000t" end="30352820000t" style="style0"><span style="style1">Penciptaan akan membunuh. Nampak tak betul air tu</span></p>
    <p xml:id="p739" begin="30352820000t" end="30374090000t" style="style0"><span style="style1">Kerana membazir air saya. Saya akan bunuh awak.</span></p>
    <p xml:id="p740" begin="30399540000t" end="30419140000t" style="style0"><span style="style1">Apa ini?</span></p>
    <p xml:id="p741" begin="30419140000t" end="30437490000t" style="style0"><span style="style1">Jadi anda tidak mempunyai sesuatu untuk diminum untuk membawa saya</span></p>
    <p xml:id="p742" begin="30437490000t" end="30448340000t" style="style0"><span style="style1">berbekam di tangan anda.</span></p>
    <p xml:id="p743" begin="30455010000t" end="30474610000t" style="style0"><span style="style1">Saya bukan hamba awak.</span></p>
    <p xml:id="p744" begin="30474610000t" end="30490870000t" style="style0"><span style="style1">Ayah saya mengajar saya</span></p>
    <p xml:id="p745" begin="30490870000t" end="30509230000t" style="style0"><span style="style1">tidak layak bagi tuhan untuk memukul lelaki.</span></p>
    <p xml:id="p746" begin="30509230000t" end="30525910000t" style="style0"><span style="style1">Dia sepatutnya mengajar anda untuk melepaskan diri anda</span></p>
    <p xml:id="p747" begin="30525910000t" end="30538010000t" style="style0"><span style="style1">dan dapatkan air sendiri.</span></p>
    <p xml:id="p748" begin="30561780000t" end="30575960000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p749" begin="30588900000t" end="30600980000t" style="style0"><span style="style1">Maaf, Ayah.</span></p>
    <p xml:id="p750" begin="30751130000t" end="30765740000t" style="style0"><span style="style1">(MENGERAM)</span></p>
    <p xml:id="p751" begin="30765740000t" end="30778670000t" style="style0"><span style="style1">(BEK MENJERONG)</span></p>
    <p xml:id="p752" begin="30784920000t" end="30800760000t" style="style0"><span style="style1">Ini menjadi tidak boleh diterima.</span></p>
    <p xml:id="p753" begin="30867920000t" end="30880840000t" style="style0"><span style="style1">Di manakah terletaknya Eye of Horus?</span></p>
    <p xml:id="p754" begin="30884190000t" end="30901280000t" style="style0"><span style="style1">Di belakang anda,</span></p>
    <p xml:id="p755" begin="30901280000t" end="30911290000t" style="style0"><span style="style1">bersama kambing yang anda simpan di sana.</span></p>
    <p xml:id="p756" begin="30927150000t" end="30950910000t" style="style0"><span style="style1">Di manakah terletaknya Eye of Horus?</span></p>
    <p xml:id="p757" begin="30961340000t" end="30973860000t" style="style0"><span style="style1">Di sini.</span></p>
    <p xml:id="p758" begin="30973860000t" end="30991370000t" style="style0"><span style="style1">(SCOFFS)</span></p>
    <p xml:id="p759" begin="30991370000t" end="31007230000t" style="style0"><span style="style1">MNEVIS: Saya fikir awak sedang merangkak</span></p>
    <p xml:id="p760" begin="31007230000t" end="31020980000t" style="style0"><span style="style1">tidak kelihatan dalam lumpur di suatu tempat.</span></p>
    <p xml:id="p761" begin="31031410000t" end="31044760000t" style="style0"><span style="style1">Potong dia!</span></p>
    <p xml:id="p762" begin="31051430000t" end="31063950000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p763" begin="31099820000t" end="31112750000t" style="style0"><span style="style1">(MENJERENG) (MENGERUNG)</span></p>
    <p xml:id="p764" begin="31159880000t" end="31171550000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p765" begin="31171550000t" end="31186160000t" style="style0"><span style="style1">MNEVIS: Lihat, saudara-saudara?</span></p>
    <p xml:id="p766" begin="31186160000t" end="31206590000t" style="style0"><span style="style1">Tanpa mata sebelahnya, dia lemah.</span></p>
    <p xml:id="p767" begin="31206590000t" end="31221180000t" style="style0"><span style="style1">(MENGERAM) (MERENGUS)</span></p>
    <p xml:id="p768" begin="31297940000t" end="31310450000t" style="style0"><span style="style1">(MENGERUNG) (MERENGANG)</span></p>
    <p xml:id="p769" begin="31557780000t" end="31571530000t" style="style0"><span style="style1">(JERENG)</span></p>
    <p xml:id="p770" begin="31662040000t" end="31674560000t" style="style0"><span style="style1">(BEK MENJERIT)</span></p>
    <p xml:id="p771" begin="31702080000t" end="31721680000t" style="style0"><span style="style1">Walaupun saya buta, pekak,</span></p>
    <p xml:id="p772" begin="31736290000t" end="31751310000t" style="style0"><span style="style1">kehilangan anggota badan...</span></p>
    <p xml:id="p773" begin="31776750000t" end="31791350000t" style="style0"><span style="style1">tiada jodoh bagi saya. awak masih</span></p>
    <p xml:id="p774" begin="31855990000t" end="31879350000t" style="style0"><span style="style1">Saya tidak jatuh mati. Anda akan gembira mengetahui</span></p>
    <p xml:id="p775" begin="31879350000t" end="31892270000t" style="style0"><span style="style1">Puji Ra.</span></p>
    <p xml:id="p776" begin="31892270000t" end="31907290000t" style="style0"><span style="style1">Perjanjian itu tidak dikira jika saya mati.</span></p>
    <p xml:id="p777" begin="31907290000t" end="31920230000t" style="style0"><span style="style1">adalah untuk Zaya dan saya berdua</span></p>
    <p xml:id="p778" begin="31920230000t" end="31934400000t" style="style0"><span style="style1">untuk berada di sini, bersama-sama.</span></p>
    <p xml:id="p779" begin="31934400000t" end="31951510000t" style="style0"><span style="style1">Bernafas!</span></p>
    <p xml:id="p780" begin="31954840000t" end="31969440000t" style="style0"><span style="style1">Di belakang awak!</span></p>
    <p xml:id="p781" begin="32061200000t" end="32075380000t" style="style0"><span style="style1">BEK: Horus!</span></p>
    <p xml:id="p782" begin="32075380000t" end="32089560000t" style="style0"><span style="style1">Horus!</span></p>
    <p xml:id="p783" begin="32119170000t" end="32134600000t" style="style0"><span style="style1">(BEK MENYERU)</span></p>
    <p xml:id="p784" begin="32154620000t" end="32181740000t" style="style0"><span style="style1">Oh, Ra, sayang Ra, tolong, tolong kami!</span></p>
    <p xml:id="p785" begin="32181740000t" end="32193410000t" style="style0"><span style="style1">(MENJERIT)</span></p>
    <p xml:id="p786" begin="32198840000t" end="32212170000t" style="style0"><span style="style1">Horus!</span></p>
    <p xml:id="p787" begin="32224270000t" end="32239710000t" style="style0"><span style="style1">Kita akan mati!</span></p>
    <p xml:id="p788" begin="32315620000t" end="32329800000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p789" begin="32369420000t" end="32385270000t" style="style0"><span style="style1">(BERNAFAS BERAT)</span></p>
    <p xml:id="p790" begin="32407380000t" end="32419470000t" style="style0"><span style="style1">HORUS: Selepas awak.</span></p>
    <p xml:id="p791" begin="32439080000t" end="32452410000t" style="style0"><span style="style1">(KEDUA-DUA MENGERENG)</span></p>
    <p xml:id="p792" begin="32493290000t" end="32510400000t" style="style0"><span style="style1">(SELUAR)</span></p>
    <p xml:id="p793" begin="32532910000t" end="32542920000t" style="style0"><span style="style1">anda boleh melakukan ini? Adakah anda pasti</span></p>
    <p xml:id="p794" begin="32542920000t" end="32563360000t" style="style0"><span style="style1">Saya telah menyelamatkan awak, bukan?</span></p>
    <p xml:id="p795" begin="32563360000t" end="32588810000t" style="style0"><span style="style1">awak berguna untuk saya. -Oh, awak selamatkan saya? -Hanya kerana</span></p>
    <p xml:id="p796" begin="32588810000t" end="32602980000t" style="style0"><span style="style1">apa yang berguna? BEK: Awak tahu</span></p>
    <p xml:id="p797" begin="32602980000t" end="32623000000t" style="style0"><span style="style1">Mata awak yang lain.</span></p>
    <p xml:id="p798" begin="32623000000t" end="32634680000t" style="style0"><span style="style1">Saya boleh curi balik untuk awak, kalau awak suka.</span></p>
    <p xml:id="p799" begin="32634680000t" end="32652210000t" style="style0"><span style="style1">kesabaran saya, fana. Jangan uji</span></p>
    <p xml:id="p800" begin="32652210000t" end="32665130000t" style="style0"><span style="style1">Nama saya bukan &quot;fana.&quot;</span></p>
    <p xml:id="p801" begin="32691830000t" end="32703920000t" style="style0"><span style="style1">Apa itu, kemudian?</span></p>
    <p xml:id="p802" begin="32709760000t" end="32722680000t" style="style0"><span style="style1">Pemain pertahanan.</span></p>
    <p xml:id="p803" begin="32726860000t" end="32747300000t" style="style0"><span style="style1">Baiklah, Bek.</span></p>
    <p xml:id="p804" begin="32747300000t" end="32763980000t" style="style0"><span style="style1">Jalan raya akan diperhatikan sekarang.</span></p>
    <p xml:id="p805" begin="32763980000t" end="32780250000t" style="style0"><span style="style1">pemburu yang lebih baik. Set akan menghantar</span></p>
    <p xml:id="p806" begin="32903280000t" end="32929980000t" style="style0"><span style="style1">Nah, itu tidak mengikut rancangan, bukan?</span></p>
    <p xml:id="p807" begin="32929980000t" end="32953330000t" style="style0"><span style="style1">MNEVIS: Tidak, Tuhan.</span></p>
    <p xml:id="p808" begin="32953330000t" end="32982540000t" style="style0"><span style="style1">Anak saudara saya melakukan semua ini dengan sebelah mata?</span></p>
    <p xml:id="p809" begin="32982540000t" end="33003380000t" style="style0"><span style="style1">Saya memandang rendah kekuatannya.</span></p>
    <p xml:id="p810" begin="33003380000t" end="33015900000t" style="style0"><span style="style1">Sukar untuk membunuh, budak itu.</span></p>
    <p xml:id="p811" begin="33030080000t" end="33043420000t" style="style0"><span style="style1">Macam pakcik dia.</span></p>
    <p xml:id="p812" begin="33053430000t" end="33079300000t" style="style0"><span style="style1">Dia bersekutu dengan siapa? Ke mana dia pergi?</span></p>
    <p xml:id="p813" begin="33079300000t" end="33103480000t" style="style0"><span style="style1">Satu-satunya sekutunya adalah fana.</span></p>
    <p xml:id="p814" begin="33103480000t" end="33119760000t" style="style0"><span style="style1">tentera, adakah ia? Ia hampir tidak</span></p>
    <p xml:id="p815" begin="33119760000t" end="33131440000t" style="style0"><span style="style1">Saya mendengar mereka.</span></p>
    <p xml:id="p816" begin="33131440000t" end="33143520000t" style="style0"><span style="style1">Manusia itu bercakap tentang tawar-menawar</span></p>
    <p xml:id="p817" begin="33143520000t" end="33156870000t" style="style0"><span style="style1">dia buat dengan Horus.</span></p>
    <p xml:id="p818" begin="33162720000t" end="33186070000t" style="style0"><span style="style1">manusia yang bercita-cita tinggi. Ini adalah satu</span></p>
    <p xml:id="p819" begin="33186070000t" end="33205670000t" style="style0"><span style="style1">Horus telah bersetuju</span></p>
    <p xml:id="p820" begin="33205670000t" end="33222780000t" style="style0"><span style="style1">untuk membawa wanita fana itu kembali dari kematian.</span></p>
    <p xml:id="p821" begin="33236540000t" end="33251970000t" style="style0"><span style="style1">Adakah anda pasti?</span></p>
    <p xml:id="p822" begin="33251970000t" end="33270740000t" style="style0"><span style="style1">Saya yakin itu, Tuhan.</span></p>
    <p xml:id="p823" begin="33270740000t" end="33283240000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p824" begin="33313690000t" end="33332890000t" style="style0"><span style="style1">dapatkan yang dilayani. Anda sepatutnya</span></p>
    <p xml:id="p825" begin="33332890000t" end="33356660000t" style="style0"><span style="style1">-Ya, Tuhan. terima kasih. -Kerja yang bagus.</span></p>
    <p xml:id="p826" begin="33377930000t" end="33391280000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p827" begin="33426310000t" end="33453830000t" style="style0"><span style="style1">Anda sepatutnya mempercayai kami dengan perkara ini dari awal.</span></p>
    <p xml:id="p828" begin="33453830000t" end="33468850000t" style="style0"><span style="style1">meninggalkan anda berpuas hati? Bukankah kita selalu</span></p>
    <p xml:id="p829" begin="33499720000t" end="33518900000t" style="style0"><span style="style1">Lepas tu puaskan aku lagi.</span></p>
    <p xml:id="p830" begin="33582300000t" end="33594810000t" style="style0"><span style="style1">Adakah anda membiarkan isteri anda hidup?</span></p>
    <p xml:id="p831" begin="33634010000t" end="33660710000t" style="style0"><span style="style1">anda dan saya akan berakhir lambat laun,</span></p>
    <p xml:id="p832" begin="33660710000t" end="33673630000t" style="style0"><span style="style1">sama sahaja.</span></p>
    <p xml:id="p833" begin="33794170000t" end="33816280000t" style="style0"><span style="style1">Tanah Orang Mati dan Sembilan Pintunya.</span></p>
    <p xml:id="p834" begin="33828380000t" end="33858830000t" style="style0"><span style="style1">Puan Barat? Adakah ia tepat,</span></p>
    <p xml:id="p835" begin="33858830000t" end="33874250000t" style="style0"><span style="style1">Jangan panggil saya begitu.</span></p>
    <p xml:id="p836" begin="33874250000t" end="33894270000t" style="style0"><span style="style1">Saya tinggalkan semua itu.</span></p>
    <p xml:id="p837" begin="33894270000t" end="33918470000t" style="style0"><span style="style1">Tidak lama lagi, saya akan memerintah seluruh dunia.</span></p>
    <p xml:id="p838" begin="33918470000t" end="33944320000t" style="style0"><span style="style1">Tanah Orang Mati adalah kerajaan terakhir</span></p>
    <p xml:id="p839" begin="33944320000t" end="33958930000t" style="style0"><span style="style1">dibiarkan berdiri.</span></p>
    <p xml:id="p840" begin="33958930000t" end="33973930000t" style="style0"><span style="style1">Anda mahukan perkara yang anda tidak boleh miliki.</span></p>
    <p xml:id="p841" begin="33998550000t" end="34012320000t" style="style0"><span style="style1">untuk membawa saya ke sana. saya nak awak</span></p>
    <p xml:id="p842" begin="34012320000t" end="34027330000t" style="style0"><span style="style1">Tetapi anda adalah jiwa yang hidup.</span></p>
    <p xml:id="p843" begin="34027330000t" end="34046510000t" style="style0"><span style="style1">jiwa yang hidup, juga, Ya. Dan anda pernah</span></p>
    <p xml:id="p844" begin="34046510000t" end="34065280000t" style="style0"><span style="style1">semasa anda menjadi penasihat kepada orang mati.</span></p>
    <p xml:id="p845" begin="34065280000t" end="34081970000t" style="style0"><span style="style1">Anda tahu apa yang menunggu saya jika saya kembali.</span></p>
    <p xml:id="p846" begin="34091140000t" end="34105320000t" style="style0"><span style="style1">Anda mempunyai gelang kecil anda</span></p>
    <p xml:id="p847" begin="34105320000t" end="34128260000t" style="style0"><span style="style1">daripada syaitan itu. untuk melindungi anda</span></p>
    <p xml:id="p848" begin="34128260000t" end="34141190000t" style="style0"><span style="style1">Bukan itu sahaja.</span></p>
    <p xml:id="p849" begin="34148280000t" end="34174130000t" style="style0"><span style="style1">(BERBISIK) Awak rindu. bukan awak?</span></p>
    <p xml:id="p850" begin="34186230000t" end="34212100000t" style="style0"><span style="style1">Apa yang dibawa keluar dalam diri anda. Kegelapan.</span></p>
    <p xml:id="p851" begin="34217100000t" end="34234610000t" style="style0"><span style="style1">(BISIK) Tidak.</span></p>
    <p xml:id="p852" begin="34234610000t" end="34264220000t" style="style0"><span style="style1">Ah, awak tidak begitu baik, Dewi Cinta.</span></p>
    <p xml:id="p853" begin="34276740000t" end="34289260000t" style="style0"><span style="style1">saya tahu.</span></p>
    <p xml:id="p854" begin="34289260000t" end="34307610000t" style="style0"><span style="style1">Kemudian lakukan ini.</span></p>
    <p xml:id="p855" begin="34307610000t" end="34344300000t" style="style0"><span style="style1">Kemudian kita boleh memiliki segala-galanya. Buktikan kesetiaan awak kepada saya.</span></p>
    <p xml:id="p856" begin="34356400000t" end="34373930000t" style="style0"><span style="style1">bersama-sama.</span></p>
    <p xml:id="p857" begin="34451090000t" end="34463180000t" style="style0"><span style="style1">(LEMBUT) Horus...</span></p>
    <p xml:id="p858" begin="34476520000t" end="34493630000t" style="style0"><span style="style1">sayang saya.</span></p>
    <p xml:id="p859" begin="34552860000t" end="34564940000t" style="style0"><span style="style1">HATHOR: Horus...</span></p>
    <p xml:id="p860" begin="34626670000t" end="34644610000t" style="style0"><span style="style1">di kubur ayah kamu? awak bukan</span></p>
    <p xml:id="p861" begin="34681730000t" end="34694660000t" style="style0"><span style="style1">Saya tertanya-tanya di mana dia berada. (TERGAS)</span></p>
    <p xml:id="p862" begin="34711760000t" end="34724690000t" style="style0"><span style="style1">Sekarang saya tahu.</span></p>
    <p xml:id="p863" begin="34730950000t" end="34744300000t" style="style0"><span style="style1">Terima kasih.</span></p>
    <p xml:id="p864" begin="34765140000t" end="34789340000t" style="style0"><span style="style1">Bagi seseorang yang melenturkan kehendak lelaki</span></p>
    <p xml:id="p865" begin="34789340000t" end="34804360000t" style="style0"><span style="style1">dengan memukul sebatannya,</span></p>
    <p xml:id="p866" begin="34811860000t" end="34824380000t" style="style0"><span style="style1">awak bukan pandai sangat.</span></p>
    <p xml:id="p867" begin="34844400000t" end="34857320000t" style="style0"><span style="style1">Berapa lama dia mempunyai penglihatannya?</span></p>
    <p xml:id="p868" begin="34857320000t" end="34869420000t" style="style0"><span style="style1">Kenapa awak peduli?</span></p>
    <p xml:id="p869" begin="34869420000t" end="34883600000t" style="style0"><span style="style1">(SCOFFS)</span></p>
    <p xml:id="p870" begin="34897780000t" end="34914880000t" style="style0"><span style="style1">Saya milik awak sekarang.</span></p>
    <p xml:id="p871" begin="34919890000t" end="34934900000t" style="style0"><span style="style1">Saya akan lakukan seperti yang anda minta.</span></p>
    <p xml:id="p872" begin="34945320000t" end="34959510000t" style="style0"><span style="style1">Walaupun saya membunuh Horus?</span></p>
    <p xml:id="p873" begin="34975350000t" end="34987870000t" style="style0"><span style="style1">(BERBISIK) Sudah tentu.</span></p>
    <p xml:id="p874" begin="34995370000t" end="35012900000t" style="style0"><span style="style1">Siapa yang mengambil berat tentang dia?</span></p>
    <p xml:id="p875" begin="35043760000t" end="35055430000t" style="style0"><span style="style1">anda akan keletihan saya fikir</span></p>
    <p xml:id="p876" begin="35055430000t" end="35068370000t" style="style0"><span style="style1">dari banyak pembohongan.</span></p>
    <p xml:id="p877" begin="35169720000t" end="35204760000t" style="style0"><span style="style1">Saya suka Nephthys sekali dan saya mengambil sayapnya.</span></p>
    <p xml:id="p878" begin="35215590000t" end="35228940000t" style="style0"><span style="style1">Bayangkan apa yang saya akan lakukan kepada anda.</span></p>
    <p xml:id="p879" begin="35256050000t" end="35273160000t" style="style0"><span style="style1">Lakukan itu dan saya akan memburu awak.</span></p>
    <p xml:id="p880" begin="35292340000t" end="35304860000t" style="style0"><span style="style1">(SET GRUNTS)</span></p>
    <p xml:id="p881" begin="35304860000t" end="35316950000t" style="style0"><span style="style1">(MENJERIT)</span></p>
    <p xml:id="p882" begin="35360330000t" end="35374090000t" style="style0"><span style="style1">(HATHOR merengus)</span></p>
    <p xml:id="p883" begin="35374090000t" end="35385350000t" style="style0"><span style="style1">SYAITAN PEREMPUAN: Biar saya sentuh.</span></p>
    <p xml:id="p884" begin="35395770000t" end="35414550000t" style="style0"><span style="style1">(SYITAN KETAWA) (HATHOR MENGERUNG)</span></p>
    <p xml:id="p885" begin="35497960000t" end="35514650000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p886" begin="35514650000t" end="35528830000t" style="style0"><span style="style1">(BERNAFAS BERAT)</span></p>
    <p xml:id="p887" begin="35528830000t" end="35545920000t" style="style0"><span style="style1">Saya rasa ia lebih baik daripada berlari.</span></p>
    <p xml:id="p888" begin="35553020000t" end="35572620000t" style="style0"><span style="style1">(TERHANGAT)</span></p>
    <p xml:id="p889" begin="35646020000t" end="35665630000t" style="style0"><span style="style1">(MERENGANG LEMBUT)</span></p>
    <p xml:id="p890" begin="35734870000t" end="35747380000t" style="style0"><span style="style1">(BEK merengus perlahan)</span></p>
    <p xml:id="p891" begin="35870840000t" end="35895450000t" style="style0"><span style="style1">tapak perkhemahan lain kali? yang kurang menyenangkan Bolehkah kita dapati</span></p>
    <p xml:id="p892" begin="35906700000t" end="35923810000t" style="style0"><span style="style1">Hmm.</span></p>
    <p xml:id="p893" begin="35937980000t" end="35959260000t" style="style0"><span style="style1">Ini pernah menjadi taman seperti yang anda tidak pernah lihat.</span></p>
    <p xml:id="p894" begin="36134850000t" end="36146110000t" style="style0"><span style="style1">Apa yang berlaku?</span></p>
    <p xml:id="p895" begin="36156530000t" end="36183650000t" style="style0"><span style="style1">Ia adalah kuil pertama ayah saya.</span></p>
    <p xml:id="p896" begin="36183650000t" end="36201170000t" style="style0"><span style="style1">Dia membuka alasan Dalam kemurahan hatinya,</span></p>
    <p xml:id="p897" begin="36201170000t" end="36216180000t" style="style0"><span style="style1">supaya orang miskin boleh menanam sendiri di sini.</span></p>
    <p xml:id="p898" begin="36236610000t" end="36253300000t" style="style0"><span style="style1">Set telah merosakkan ajarannya.</span></p>
    <p xml:id="p899" begin="36285840000t" end="36301270000t" style="style0"><span style="style1">suka tempat ini. ayah saya</span></p>
    <p xml:id="p900" begin="36317530000t" end="36337550000t" style="style0"><span style="style1">Jadi Set membawanya ke sini untuk disembelih.</span></p>
    <p xml:id="p901" begin="36366740000t" end="36393860000t" style="style0"><span style="style1">Tubuhnya dipotong menjadi 14 bahagian.</span></p>
    <p xml:id="p902" begin="36393860000t" end="36408450000t" style="style0"><span style="style1">Hati tidak pernah ditemui.</span></p>
    <p xml:id="p903" begin="36408450000t" end="36425560000t" style="style0"><span style="style1">Set masin bumi?</span></p>
    <p xml:id="p904" begin="36425560000t" end="36451000000t" style="style0"><span style="style1">air mata ibu saya. Tidak</span></p>
    <p xml:id="p905" begin="36465180000t" end="36480190000t" style="style0"><span style="style1">Sebelum dia mengambil nyawanya sendiri.</span></p>
    <p xml:id="p906" begin="36506060000t" end="36518150000t" style="style0"><span style="style1">Saya gagalkan mereka.</span></p>
    <p xml:id="p907" begin="36537330000t" end="36553600000t" style="style0"><span style="style1">saya minta maaf.</span></p>
    <p xml:id="p908" begin="36553600000t" end="36577790000t" style="style0"><span style="style1">Saya sedang dalam perjalanan. Ra memberitahu saya</span></p>
    <p xml:id="p909" begin="36596150000t" end="36632010000t" style="style0"><span style="style1">Dan jika saya sampai ke penghujungnya, saya akan menjadi perkasa lagi.</span></p>
    <p xml:id="p910" begin="36647020000t" end="36661630000t" style="style0"><span style="style1">Bagaimana ia berakhir?</span></p>
    <p xml:id="p911" begin="36661630000t" end="36676230000t" style="style0"><span style="style1">Dengan dendam.</span></p>
    <p xml:id="p912" begin="36697910000t" end="36716680000t" style="style0"><span style="style1">melalui tengkorak Set. Berakhir dengan lembing saya</span></p>
    <p xml:id="p913" begin="36733780000t" end="36750880000t" style="style0"><span style="style1">(GEMPAR DALAM JAUH)</span></p>
    <p xml:id="p914" begin="36750880000t" end="36765480000t" style="style0"><span style="style1">Adakah itu ribut?</span></p>
    <p xml:id="p915" begin="36776330000t" end="36789250000t" style="style0"><span style="style1">Tiada awan.</span></p>
    <p xml:id="p916" begin="36798840000t" end="36826380000t" style="style0"><span style="style1">(MENGERAM)</span></p>
    <p xml:id="p917" begin="36826380000t" end="36840550000t" style="style0"><span style="style1">menunggang haiwan peliharaan mereka. Pemburu set</span></p>
    <p xml:id="p918" begin="36857230000t" end="36887260000t" style="style0"><span style="style1">Itu bukan haiwan peliharaan. Kucing adalah haiwan peliharaan.</span></p>
    <p xml:id="p919" begin="36887260000t" end="36907700000t" style="style0"><span style="style1">Saya tidak boleh menahan Tidak seperti saya sekarang. racun mereka.</span></p>
    <p xml:id="p920" begin="36907700000t" end="36927300000t" style="style0"><span style="style1">kita patut lari. Kemudian saya rasa</span></p>
    <p xml:id="p921" begin="36927300000t" end="36946910000t" style="style0"><span style="style1">Manusia melakukannya sepanjang masa! lari?</span></p>
    <p xml:id="p922" begin="37011560000t" end="37026160000t" style="style0"><span style="style1">(TOOTING)</span></p>
    <p xml:id="p923" begin="37111240000t" end="37125430000t" style="style0"><span style="style1">Lari lebih cepat!</span></p>
    <p xml:id="p924" begin="37125430000t" end="37137100000t" style="style0"><span style="style1">Saya tidak boleh!</span></p>
    <p xml:id="p925" begin="37145860000t" end="37157120000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p926" begin="37162130000t" end="37181730000t" style="style0"><span style="style1">(MERENGANG)</span></p>
    <p xml:id="p927" begin="37181730000t" end="37193410000t" style="style0"><span style="style1">Lari lebih cepat!</span></p>
    <p xml:id="p928" begin="37193410000t" end="37207170000t" style="style0"><span style="style1">Saya tidak boleh!</span></p>
    <p xml:id="p929" begin="37326460000t" end="37338550000t" style="style0"><span style="style1">HORUS: Ayuh!</span></p>
    <p xml:id="p930" begin="37346480000t" end="37358570000t" style="style0"><span style="style1">(KEDUA-DUA MENGERENG)</span></p>
    <p xml:id="p931" begin="37452830000t" end="37472850000t" style="style0"><span style="style1">untuk membunuh mereka. -Kami ada -&quot;Kami&quot;?</span></p>
    <p xml:id="p932" begin="37472850000t" end="37493710000t" style="style0"><span style="style1">apa yang paling penting? Apabila anda pergi memancing,</span></p>
    <p xml:id="p933" begin="37493710000t" end="37512890000t" style="style0"><span style="style1">-Ia adalah kualiti -Saya tidak memancing. daripada umpan.</span></p>
    <p xml:id="p934" begin="37512890000t" end="37524990000t" style="style0"><span style="style1">Ia terlalu berbahaya.</span></p>
    <p xml:id="p935" begin="37524990000t" end="37546680000t" style="style0"><span style="style1">Awak risaukan saya?</span></p>
    <p xml:id="p936" begin="37546680000t" end="37567940000t" style="style0"><span style="style1">tujuan saya dengan lembing bukanlah seperti yang sebelumnya. Tidak, cuma</span></p>
    <p xml:id="p937" begin="37567940000t" end="37582130000t" style="style0"><span style="style1">sebelum anda membuangnya. Kemudian mendekatkan diri</span></p>
    <p xml:id="p938" begin="37670550000t" end="37686400000t" style="style0"><span style="style1">Hei! Cantik!</span></p>
    <p xml:id="p939" begin="37716430000t" end="37731860000t" style="style0"><span style="style1">Maksud saya ular itu! (Merengus)</span></p>
    <p xml:id="p940" begin="37731860000t" end="37746460000t" style="style0"><span style="style1">(MERENGANG)</span></p>
    <p xml:id="p941" begin="37784000000t" end="37797760000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p942" begin="37837390000t" end="37849480000t" style="style0"><span style="style1">(JERIT)</span></p>
    <p xml:id="p943" begin="37934570000t" end="37947910000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p944" begin="38014650000t" end="38027990000t" style="style0"><span style="style1">(ULAR MENGERUNG)</span></p>
    <p xml:id="p945" begin="38077210000t" end="38099310000t" style="style0"><span style="style1">Itu berkesan. Jom pergi lagi.</span></p>
    <p xml:id="p946" begin="38099310000t" end="38128500000t" style="style0"><span style="style1">perlu berjuntai lebih lama. Kali ini, umpan</span></p>
    <p xml:id="p947" begin="38128500000t" end="38143110000t" style="style0"><span style="style1">Saya mesti menyerang tempat lemah dari belakang.</span></p>
    <p xml:id="p948" begin="38143110000t" end="38157290000t" style="style0"><span style="style1">mereka mempunyai kelemahan? Dan bagaimana anda tahu</span></p>
    <p xml:id="p949" begin="38157290000t" end="38171050000t" style="style0"><span style="style1">Tetapi mereka mesti, bukan? saya tidak.</span></p>
    <p xml:id="p950" begin="38171050000t" end="38186070000t" style="style0"><span style="style1">(Merengek) Pergi!</span></p>
    <p xml:id="p951" begin="38205670000t" end="38218180000t" style="style0"><span style="style1">(Meraung)</span></p>
    <p xml:id="p952" begin="38242790000t" end="38257390000t" style="style0"><span style="style1">(SERUAN ANAT)</span></p>
    <p xml:id="p953" begin="38310350000t" end="38327460000t" style="style0"><span style="style1">(Meraung)</span></p>
    <p xml:id="p954" begin="38381260000t" end="38395860000t" style="style0"><span style="style1">(TANAH BEK)</span></p>
    <p xml:id="p955" begin="38438810000t" end="38456340000t" style="style0"><span style="style1">Anda telah membuatnya marah. Cemerlang!</span></p>
    <p xml:id="p956" begin="38498870000t" end="38511390000t" style="style0"><span style="style1">(SELUAR)</span></p>
    <p xml:id="p957" begin="38530990000t" end="38543920000t" style="style0"><span style="style1">(JERENG)</span></p>
    <p xml:id="p958" begin="38548100000t" end="38560190000t" style="style0"><span style="style1">(TERHANGAT)</span></p>
    <p xml:id="p959" begin="38572700000t" end="38586470000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p960" begin="38618990000t" end="38636100000t" style="style0"><span style="style1">Sayang sekali anda tidak boleh terbang lagi. (Horus mengerang)</span></p>
    <p xml:id="p961" begin="38642770000t" end="38657370000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p962" begin="38694910000t" end="38708670000t" style="style0"><span style="style1">(BEK SERU)</span></p>
    <p xml:id="p963" begin="38711170000t" end="38725770000t" style="style0"><span style="style1">Anda juga tidak boleh.</span></p>
    <p xml:id="p964" begin="38771650000t" end="38786250000t" style="style0"><span style="style1">(MENJERIT)</span></p>
    <p xml:id="p965" begin="38839210000t" end="38853400000t" style="style0"><span style="style1">(TERUS MENJERIT)</span></p>
    <p xml:id="p966" begin="38867170000t" end="38879250000t" style="style0"><span style="style1">(BEK TERKECIK)</span></p>
    <p xml:id="p967" begin="39059850000t" end="39075710000t" style="style0"><span style="style1">awak!</span></p>
    <p xml:id="p968" begin="39081120000t" end="39100730000t" style="style0"><span style="style1">dan menjauhi saya. diam saja</span></p>
    <p xml:id="p969" begin="39133680000t" end="39149520000t" style="style0"><span style="style1">(MERENGANG)</span></p>
    <p xml:id="p970" begin="39149520000t" end="39184980000t" style="style0"><span style="style1">anda tidak termasuk dalam pertempuran. gadis cantik,</span></p>
    <p xml:id="p971" begin="39197910000t" end="39213340000t" style="style0"><span style="style1">Bakar dia!</span></p>
    <p xml:id="p972" begin="39213340000t" end="39227940000t" style="style0"><span style="style1">(BERDESIK)</span></p>
    <p xml:id="p973" begin="39259630000t" end="39280910000t" style="style0"><span style="style1">Alangkah indahnya makhlukmu.</span></p>
    <p xml:id="p974" begin="39293420000t" end="39307190000t" style="style0"><span style="style1">Biar saya bantu awak.</span></p>
    <p xml:id="p975" begin="39335550000t" end="39348060000t" style="style0"><span style="style1">ASTARTE: Bakar dia!</span></p>
    <p xml:id="p976" begin="39356820000t" end="39384760000t" style="style0"><span style="style1">Awak sangat sejuk.</span></p>
    <p xml:id="p977" begin="39399770000t" end="39436900000t" style="style0"><span style="style1">Panaskan diri. saya perintahkan awak.</span></p>
    <p xml:id="p978" begin="39436900000t" end="39457760000t" style="style0"><span style="style1">(MENGERAM)</span></p>
    <p xml:id="p979" begin="39457760000t" end="39469840000t" style="style0"><span style="style1">(MENJERIT)</span></p>
    <p xml:id="p980" begin="39521560000t" end="39538670000t" style="style0"><span style="style1">dengan pantas.</span></p>
    <p xml:id="p981" begin="39551590000t" end="39569120000t" style="style0"><span style="style1">(MERENGANG)</span></p>
    <p xml:id="p982" begin="39577040000t" end="39589960000t" style="style0"><span style="style1">(MULA MENJERIT)</span></p>
    <p xml:id="p983" begin="39634600000t" end="39647110000t" style="style0"><span style="style1">adalah lebih baik. Syarikat anda</span></p>
    <p xml:id="p984" begin="39740110000t" end="39759310000t" style="style0"><span style="style1">HORUS: Keterlaluan!</span></p>
    <p xml:id="p985" begin="39759310000t" end="39775990000t" style="style0"><span style="style1">HATHOR: Anda dialu-alukan kerana menyelamatkan nyawa anda.</span></p>
    <p xml:id="p986" begin="39775990000t" end="39790160000t" style="style0"><span style="style1">Maka semasa aku duduk buta di dalam kubur ayahku,</span></p>
    <p xml:id="p987" begin="39790160000t" end="39800170000t" style="style0"><span style="style1">katil dengan tuhan yang anda kongsi</span></p>
    <p xml:id="p988" begin="39800170000t" end="39820190000t" style="style0"><span style="style1">yang mencabut mata saya.</span></p>
    <p xml:id="p989" begin="39820190000t" end="39844810000t" style="style0"><span style="style1">pada seseorang yang tidak dapat melihat? Mengapa saya akan membazirkan ini</span></p>
    <p xml:id="p990" begin="39844810000t" end="39863160000t" style="style0"><span style="style1">Kenapa saya percaya awak lagi?</span></p>
    <p xml:id="p991" begin="39863160000t" end="39889020000t" style="style0"><span style="style1">Dia membunuh semua tuhan yang tidak akan tunduk kepadanya.</span></p>
    <p xml:id="p992" begin="39889020000t" end="39910280000t" style="style0"><span style="style1">Itu termasuk saya.</span></p>
    <p xml:id="p993" begin="39910280000t" end="39927390000t" style="style0"><span style="style1">Kami menceroboh kuil Set.</span></p>
    <p xml:id="p994" begin="39927390000t" end="39940310000t" style="style0"><span style="style1">Horus akan membunuhnya.</span></p>
    <p xml:id="p995" begin="39940310000t" end="39954920000t" style="style0"><span style="style1">merancang untuk masuk? Apa khabar</span></p>
    <p xml:id="p996" begin="39963260000t" end="39980770000t" style="style0"><span style="style1">Dia?</span></p>
    <p xml:id="p997" begin="39980770000t" end="40000370000t" style="style0"><span style="style1">Dia telah melihat rancangan itu. Dia tahu jalannya.</span></p>
    <p xml:id="p998" begin="40000370000t" end="40014140000t" style="style0"><span style="style1">Adakah anda sudah lupa tentang itu? Bagaimana dengan Sphinx?</span></p>
    <p xml:id="p999" begin="40014140000t" end="40034160000t" style="style0"><span style="style1">&quot;Sphinx&quot;?</span></p>
    <p xml:id="p1000" begin="40034160000t" end="40055430000t" style="style0"><span style="style1">untuk menjaga apinya. Set menangkapnya</span></p>
    <p xml:id="p1001" begin="40055430000t" end="40080450000t" style="style0"><span style="style1">Ia akan membunuh tanpa belas kasihan semua yang masuk</span></p>
    <p xml:id="p1002" begin="40080450000t" end="40096730000t" style="style0"><span style="style1">jawab teka-tekinya. jika mereka tidak boleh</span></p>
    <p xml:id="p1003" begin="40096730000t" end="40109240000t" style="style0"><span style="style1">teka-teki, kan? Anda boleh menjawab</span></p>
    <p xml:id="p1004" begin="40109240000t" end="40123000000t" style="style0"><span style="style1">Thoth untuk bantuan. Kami akan bertanya</span></p>
    <p xml:id="p1005" begin="40130500000t" end="40152610000t" style="style0"><span style="style1">(SCOFFS) Kenapa awak sengaja buat macam tu?</span></p>
    <p xml:id="p1006" begin="40152610000t" end="40174720000t" style="style0"><span style="style1">daripada yang sangat diperlukan. Jadi kita tidak perlu mati lebih awal</span></p>
    <p xml:id="p1007" begin="40174720000t" end="40189740000t" style="style0"><span style="style1">jom pergi.</span></p>
    <p xml:id="p1008" begin="40300670000t" end="40313610000t" style="style0"><span style="style1">Adakah dia memberi awak pakaian itu?</span></p>
    <p xml:id="p1009" begin="40334880000t" end="40354480000t" style="style0"><span style="style1">apa yang disediakan. Saya memilih daripada</span></p>
    <p xml:id="p1010" begin="40354480000t" end="40367000000t" style="style0"><span style="style1">yang anda fikir Jadi anda pilih</span></p>
    <p xml:id="p1011" begin="40367000000t" end="40382420000t" style="style0"><span style="style1">akan paling menggembirakannya.</span></p>
    <p xml:id="p1012" begin="40382420000t" end="40400770000t" style="style0"><span style="style1">Saya berpakaian untuk menggembirakan diri sendiri. HORUS: Hmm.</span></p>
    <p xml:id="p1013" begin="40400770000t" end="40423720000t" style="style0"><span style="style1">kenapa? Anda tidak menyukainya?</span></p>
    <p xml:id="p1014" begin="40423720000t" end="40440810000t" style="style0"><span style="style1">Ia terlalu banyak.</span></p>
    <p xml:id="p1015" begin="40440810000t" end="40467100000t" style="style0"><span style="style1">Saya adalah Dewi Terlalu Banyak.</span></p>
    <p xml:id="p1016" begin="40467100000t" end="40482940000t" style="style0"><span style="style1">Dan ada banyak yang saya telah berikan kepada anda</span></p>
    <p xml:id="p1017" begin="40482940000t" end="40498380000t" style="style0"><span style="style1">anda tidak pernah mendapati berlebihan.</span></p>
    <p xml:id="p1018" begin="40505880000t" end="40518820000t" style="style0"><span style="style1">Ah.</span></p>
    <p xml:id="p1019" begin="40518820000t" end="40539670000t" style="style0"><span style="style1">Sekarang mungkin terlalu sedikit.</span></p>
    <p xml:id="p1020" begin="40539670000t" end="40565110000t" style="style0"><span style="style1">Anda tidak pernah begitu sukar untuk menyenangkan hati.</span></p>
    <p xml:id="p1021" begin="40565110000t" end="40580130000t" style="style0"><span style="style1">Anda melambatkan kami.</span></p>
    <p xml:id="p1022" begin="40581370000t" end="40598480000t" style="style0"><span style="style1">Ooh.</span></p>
    <p xml:id="p1023" begin="40620990000t" end="40643940000t" style="style0"><span style="style1">Saya fikir ia membuatkan anda kelihatan nakal.</span></p>
    <p xml:id="p1024" begin="40643940000t" end="40663120000t" style="style0"><span style="style1">Apakah rupa saya sebelum ini?</span></p>
    <p xml:id="p1025" begin="40663120000t" end="40678980000t" style="style0"><span style="style1">-Tidak sedar. -Oh!</span></p>
    <p xml:id="p1026" begin="40678980000t" end="40689820000t" style="style0"><span style="style1">Tetapi dengan cara yang comel.</span></p>
    <p xml:id="p1027" begin="40689820000t" end="40710260000t" style="style0"><span style="style1">Tidak sedar apa?</span></p>
    <p xml:id="p1028" begin="40710260000t" end="40738200000t" style="style0"><span style="style1">Tepat sekali. Awak selalu menganggap saya remeh.</span></p>
    <p xml:id="p1029" begin="40738200000t" end="40755720000t" style="style0"><span style="style1">apa?</span></p>
    <p xml:id="p1030" begin="40755720000t" end="40773650000t" style="style0"><span style="style1">Dengan mata anda kembali, anda sepatutnya datang untuk mendapatkan saya.</span></p>
    <p xml:id="p1031" begin="40773650000t" end="40790750000t" style="style0"><span style="style1">-Tidakkah saya cukup bermakna kepada anda? -Oh?</span></p>
    <p xml:id="p1032" begin="40814110000t" end="40828710000t" style="style0"><span style="style1">(HATHOR MENJERIT)</span></p>
    <p xml:id="p1033" begin="40841210000t" end="40854150000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p1034" begin="40915040000t" end="40934230000t" style="style0"><span style="style1">(KETAWA)</span></p>
    <p xml:id="p1035" begin="40934230000t" end="40957590000t" style="style0"><span style="style1">Jadilah sayang dan ambilkan saya air bersih.</span></p>
    <p xml:id="p1036" begin="40991360000t" end="41007640000t" style="style0"><span style="style1">Adakah ia akan membunuh anda untuk mengatakan &quot;tolong&quot;?</span></p>
    <p xml:id="p1037" begin="41007640000t" end="41037670000t" style="style0"><span style="style1">dalam mood nak berdebat. Saya benar-benar tidak</span></p>
    <p xml:id="p1038" begin="41037670000t" end="41079790000t" style="style0"><span style="style1">Pergi ambil untuk saya. saya perintahkan awak.</span></p>
    <p xml:id="p1039" begin="41101470000t" end="41113570000t" style="style0"><span style="style1">Anda semua sama, bukan?</span></p>
    <p xml:id="p1040" begin="41128170000t" end="41141100000t" style="style0"><span style="style1">siapa nama dia?</span></p>
    <p xml:id="p1041" begin="41155700000t" end="41182390000t" style="style0"><span style="style1">Saya boleh membuat mana-mana lelaki, wanita, tuhan atau binatang melakukan perintah saya.</span></p>
    <p xml:id="p1042" begin="41182390000t" end="41202410000t" style="style0"><span style="style1">Melainkan hati mereka milik orang lain.</span></p>
    <p xml:id="p1043" begin="41215760000t" end="41230360000t" style="style0"><span style="style1">awak sedang jatuh cinta.</span></p>
    <p xml:id="p1044" begin="41251620000t" end="41276240000t" style="style0"><span style="style1">Nama dia Zaya.</span></p>
    <p xml:id="p1045" begin="41316690000t" end="41332120000t" style="style0"><span style="style1">saya minta maaf sangat.</span></p>
    <p xml:id="p1046" begin="41416790000t" end="41441810000t" style="style0"><span style="style1">Saya berjanji kepadanya rumah yang sesuai.</span></p>
    <p xml:id="p1047" begin="41441810000t" end="41461010000t" style="style0"><span style="style1">Wang untuk keluarga. Kehormatan.</span></p>
    <p xml:id="p1048" begin="41461010000t" end="41482690000t" style="style0"><span style="style1">Saya tidak memberinya apa-apa.</span></p>
    <p xml:id="p1049" begin="41482690000t" end="41497710000t" style="style0"><span style="style1">Oh, dia tidak akan bersama anda</span></p>
    <p xml:id="p1050" begin="41497710000t" end="41510220000t" style="style0"><span style="style1">jika dia tidak mencintai awak.</span></p>
    <p xml:id="p1051" begin="41510220000t" end="41522730000t" style="style0"><span style="style1">Percayalah, saya tahu.</span></p>
    <p xml:id="p1052" begin="41522730000t" end="41536500000t" style="style0"><span style="style1">Saya akan menebusnya.</span></p>
    <p xml:id="p1053" begin="41536500000t" end="41551920000t" style="style0"><span style="style1">Tetapi saya fikir dia...</span></p>
    <p xml:id="p1054" begin="41551920000t" end="41562770000t" style="style0"><span style="style1">untuk membawanya kembali. Horus akan pergi</span></p>
    <p xml:id="p1055" begin="41562770000t" end="41576950000t" style="style0"><span style="style1">Dia cakap macam tu?</span></p>
    <p xml:id="p1056" begin="41576950000t" end="41597810000t" style="style0"><span style="style1">Saya tahu sukar untuk melihat masa lalunya</span></p>
    <p xml:id="p1057" begin="41597810000t" end="41611570000t" style="style0"><span style="style1">dan pengisytiharan balas dendam tetapi... pendek baran</span></p>
    <p xml:id="p1058" begin="41626590000t" end="41641600000t" style="style0"><span style="style1">Dia tidak begitu teruk.</span></p>
    <p xml:id="p1059" begin="41647860000t" end="41659120000t" style="style0"><span style="style1">Sukar untuk dilihat.</span></p>
    <p xml:id="p1060" begin="41752120000t" end="41765470000t" style="style0"><span style="style1">Itu dia.</span></p>
    <p xml:id="p1061" begin="41774230000t" end="41789250000t" style="style0"><span style="style1">(METALLIC RATTLE)</span></p>
    <p xml:id="p1062" begin="42076620000t" end="42092050000t" style="style0"><span style="style1">BEK: Adakah itu dia?</span></p>
    <p xml:id="p1063" begin="42099140000t" end="42119160000t" style="style0"><span style="style1">-Sudah tentu tidak. -Mereka?</span></p>
    <p xml:id="p1064" begin="42119160000t" end="42132500000t" style="style0"><span style="style1">Lalu siapakah mereka? (TERGAS)</span></p>
    <p xml:id="p1065" begin="42132500000t" end="42147520000t" style="style0"><span style="style1">hamba-hambanya yang dipercayai.</span></p>
    <p xml:id="p1066" begin="42158370000t" end="42179220000t" style="style0"><span style="style1">Dia hanya mempercayai dirinya.</span></p>
    <p xml:id="p1067" begin="42179220000t" end="42199660000t" style="style0"><span style="style1">Kaya dengan kompos yang banyak.</span></p>
    <p xml:id="p1068" begin="42199660000t" end="42222590000t" style="style0"><span style="style1">Berwarna-warni.</span></p>
    <p xml:id="p1069" begin="42222590000t" end="42247210000t" style="style0"><span style="style1">Terutamanya dalam spektrum hijau dan merah.</span></p>
    <p xml:id="p1070" begin="42247210000t" end="42291000000t" style="style0"><span style="style1">Varieti beraneka ragam dengan perbungaan terdiri daripada berbilang kuntum,</span></p>
    <p xml:id="p1071" begin="42291000000t" end="42317280000t" style="style0"><span style="style1">setiap satu dengan kelopak yang diubah suai.</span></p>
    <p xml:id="p1072" begin="42317280000t" end="42352720000t" style="style0"><span style="style1">Tuhan Firman Suci yang Bijaksana, kami meminta nasihat-Mu.</span></p>
    <p xml:id="p1073" begin="42352720000t" end="42385680000t" style="style0"><span style="style1">tercabut dan dibakar. Sekali, lalang,</span></p>
    <p xml:id="p1074" begin="42385680000t" end="42417790000t" style="style0"><span style="style1">untuk kekuatan minyaknya Kini dihargai</span></p>
    <p xml:id="p1075" begin="42417790000t" end="42441990000t" style="style0"><span style="style1">dan rezeki daunnya.</span></p>
    <p xml:id="p1076" begin="42441990000t" end="42468260000t" style="style0"><span style="style1">Tetapi apakah kebenarannya?</span></p>
    <p xml:id="p1077" begin="42498710000t" end="42517890000t" style="style0"><span style="style1">awak! pusing balik.</span></p>
    <p xml:id="p1078" begin="42517890000t" end="42529990000t" style="style0"><span style="style1">pandangan dari belakang? Anda lebih suka</span></p>
    <p xml:id="p1079" begin="42529990000t" end="42559600000t" style="style0"><span style="style1">Tidak, saya... Ya, ya.</span></p>
    <p xml:id="p1080" begin="42559600000t" end="42582950000t" style="style0"><span style="style1">Awak tahu saya tidak boleh berbohong. pusing.</span></p>
    <p xml:id="p1081" begin="42582950000t" end="42599230000t" style="style0"><span style="style1">Saya tidak akan mengambil risiko</span></p>
    <p xml:id="p1082" begin="42599230000t" end="42619660000t" style="style0"><span style="style1">memandang matamu yang licik itu.</span></p>
    <p xml:id="p1083" begin="42619660000t" end="42643850000t" style="style0"><span style="style1">-Empat puluh tujuh. -Maafkan saya?</span></p>
    <p xml:id="p1084" begin="42643850000t" end="42657200000t" style="style0"><span style="style1">Peratusan ilmu yang saya catat setakat ini.</span></p>
    <p xml:id="p1085" begin="42657200000t" end="42678890000t" style="style0"><span style="style1">Saya belum lagi separuh.</span></p>
    <p xml:id="p1086" begin="42678890000t" end="42707670000t" style="style0"><span style="style1">-Jawapan kepada teka-teki -Thoth, saya hanya perlukan... Sphinx.</span></p>
    <p xml:id="p1087" begin="42707670000t" end="42728940000t" style="style0"><span style="style1">Seorang kanak-kanak boleh menyimpulkan mengapa anda berada di sini.</span></p>
    <p xml:id="p1088" begin="42728940000t" end="42745200000t" style="style0"><span style="style1">Pergi tanya teka-teki</span></p>
    <p xml:id="p1089" begin="42745200000t" end="42765640000t" style="style0"><span style="style1">dan sampaikan kepada saya. dan kembali</span></p>
    <p xml:id="p1090" begin="42765640000t" end="42779410000t" style="style0"><span style="style1">Saya akan menyelesaikannya.</span></p>
    <p xml:id="p1091" begin="42779410000t" end="42799840000t" style="style0"><span style="style1">Salah seorang daripada kita perlu mati.</span></p>
    <p xml:id="p1092" begin="42799840000t" end="42821530000t" style="style0"><span style="style1">Nah, lukis banyak.</span></p>
    <p xml:id="p1093" begin="42821530000t" end="42840300000t" style="style0"><span style="style1">-Mari bersama kami. -Ha!</span></p>
    <p xml:id="p1094" begin="42840300000t" end="42866160000t" style="style0"><span style="style1">-Saya akan memberi anda satu malam. -Suatu malam. Hmm...</span></p>
    <p xml:id="p1095" begin="42866160000t" end="42886180000t" style="style0"><span style="style1">Tidak, anda tidak akan.</span></p>
    <p xml:id="p1096" begin="42886180000t" end="42908280000t" style="style0"><span style="style1">sebelum dia membinasakan kita semua. Set mesti dihentikan</span></p>
    <p xml:id="p1097" begin="42908280000t" end="42933300000t" style="style0"><span style="style1">Anda nampak hikmahnya, bukan?</span></p>
    <p xml:id="p1098" begin="42933300000t" end="42970010000t" style="style0"><span style="style1">terlalu penting untuk mengambil risiko. Ini jauh</span></p>
    <p xml:id="p1099" begin="42970010000t" end="42993360000t" style="style0"><span style="style1">nama sebenar bintang. saya boleh mengaji</span></p>
    <p xml:id="p1100" begin="42993360000t" end="43011310000t" style="style0"><span style="style1">saya tahu.</span></p>
    <p xml:id="p1101" begin="43011310000t" end="43023390000t" style="style0"><span style="style1">Saya telah melihat dunia yang dicipta daripada pasir dan air.</span></p>
    <p xml:id="p1102" begin="43023390000t" end="43041340000t" style="style0"><span style="style1">Mmm-hmm.</span></p>
    <p xml:id="p1103" begin="43041340000t" end="43055090000t" style="style0"><span style="style1">Saya mengandungi semua kebijaksanaan di alam semesta.</span></p>
    <p xml:id="p1104" begin="43055090000t" end="43078040000t" style="style0"><span style="style1">Lebih berharga daripada beberapa mahkota.</span></p>
    <p xml:id="p1105" begin="43078040000t" end="43103470000t" style="style0"><span style="style1">Ha! Saya ada!</span></p>
    <p xml:id="p1106" begin="43103470000t" end="43124750000t" style="style0"><span style="style1">Misterinya. Intipatinya. Kebenarannya.</span></p>
    <p xml:id="p1107" begin="43137260000t" end="43149780000t" style="style0"><span style="style1">Ia adalah salad!</span></p>
    <p xml:id="p1108" begin="43155610000t" end="43183550000t" style="style0"><span style="style1">menjatuhkan pengawalnya. ayah awak</span></p>
    <p xml:id="p1109" begin="43183550000t" end="43205660000t" style="style0"><span style="style1">Itu bukan sahaja sangat bodoh,</span></p>
    <p xml:id="p1110" begin="43205660000t" end="43234440000t" style="style0"><span style="style1">untuk menulis segala-galanya tetapi sekarang saya terpaksa saya tahu</span></p>
    <p xml:id="p1111" begin="43234440000t" end="43258630000t" style="style0"><span style="style1">kemungkinan jauh sebagai pertahanan terhadap</span></p>
    <p xml:id="p1112" begin="43258630000t" end="43274480000t" style="style0"><span style="style1">bahawa perang Set menemui saya.</span></p>
    <p xml:id="p1113" begin="43274480000t" end="43309520000t" style="style0"><span style="style1">Saya minta maaf bahawa mayat ibu bapa saya</span></p>
    <p xml:id="p1114" begin="43309520000t" end="43323690000t" style="style0"><span style="style1">telah menyusahkan anda.</span></p>
    <p xml:id="p1115" begin="43323690000t" end="43360400000t" style="style0"><span style="style1">Permintaan maaf diterima. Sekarang, keluar!</span></p>
    <p xml:id="p1116" begin="43360400000t" end="43382510000t" style="style0"><span style="style1">Tetapi anda perlu membantu kami!</span></p>
    <p xml:id="p1117" begin="43382510000t" end="43393760000t" style="style0"><span style="style1">(PEDANG BERKATA)</span></p>
    <p xml:id="p1118" begin="43393760000t" end="43410870000t" style="style0"><span style="style1">THOTH: Berhati-hati.</span></p>
    <p xml:id="p1119" begin="43410870000t" end="43432140000t" style="style0"><span style="style1">Saya melebihi jumlah anda.</span></p>
    <p xml:id="p1120" begin="43450080000t" end="43463420000t" style="style0"><span style="style1">Whoa, whoa, whoa!</span></p>
    <p xml:id="p1121" begin="43482610000t" end="43502630000t" style="style0"><span style="style1">tak mengapa. Saya akan buat.</span></p>
    <p xml:id="p1122" begin="43502630000t" end="43524310000t" style="style0"><span style="style1">Saya fikir awak adalah babun sesat.</span></p>
    <p xml:id="p1123" begin="43524310000t" end="43548510000t" style="style0"><span style="style1">Saya beritahu awak saya yang akan berhadapan dengan Sphinx.</span></p>
    <p xml:id="p1124" begin="43548510000t" end="43576030000t" style="style0"><span style="style1">Peluang kegagalan anda amat besar.</span></p>
    <p xml:id="p1125" begin="43576030000t" end="43596050000t" style="style0"><span style="style1">Tetapi sebelum ia membunuh saya, saya pasti.</span></p>
    <p xml:id="p1126" begin="43596050000t" end="43609820000t" style="style0"><span style="style1">Saya akan memberitahu bahawa saya bertanya</span></p>
    <p xml:id="p1127" begin="43609820000t" end="43626500000t" style="style0"><span style="style1">Tuhan Kebijaksanaan yang akan datang</span></p>
    <p xml:id="p1128" begin="43626500000t" end="43644010000t" style="style0"><span style="style1">dia akan mendapat jawapan yang salah. tetapi dia takut</span></p>
    <p xml:id="p1129" begin="43644010000t" end="43669880000t" style="style0"><span style="style1">Ini adalah strategi paling bijak yang boleh anda buat?</span></p>
    <p xml:id="p1130" begin="43669880000t" end="43684050000t" style="style0"><span style="style1">mempermainkan ego saya?</span></p>
    <p xml:id="p1131" begin="43684050000t" end="43705330000t" style="style0"><span style="style1">Betapa sia-sianya saya?</span></p>
    <p xml:id="p1132" begin="43738280000t" end="43752460000t" style="style0"><span style="style1">Um... Hmm.</span></p>
    <p xml:id="p1133" begin="43783330000t" end="43795420000t" style="style0"><span style="style1">Ya, baiklah...</span></p>
    <p xml:id="p1134" begin="43802100000t" end="43813770000t" style="style0"><span style="style1">baiklah.</span></p>
    <p xml:id="p1135" begin="43822530000t" end="43834200000t" style="style0"><span style="style1">baiklah!</span></p>
    <p xml:id="p1136" begin="43872580000t" end="43884250000t" style="style0"><span style="style1">jom pergi.</span></p>
    <p xml:id="p1137" begin="43902610000t" end="43914280000t" style="style0"><span style="style1">Selamat tinggal.</span></p>
    <p xml:id="p1138" begin="43934300000t" end="43948490000t" style="style0"><span style="style1">Syabas.</span></p>
    <p xml:id="p1139" begin="43948490000t" end="43963090000t" style="style0"><span style="style1">terima kasih.</span></p>
    <p xml:id="p1140" begin="44113240000t" end="44134500000t" style="style0"><span style="style1">HATHOR: Anda tahu Zayanya tidak boleh kembali.</span></p>
    <p xml:id="p1141" begin="44134500000t" end="44154520000t" style="style0"><span style="style1">Raja tidak mempunyai kuasa.</span></p>
    <p xml:id="p1142" begin="44154520000t" end="44174960000t" style="style0"><span style="style1">Anubis tidak mempunyai kuasa.</span></p>
    <p xml:id="p1143" begin="44174960000t" end="44188730000t" style="style0"><span style="style1">Awak tipu dia.</span></p>
    <p xml:id="p1144" begin="44204570000t" end="44230440000t" style="style0"><span style="style1">Dia mungkin akan mati ke dalam piramid Set. cuba pecah</span></p>
    <p xml:id="p1145" begin="44230440000t" end="44249210000t" style="style0"><span style="style1">Dia menawarkan nyawanya.</span></p>
    <p xml:id="p1146" begin="44249210000t" end="44265470000t" style="style0"><span style="style1">Kerana dia fikir dia boleh menyelamatkannya.</span></p>
    <p xml:id="p1147" begin="44265470000t" end="44284650000t" style="style0"><span style="style1">Dia percaya apa yang dia mahu percaya.</span></p>
    <p xml:id="p1148" begin="44284650000t" end="44314680000t" style="style0"><span style="style1">dalam lebih daripada satu cara. Anda telah buta</span></p>
    <p xml:id="p1149" begin="44314680000t" end="44334700000t" style="style0"><span style="style1">Anda benar-benar melihat dunia wujud?</span></p>
    <p xml:id="p1150" begin="44334700000t" end="44353900000t" style="style0"><span style="style1">saya tak tipu.</span></p>
    <p xml:id="p1151" begin="44353900000t" end="44365570000t" style="style0"><span style="style1">menontonnya dari, Di manakah anda</span></p>
    <p xml:id="p1152" begin="44365570000t" end="44382680000t" style="style0"><span style="style1">jika belum ada yang dicipta?</span></p>
    <p xml:id="p1153" begin="44382680000t" end="44408530000t" style="style0"><span style="style1">Jika saya cuba menjelaskan,</span></p>
    <p xml:id="p1154" begin="44408530000t" end="44426880000t" style="style0"><span style="style1">otak anda akan cair dan kehabisan telinga anda.</span></p>
    <p xml:id="p1155" begin="44443570000t" end="44469010000t" style="style0"><span style="style1">jalan balas dendam. Saya tidak memilih</span></p>
    <p xml:id="p1156" begin="44469010000t" end="44486520000t" style="style0"><span style="style1">Saya tidak memilih satu pun daripada ini.</span></p>
    <p xml:id="p1157" begin="44486520000t" end="44504870000t" style="style0"><span style="style1">Awak beritahu saya apa jenis kuasa yang saya ada?</span></p>
    <p xml:id="p1158" begin="44504870000t" end="44534080000t" style="style0"><span style="style1">Anda mempunyai kuasa untuk membetulkannya.</span></p>
    <p xml:id="p1159" begin="44534080000t" end="44554920000t" style="style0"><span style="style1">untuk mengetahui kebenaran. Dia layak</span></p>
    <p xml:id="p1160" begin="44554920000t" end="44589130000t" style="style0"><span style="style1">Saya perlukan dia untuk membawa kita masuk untuk mencekik api Set.</span></p>
    <p xml:id="p1161" begin="44589130000t" end="44612490000t" style="style0"><span style="style1">Adakah itu yang anda mahukan? Jika dia menolak, kita semua akan mati.</span></p>
    <p xml:id="p1162" begin="44735100000t" end="44758880000t" style="style0"><span style="style1">Terlalu berbahaya untuk menyeberangi dataran.</span></p>
    <p xml:id="p1163" begin="44758880000t" end="44773900000t" style="style0"><span style="style1">Kami akan menunggu kegelapan.</span></p>
    <p xml:id="p1164" begin="44773900000t" end="44793090000t" style="style0"><span style="style1">Tetapi kita kesuntukan masa.</span></p>
    <p xml:id="p1165" begin="44793090000t" end="44809770000t" style="style0"><span style="style1">-Saya katakan kita menyeberang sekarang. -Dan saya katakan kita tunggu.</span></p>
    <p xml:id="p1166" begin="44833540000t" end="44845210000t" style="style0"><span style="style1">(ELUPAS)</span></p>
    <p xml:id="p1167" begin="44918210000t" end="44955320000t" style="style0"><span style="style1">Sepanjang masa awak berjauhan, dia tak pernah lupakan awak.</span></p>
    <p xml:id="p1168" begin="44968260000t" end="44992030000t" style="style0"><span style="style1">Hati Hathor tau. Awak selalu masuk</span></p>
    <p xml:id="p1169" begin="44992030000t" end="45014140000t" style="style0"><span style="style1">Ya, tetapi dia mempunyai hati yang besar.</span></p>
    <p xml:id="p1170" begin="45014140000t" end="45027900000t" style="style0"><span style="style1">Bilik yang cukup untuk orang ramai di sana.</span></p>
    <p xml:id="p1171" begin="45043340000t" end="45078370000t" style="style0"><span style="style1">Beritahu saya, oh, Tuhan Udara yang bijaksana.</span></p>
    <p xml:id="p1172" begin="45078370000t" end="45098390000t" style="style0"><span style="style1">Mengapa anda fikir Set membiarkan anda hidup?</span></p>
    <p xml:id="p1173" begin="45121750000t" end="45136340000t" style="style0"><span style="style1">Dia melakukannya kerana cinta.</span></p>
    <p xml:id="p1174" begin="45136340000t" end="45165530000t" style="style0"><span style="style1">Anda akan menghukum dia untuk itu?</span></p>
    <p xml:id="p1175" begin="45165530000t" end="45185550000t" style="style0"><span style="style1">Saya tidak mahu bantuan dia.</span></p>
    <p xml:id="p1176" begin="45204750000t" end="45225180000t" style="style0"><span style="style1">Saya hanya mahu satu perkara.</span></p>
    <p xml:id="p1177" begin="45235600000t" end="45276480000t" style="style0"><span style="style1">Saya rasa semua orang bodoh. awak tahu,</span></p>
    <p xml:id="p1178" begin="45276480000t" end="45303180000t" style="style0"><span style="style1">adalah lebih besar daripada kebanyakan. Tetapi Engkau, Tuhanku,</span></p>
    <p xml:id="p1179" begin="45475020000t" end="45485850000t" style="style0"><span style="style1">memikirkan tentang dia? HATHOR: Adakah awak</span></p>
    <p xml:id="p1180" begin="45518810000t" end="45532990000t" style="style0"><span style="style1">Sudah tentu anda.</span></p>
    <p xml:id="p1181" begin="45555920000t" end="45588040000t" style="style0"><span style="style1">sebagai Puan Barat. Saya pernah dikenali</span></p>
    <p xml:id="p1182" begin="45588040000t" end="45613910000t" style="style0"><span style="style1">Kewajipan saya adalah untuk membantu roh yang mati</span></p>
    <p xml:id="p1183" begin="45613910000t" end="45632260000t" style="style0"><span style="style1">ke alam Akhirat. buat cara mereka</span></p>
    <p xml:id="p1184" begin="45632260000t" end="45654360000t" style="style0"><span style="style1">ke Tanah Orang Mati? Anda mengembara</span></p>
    <p xml:id="p1185" begin="45654360000t" end="45680220000t" style="style0"><span style="style1">Malah kepada mereka yang telah meninggal dunia. Saya adalah Dewi Cinta.</span></p>
    <p xml:id="p1186" begin="45694400000t" end="45724430000t" style="style0"><span style="style1">Saya masih muda. Mudah tergoda.</span></p>
    <p xml:id="p1187" begin="45724430000t" end="45738190000t" style="style0"><span style="style1">&quot;Tergoda&quot;?</span></p>
    <p xml:id="p1188" begin="45738190000t" end="45753210000t" style="style0"><span style="style1">syaitan.</span></p>
    <p xml:id="p1189" begin="45753210000t" end="45774480000t" style="style0"><span style="style1">Ini menghalang mereka.</span></p>
    <p xml:id="p1190" begin="45774480000t" end="45806170000t" style="style0"><span style="style1">Gelang 42 Bintang.</span></p>
    <p xml:id="p1191" begin="45806170000t" end="45836200000t" style="style0"><span style="style1">Satu untuk setiap syaitan yang dibunuh Horus untuk membebaskan saya.</span></p>
    <p xml:id="p1192" begin="45836200000t" end="45856220000t" style="style0"><span style="style1">Masa tu aku tahu aku sayang dia.</span></p>
    <p xml:id="p1193" begin="45856220000t" end="45882510000t" style="style0"><span style="style1">awak berjuang untuk dia. Zaya perlu tahu</span></p>
    <p xml:id="p1194" begin="45882510000t" end="45895850000t" style="style0"><span style="style1">Jadi dia tidak kehilangan harapan.</span></p>
    <p xml:id="p1195" begin="45956320000t" end="45970510000t" style="style0"><span style="style1">(BISIK) Zaya.</span></p>
    <p xml:id="p1196" begin="46006370000t" end="46017640000t" style="style0"><span style="style1">Ia akan.</span></p>
    <p xml:id="p1197" begin="46041410000t" end="46075200000t" style="style0"><span style="style1">Bolehkah anda mendengar saya? Zaya? Zaya?</span></p>
    <p xml:id="p1198" begin="46081040000t" end="46094800000t" style="style0"><span style="style1">Adakah ia?</span></p>
    <p xml:id="p1199" begin="46098550000t" end="46113150000t" style="style0"><span style="style1">Siapakah itu?</span></p>
    <p xml:id="p1200" begin="46125250000t" end="46142770000t" style="style0"><span style="style1">Siapa di sana?</span></p>
    <p xml:id="p1201" begin="46142770000t" end="46170290000t" style="style0"><span style="style1">Hathor, Puan Perempuan Barat. ZAYA: Cikgu.</span></p>
    <p xml:id="p1202" begin="46170290000t" end="46190730000t" style="style0"><span style="style1">dari Tanah Kehidupan. Saya bercakap dengan awak</span></p>
    <p xml:id="p1203" begin="46190730000t" end="46205330000t" style="style0"><span style="style1">Kekasih awak ada bersama saya.</span></p>
    <p xml:id="p1204" begin="46205330000t" end="46219920000t" style="style0"><span style="style1">Zaya, ini saya. Bek?</span></p>
    <p xml:id="p1205" begin="46238690000t" end="46254960000t" style="style0"><span style="style1">Saya tahu jika ada cara, anda akan menemuinya.</span></p>
    <p xml:id="p1206" begin="46270810000t" end="46287490000t" style="style0"><span style="style1">Tetapi saya tidak dapat melihat awak.</span></p>
    <p xml:id="p1207" begin="46287490000t" end="46300840000t" style="style0"><span style="style1">kita boleh bersama lagi. BEK: Dengar,</span></p>
    <p xml:id="p1208" begin="46300840000t" end="46310430000t" style="style0"><span style="style1">awak boleh balik.</span></p>
    <p xml:id="p1209" begin="46310430000t" end="46325450000t" style="style0"><span style="style1">Tetapi bagaimana?</span></p>
    <p xml:id="p1210" begin="46332540000t" end="46346710000t" style="style0"><span style="style1">Saya menolong Horus.</span></p>
    <p xml:id="p1211" begin="46346710000t" end="46366730000t" style="style0"><span style="style1">dia akan menolong kita. Sebagai balasan,</span></p>
    <p xml:id="p1212" begin="46366730000t" end="46386750000t" style="style0"><span style="style1">ZAYA: Bek yang saya sayang?</span></p>
    <p xml:id="p1213" begin="46386750000t" end="46407610000t" style="style0"><span style="style1">Saya tahu, Zaya. Saya sendiri sukar mempercayainya.</span></p>
    <p xml:id="p1214" begin="46407610000t" end="46426380000t" style="style0"><span style="style1">(KECAK) Bek, saya, mempercayai tuhan.</span></p>
    <p xml:id="p1215" begin="46436800000t" end="46452660000t" style="style0"><span style="style1">Tapi saya silap, Zaya.</span></p>
    <p xml:id="p1216" begin="46452660000t" end="46472680000t" style="style0"><span style="style1">seperti yang anda katakan dia akan menjadi. Horus adalah tuhan yang adil,</span></p>
    <p xml:id="p1217" begin="46472680000t" end="46492700000t" style="style0"><span style="style1">&quot;Saya dah beritahu awak,&quot; sekarang. Anda mungkin berfikir,</span></p>
    <p xml:id="p1218" begin="46492700000t" end="46518140000t" style="style0"><span style="style1">Nah, ya. Sedikit sahaja. (KETAWA)</span></p>
    <p xml:id="p1219" begin="46533990000t" end="46551510000t" style="style0"><span style="style1">untuk mendengar suara anda. Ia sangat baik</span></p>
    <p xml:id="p1220" begin="46551510000t" end="46569440000t" style="style0"><span style="style1">baik-baik, Zaya, percayalah. BEK: Semuanya berjalan</span></p>
    <p xml:id="p1221" begin="46569440000t" end="46589880000t" style="style0"><span style="style1">untuk membawa awak balik. Horus akan pergi</span></p>
    <p xml:id="p1222" begin="46589880000t" end="46605310000t" style="style0"><span style="style1">Saya tahu dia akan melakukannya.</span></p>
    <p xml:id="p1223" begin="46617820000t" end="46632000000t" style="style0"><span style="style1">pertahanan?</span></p>
    <p xml:id="p1224" begin="46642010000t" end="46656200000t" style="style0"><span style="style1">Bek, awak ada ke?</span></p>
    <p xml:id="p1225" begin="46659950000t" end="46679550000t" style="style0"><span style="style1">(KAKITANGAN BERKEKUT) (TERGAS)</span></p>
    <p xml:id="p1226" begin="46679550000t" end="46709580000t" style="style0"><span style="style1">Dilarang orang mati bercakap dengan orang hidup.</span></p>
    <p xml:id="p1227" begin="46727930000t" end="46742110000t" style="style0"><span style="style1">Pergi.</span></p>
    <p xml:id="p1228" begin="46971930000t" end="46988190000t" style="style0"><span style="style1">Ada roda di dalam.</span></p>
    <p xml:id="p1229" begin="46988190000t" end="47009460000t" style="style0"><span style="style1">pasir berhenti bergerak. Apabila anda memutarnya,</span></p>
    <p xml:id="p1230" begin="47009460000t" end="47027390000t" style="style0"><span style="style1">untuk pergi melalui pintu. Kami cuma perlukan</span></p>
    <p xml:id="p1231" begin="47027390000t" end="47046590000t" style="style0"><span style="style1">Nasib baik awak nampak rancangan tu.</span></p>
    <p xml:id="p1232" begin="47046590000t" end="47067430000t" style="style0"><span style="style1">HORUS: Jika anda tidak tahu yang mana satu itu,</span></p>
    <p xml:id="p1233" begin="47067430000t" end="47079950000t" style="style0"><span style="style1">ini benar-benar mustahil.</span></p>
    <p xml:id="p1234" begin="47094550000t" end="47117480000t" style="style0"><span style="style1">-Bek? -Ya?</span></p>
    <p xml:id="p1235" begin="47117480000t" end="47137500000t" style="style0"><span style="style1">yang mana pintu, kan? Awak tahu</span></p>
    <p xml:id="p1236" begin="47147510000t" end="47161700000t" style="style0"><span style="style1">Ya, sudah tentu, ia...</span></p>
    <p xml:id="p1237" begin="47161700000t" end="47176300000t" style="style0"><span style="style1">yang ini.</span></p>
    <p xml:id="p1238" begin="47188390000t" end="47204240000t" style="style0"><span style="style1">Tidak, tidak, itu... Itu yang itu.</span></p>
    <p xml:id="p1239" begin="47213420000t" end="47225930000t" style="style0"><span style="style1">Tidak, tidak, yang ini!</span></p>
    <p xml:id="p1240" begin="47352720000t" end="47367320000t" style="style0"><span style="style1">Gulung tulang.</span></p>
    <p xml:id="p1241" begin="47377740000t" end="47396520000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1242" begin="47487850000t" end="47501200000t" style="style0"><span style="style1">(JERENG)</span></p>
    <p xml:id="p1243" begin="47650100000t" end="47664700000t" style="style0"><span style="style1">(JERENG)</span></p>
    <p xml:id="p1244" begin="47684720000t" end="47699320000t" style="style0"><span style="style1">(DEPAN BERIRAMA)</span></p>
    <p xml:id="p1245" begin="47781900000t" end="47795670000t" style="style0"><span style="style1">(KECIK)</span></p>
    <p xml:id="p1246" begin="47814440000t" end="47824450000t" style="style0"><span style="style1">THOTH: Anda rasa?</span></p>
    <p xml:id="p1247" begin="47824450000t" end="47842800000t" style="style0"><span style="style1">(Tergagap) Nah...</span></p>
    <p xml:id="p1248" begin="47842800000t" end="47878240000t" style="style0"><span style="style1">Saya mendapati pergantungan anda pada peluang merisaukan.</span></p>
    <p xml:id="p1249" begin="47878240000t" end="47892850000t" style="style0"><span style="style1">Jika anda terus bertahan,</span></p>
    <p xml:id="p1250" begin="47892850000t" end="47907860000t" style="style0"><span style="style1">Saya mungkin perlu mengkaji anda lebih lanjut.</span></p>
    <p xml:id="p1251" begin="47916620000t" end="47937480000t" style="style0"><span style="style1">jalan mana ke Sphinx? sekarang,</span></p>
    <p xml:id="p1252" begin="48259460000t" end="48288650000t" style="style0"><span style="style1">Penceroboh di Rumah Raja,</span></p>
    <p xml:id="p1253" begin="48288650000t" end="48316190000t" style="style0"><span style="style1">jawab teka-teki saya atau berhenti menjadi.</span></p>
    <p xml:id="p1254" begin="48323690000t" end="48338290000t" style="style0"><span style="style1">Teruskan.</span></p>
    <p xml:id="p1255" begin="48343300000t" end="48357900000t" style="style0"><span style="style1">saya tunggu.</span></p>
    <p xml:id="p1256" begin="48362900000t" end="48376670000t" style="style0"><span style="style1">(GROWLES)</span></p>
    <p xml:id="p1257" begin="48376670000t" end="48394180000t" style="style0"><span style="style1">Saya tidak pernah.</span></p>
    <p xml:id="p1258" begin="48408770000t" end="48428790000t" style="style0"><span style="style1">Saya sentiasa menjadi.</span></p>
    <p xml:id="p1259" begin="48428790000t" end="48466760000t" style="style0"><span style="style1">Tiada siapa yang pernah melihat saya, dan tidak akan pernah.</span></p>
    <p xml:id="p1260" begin="48466760000t" end="48504710000t" style="style0"><span style="style1">Namun saya adalah keyakinan semua yang hidup dan bernafas.</span></p>
    <p xml:id="p1261" begin="48504710000t" end="48538080000t" style="style0"><span style="style1">Apa saya?</span></p>
    <p xml:id="p1262" begin="48548910000t" end="48578530000t" style="style0"><span style="style1">Pesanan. Anda Pesanan.</span></p>
    <p xml:id="p1263" begin="48621070000t" end="48636090000t" style="style0"><span style="style1">Saya tidak pernah meragui awak.</span></p>
    <p xml:id="p1264" begin="48660690000t" end="48678220000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1265" begin="48689050000t" end="48701570000t" style="style0"><span style="style1">tak betul.</span></p>
    <p xml:id="p1266" begin="48717010000t" end="48737860000t" style="style0"><span style="style1">Cuba lagi. Tolonglah.</span></p>
    <p xml:id="p1267" begin="48758300000t" end="48776230000t" style="style0"><span style="style1">Itu adalah jawapan yang betul-betul sesuai.</span></p>
    <p xml:id="p1268" begin="48782900000t" end="48794160000t" style="style0"><span style="style1">(MENGERAM)</span></p>
    <p xml:id="p1269" begin="48794160000t" end="48810430000t" style="style0"><span style="style1">Anda adalah Kesucian.</span></p>
    <p xml:id="p1270" begin="48839200000t" end="48851720000t" style="style0"><span style="style1">(Merengus) (MEMERENG)</span></p>
    <p xml:id="p1271" begin="48870900000t" end="48884250000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p1272" begin="48884250000t" end="48909270000t" style="style0"><span style="style1">silap lagi.</span></p>
    <p xml:id="p1273" begin="48909270000t" end="48929290000t" style="style0"><span style="style1">&quot;Apa yang tidak pernah berlaku.&quot; (GAGAP)</span></p>
    <p xml:id="p1274" begin="48929290000t" end="48955160000t" style="style0"><span style="style1">&quot;Sentiasa menjadi.&quot;</span></p>
    <p xml:id="p1275" begin="48955160000t" end="48973510000t" style="style0"><span style="style1">Pada masa hadapan. Tidak wujud. khayalan.</span></p>
    <p xml:id="p1276" begin="48973510000t" end="48988110000t" style="style0"><span style="style1">(MERENGANG)</span></p>
    <p xml:id="p1277" begin="48999780000t" end="49015640000t" style="style0"><span style="style1">(Merengus) Namun...</span></p>
    <p xml:id="p1278" begin="49015640000t" end="49043160000t" style="style0"><span style="style1">THOTH: Namun ia wujud dan &quot;tidak pernah ada.&quot;</span></p>
    <p xml:id="p1279" begin="49043160000t" end="49073190000t" style="style0"><span style="style1">(MENEGANG) Thoth... &quot;Sentiasa menjadi.&quot;</span></p>
    <p xml:id="p1280" begin="49073190000t" end="49097390000t" style="style0"><span style="style1">semua yang hidup dan bernafas. Namun saya adalah keyakinan</span></p>
    <p xml:id="p1281" begin="49097390000t" end="49109470000t" style="style0"><span style="style1">Manusia hidup dan bernafas!</span></p>
    <p xml:id="p1282" begin="49109470000t" end="49125330000t" style="style0"><span style="style1">Mungkin berhenti berfikir seperti tuhan.</span></p>
    <p xml:id="p1283" begin="49125330000t" end="49135340000t" style="style0"><span style="style1">Kemudian saya mungkin juga berhenti berfikir.</span></p>
    <p xml:id="p1284" begin="49135340000t" end="49148270000t" style="style0"><span style="style1">Thoth!</span></p>
    <p xml:id="p1285" begin="49154110000t" end="49169530000t" style="style0"><span style="style1">Tunggu, tunggu, saya ada!</span></p>
    <p xml:id="p1286" begin="49169530000t" end="49187480000t" style="style0"><span style="style1">Anda adalah Esok.</span></p>
    <p xml:id="p1287" begin="49187480000t" end="49206240000t" style="style0"><span style="style1">Oh, mengganggu.</span></p>
    <p xml:id="p1288" begin="49227930000t" end="49239600000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1289" begin="49294250000t" end="49308850000t" style="style0"><span style="style1">(SPHINX MENGERENG)</span></p>
    <p xml:id="p1290" begin="49429790000t" end="49442310000t" style="style0"><span style="style1">HORUS: Satu titis.</span></p>
    <p xml:id="p1291" begin="49558260000t" end="49570770000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1292" begin="49570770000t" end="49583700000t" style="style0"><span style="style1">Tidak!</span></p>
    <p xml:id="p1293" begin="49583700000t" end="49597050000t" style="style0"><span style="style1">(SUARA BERGEMA DAN MErungut)</span></p>
    <p xml:id="p1294" begin="49614150000t" end="49628750000t" style="style0"><span style="style1">(MENGERING)</span></p>
    <p xml:id="p1295" begin="49664620000t" end="49680040000t" style="style0"><span style="style1">Saya patut terima kasih.</span></p>
    <p xml:id="p1296" begin="49695060000t" end="49716340000t" style="style0"><span style="style1">Anda menarik dia dari perpustakaannya supaya saya tidak perlu melakukannya.</span></p>
    <p xml:id="p1297" begin="49750110000t" end="49768060000t" style="style0"><span style="style1">Bahagian akhir.</span></p>
    <p xml:id="p1298" begin="49768060000t" end="49783070000t" style="style0"><span style="style1">awak pengecut.</span></p>
    <p xml:id="p1299" begin="49783070000t" end="49798500000t" style="style0"><span style="style1">Buka pintu gerbang ini dan lawan saya.</span></p>
    <p xml:id="p1300" begin="49798500000t" end="49809760000t" style="style0"><span style="style1">sekali lagi?</span></p>
    <p xml:id="p1301" begin="49820180000t" end="49850210000t" style="style0"><span style="style1">Tidakkah dia sudah cukup melihat awak kalah?</span></p>
    <p xml:id="p1302" begin="49850210000t" end="49862310000t" style="style0"><span style="style1">Tidak bolehkah awak benarkan saya melepaskan awak</span></p>
    <p xml:id="p1303" begin="49862310000t" end="49883170000t" style="style0"><span style="style1">satu saat terakhir yang memalukan</span></p>
    <p xml:id="p1304" begin="49883170000t" end="49897770000t" style="style0"><span style="style1">sebelum anda mati?</span></p>
    <p xml:id="p1305" begin="49900680000t" end="49917790000t" style="style0"><span style="style1">Berhenti!</span></p>
    <p xml:id="p1306" begin="49932800000t" end="49947400000t" style="style0"><span style="style1">Kenali ini?</span></p>
    <p xml:id="p1307" begin="49973260000t" end="49995780000t" style="style0"><span style="style1">Adakah dia memberitahu anda bahawa dia boleh membawa wanita anda kembali dari kematian?</span></p>
    <p xml:id="p1308" begin="50009550000t" end="50022470000t" style="style0"><span style="style1">Ia tidak mungkin.</span></p>
    <p xml:id="p1309" begin="50030390000t" end="50047500000t" style="style0"><span style="style1">Bukan untuk saya pun.</span></p>
    <p xml:id="p1310" begin="50047500000t" end="50060010000t" style="style0"><span style="style1">Awak harap saya percaya awak?</span></p>
    <p xml:id="p1311" begin="50078780000t" end="50091290000t" style="style0"><span style="style1">Saya tidak perlu berbohong.</span></p>
    <p xml:id="p1312" begin="50100460000t" end="50125490000t" style="style0"><span style="style1">Bagaimana lagi tuhan yang buta dan tidak berguna</span></p>
    <p xml:id="p1313" begin="50125490000t" end="50137590000t" style="style0"><span style="style1">minta awak tolong dia?</span></p>
    <p xml:id="p1314" begin="50156780000t" end="50170120000t" style="style0"><span style="style1">Teruskan.</span></p>
    <p xml:id="p1315" begin="50173040000t" end="50187220000t" style="style0"><span style="style1">Tanya dia.</span></p>
    <p xml:id="p1316" begin="50206410000t" end="50227260000t" style="style0"><span style="style1">-Tuangkan ke dalamnya. -Adakah ia benar?</span></p>
    <p xml:id="p1317" begin="50227260000t" end="50243940000t" style="style0"><span style="style1">Bek, tuangkan!</span></p>
    <p xml:id="p1318" begin="50258550000t" end="50270220000t" style="style0"><span style="style1">Tidak!</span></p>
    <p xml:id="p1319" begin="50277730000t" end="50290240000t" style="style0"><span style="style1">(SET GRUNTS)</span></p>
    <p xml:id="p1320" begin="50390750000t" end="50415780000t" style="style0"><span style="style1">Malu awak tidak berada di sisi saya.</span></p>
    <p xml:id="p1321" begin="50415780000t" end="50447070000t" style="style0"><span style="style1">itu tidak membiarkan kematian menghalangnya. Saya mengagumi seseorang</span></p>
    <p xml:id="p1322" begin="50447070000t" end="50478350000t" style="style0"><span style="style1">Tetapi inilah yang diberikan oleh cinta kepada anda.</span></p>
    <p xml:id="p1323" begin="50500860000t" end="50517550000t" style="style0"><span style="style1">Agak sesuai untuk anda berdua</span></p>
    <p xml:id="p1324" begin="50517550000t" end="50538830000t" style="style0"><span style="style1">mati bersama di sini di rumah saya.</span></p>
    <p xml:id="p1325" begin="50538830000t" end="50555920000t" style="style0"><span style="style1">Saya akan merindui perbualan.</span></p>
    <p xml:id="p1326" begin="50555920000t" end="50570520000t" style="style0"><span style="style1">Dan selebihnya.</span></p>
    <p xml:id="p1327" begin="50613900000t" end="50628080000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p1328" begin="50665200000t" end="50679800000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1329" begin="50851210000t" end="50863310000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1330" begin="50995950000t" end="51011790000t" style="style0"><span style="style1">(HORUS mendengus)</span></p>
    <p xml:id="p1331" begin="51031390000t" end="51045580000t" style="style0"><span style="style1">(BATUK)</span></p>
    <p xml:id="p1332" begin="51085200000t" end="51098130000t" style="style0"><span style="style1">(Hembus nafas berat)</span></p>
    <p xml:id="p1333" begin="51098130000t" end="51113140000t" style="style0"><span style="style1">Awak menolak dendam saya.</span></p>
    <p xml:id="p1334" begin="51113140000t" end="51131490000t" style="style0"><span style="style1">(TERHANGAT)</span></p>
    <p xml:id="p1335" begin="51131490000t" end="51146510000t" style="style0"><span style="style1">Zaya fikir awak</span></p>
    <p xml:id="p1336" begin="51146510000t" end="51156520000t" style="style0"><span style="style1">perkara yang paling hebat dalam semua ciptaan.</span></p>
    <p xml:id="p1337" begin="51171530000t" end="51187810000t" style="style0"><span style="style1">Setiap hari, dia berdoa untuk kamu menyelamatkan Mesir,</span></p>
    <p xml:id="p1338" begin="51187810000t" end="51199490000t" style="style0"><span style="style1">tapi awak tak datang.</span></p>
    <p xml:id="p1339" begin="51199490000t" end="51221580000t" style="style0"><span style="style1">Saya berada di dalam kubur. saya tak dengar.</span></p>
    <p xml:id="p1340" begin="51221580000t" end="51242020000t" style="style0"><span style="style1">Tidak, anda tidak mendengar.</span></p>
    <p xml:id="p1341" begin="51242020000t" end="51256210000t" style="style0"><span style="style1">adakah dendam bodoh awak. Semua yang anda ambil berat</span></p>
    <p xml:id="p1342" begin="51276230000t" end="51294160000t" style="style0"><span style="style1">Saya salah tentang awak. Saya mula berfikir</span></p>
    <p xml:id="p1343" begin="51311670000t" end="51326280000t" style="style0"><span style="style1">Tetapi saya akhirnya mendapat pengajaran daripada tuhan.</span></p>
    <p xml:id="p1344" begin="51326280000t" end="51341290000t" style="style0"><span style="style1">Kami tidak penting bagi anda.</span></p>
    <p xml:id="p1345" begin="51366320000t" end="51378410000t" style="style0"><span style="style1">Nah, sekarang anda tahu.</span></p>
    <p xml:id="p1346" begin="51556090000t" end="51569440000t" style="style0"><span style="style1">Anubis, keluar.</span></p>
    <p xml:id="p1347" begin="51620740000t" end="51634080000t" style="style0"><span style="style1">(SANGKUT)</span></p>
    <p xml:id="p1348" begin="51642000000t" end="51662020000t" style="style0"><span style="style1">perempuan simpanan.</span></p>
    <p xml:id="p1349" begin="51662020000t" end="51692050000t" style="style0"><span style="style1">seindah subuh pertama. Anda masih</span></p>
    <p xml:id="p1350" begin="51692050000t" end="51712070000t" style="style0"><span style="style1">Hathor, apa yang awak buat?</span></p>
    <p xml:id="p1351" begin="51712070000t" end="51742100000t" style="style0"><span style="style1">Kekasih manusia ini tidak membawa harta untuk timbangan.</span></p>
    <p xml:id="p1352" begin="51742100000t" end="51761300000t" style="style0"><span style="style1">Mungkin kita boleh tolong dia.</span></p>
    <p xml:id="p1353" begin="51761300000t" end="51786320000t" style="style0"><span style="style1">Anda bertanya banyak, Puan.</span></p>
    <p xml:id="p1354" begin="51786320000t" end="51822180000t" style="style0"><span style="style1">Ia sememangnya memerlukan harta yang sangat istimewa.</span></p>
    <p xml:id="p1355" begin="51822180000t" end="51836370000t" style="style0"><span style="style1">Tidak.</span></p>
    <p xml:id="p1356" begin="51836370000t" end="51853050000t" style="style0"><span style="style1">-Macam ini? -Tidak. Tidak!</span></p>
    <p xml:id="p1357" begin="51853050000t" end="51881000000t" style="style0"><span style="style1">Puan Barat? untuk awak,</span></p>
    <p xml:id="p1358" begin="51892250000t" end="51912270000t" style="style0"><span style="style1">ya.</span></p>
    <p xml:id="p1359" begin="51912270000t" end="51931880000t" style="style0"><span style="style1">untuk memberikannya sendiri. Berikan dia laluan</span></p>
    <p xml:id="p1360" begin="51964410000t" end="51979850000t" style="style0"><span style="style1">Anda akan melihatnya buat kali terakhir.</span></p>
    <p xml:id="p1361" begin="51986520000t" end="52001120000t" style="style0"><span style="style1">terima kasih.</span></p>
    <p xml:id="p1362" begin="52019050000t" end="52041160000t" style="style0"><span style="style1">Tidak, tidak, saya melarangnya.</span></p>
    <p xml:id="p1363" begin="52041160000t" end="52062420000t" style="style0"><span style="style1">Kami berdua bersalah kerana menipu Bek.</span></p>
    <p xml:id="p1364" begin="52062420000t" end="52076190000t" style="style0"><span style="style1">Ini akan membuat perubahan.</span></p>
    <p xml:id="p1365" begin="52076190000t" end="52111650000t" style="style0"><span style="style1">Bukan macam ni. Bukan dengan awak.</span></p>
    <p xml:id="p1366" begin="52111650000t" end="52136250000t" style="style0"><span style="style1">Saya perintahkan awak lepaskan saya.</span></p>
    <p xml:id="p1367" begin="52136250000t" end="52170040000t" style="style0"><span style="style1">Awak tak boleh perintah saya. Anda tahu mengapa.</span></p>
    <p xml:id="p1368" begin="52199230000t" end="52215910000t" style="style0"><span style="style1">Saya adalah Dewi Cinta.</span></p>
    <p xml:id="p1369" begin="52241360000t" end="52270970000t" style="style0"><span style="style1">Jika saya tidak melakukan ini, saya bukan apa-apa.</span></p>
    <p xml:id="p1370" begin="52270970000t" end="52292240000t" style="style0"><span style="style1">Saya tidak boleh kehilangan awak lagi.</span></p>
    <p xml:id="p1371" begin="52427380000t" end="52441560000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p1372" begin="52670960000t" end="52682630000t" style="style0"><span style="style1">Ambillah.</span></p>
    <p xml:id="p1373" begin="52795660000t" end="52812760000t" style="style0"><span style="style1">Lakukan apa yang perlu anda lakukan.</span></p>
    <p xml:id="p1374" begin="53003360000t" end="53017970000t" style="style0"><span style="style1">Dewan Dua Kebenaran.</span></p>
    <p xml:id="p1375" begin="53034230000t" end="53053000000t" style="style0"><span style="style1">Di mana kita akan dihakimi.</span></p>
    <p xml:id="p1376" begin="53079700000t" end="53098460000t" style="style0"><span style="style1">KETUA HAKIM: Melangkah ke hadapan.</span></p>
    <p xml:id="p1377" begin="53239440000t" end="53256120000t" style="style0"><span style="style1">Apa yang anda tawarkan?</span></p>
    <p xml:id="p1378" begin="53297830000t" end="53312430000t" style="style0"><span style="style1">(KLIK SKALA)</span></p>
    <p xml:id="p1379" begin="53336620000t" end="53351220000t" style="style0"><span style="style1">Langkah ke hadapan.</span></p>
    <p xml:id="p1380" begin="53393750000t" end="53433380000t" style="style0"><span style="style1">Saya akan hidup selama-lamanya!</span></p>
    <p xml:id="p1381" begin="53473010000t" end="53488440000t" style="style0"><span style="style1">KETUA HAKIM: Apa yang anda tawarkan?</span></p>
    <p xml:id="p1382" begin="53540990000t" end="53553500000t" style="style0"><span style="style1">(KLIK SKALA)</span></p>
    <p xml:id="p1383" begin="53586450000t" end="53613560000t" style="style0"><span style="style1">Langkah ke hadapan.</span></p>
    <p xml:id="p1384" begin="53718250000t" end="53732850000t" style="style0"><span style="style1">(MENJERIT)</span></p>
    <p xml:id="p1385" begin="53788740000t" end="53807500000t" style="style0"><span style="style1">Langkah ke hadapan.</span></p>
    <p xml:id="p1386" begin="53908020000t" end="53928880000t" style="style0"><span style="style1">Apa yang anda tawarkan?</span></p>
    <p xml:id="p1387" begin="53948060000t" end="53973910000t" style="style0"><span style="style1">Apa yang anda tawarkan?</span></p>
    <p xml:id="p1388" begin="54064420000t" end="54076940000t" style="style0"><span style="style1">Ia akan.</span></p>
    <p xml:id="p1389" begin="54084440000t" end="54099050000t" style="style0"><span style="style1">(TERKECAK LEMBUT) Bek.</span></p>
    <p xml:id="p1390" begin="54323860000t" end="54342210000t" style="style0"><span style="style1">(SET MENGERUM)</span></p>
    <p xml:id="p1391" begin="54363900000t" end="54383920000t" style="style0"><span style="style1">HAMBA: Set,</span></p>
    <p xml:id="p1392" begin="54383920000t" end="54416860000t" style="style0"><span style="style1">menerima sayap emas Nephthys.</span></p>
    <p xml:id="p1393" begin="54416860000t" end="54449400000t" style="style0"><span style="style1">daripada mereka yang akan membahayakan. Semoga mereka melindunginya</span></p>
    <p xml:id="p1394" begin="54538650000t" end="54552420000t" style="style0"><span style="style1">(Berdenting)</span></p>
    <p xml:id="p1395" begin="54576600000t" end="54614970000t" style="style0"><span style="style1">HAMBA: The karr of Thoth, Tuhan Kebijaksanaan.</span></p>
    <p xml:id="p1396" begin="54614970000t" end="54640420000t" style="style0"><span style="style1">Benarkan dia pengetahuan lama.</span></p>
    <p xml:id="p1397" begin="54659610000t" end="54671700000t" style="style0"><span style="style1">(ELEKTRIK KERETAK)</span></p>
    <p xml:id="p1398" begin="54699650000t" end="54723840000t" style="style0"><span style="style1">Hati Osiris.</span></p>
    <p xml:id="p1399" begin="54723840000t" end="54754290000t" style="style0"><span style="style1">Berikan dia kuasa atas semua Tanah.</span></p>
    <p xml:id="p1400" begin="54775130000t" end="54795150000t" style="style0"><span style="style1">Mata yang melihat segala-galanya.</span></p>
    <p xml:id="p1401" begin="54795150000t" end="54831860000t" style="style0"><span style="style1">Beri ganjaran kepadanya supaya tiada musuh yang boleh menipu.</span></p>
    <p xml:id="p1402" begin="54855210000t" end="54868560000t" style="style0"><span style="style1">(MENGERAM)</span></p>
    <p xml:id="p1403" begin="54944480000t" end="54956570000t" style="style0"><span style="style1">(SET GRUNTS)</span></p>
    <p xml:id="p1404" begin="54999950000t" end="55017880000t" style="style0"><span style="style1">Engkau kelihatan mulia, Tuhan.</span></p>
    <p xml:id="p1405" begin="55055830000t" end="55072940000t" style="style0"><span style="style1">saya tahu.</span></p>
    <p xml:id="p1406" begin="55273560000t" end="55285640000t" style="style0"><span style="style1">SET: Bapa...</span></p>
    <p xml:id="p1407" begin="55328190000t" end="55354050000t" style="style0"><span style="style1">Saya perhatikan menara itu. Mengagumkan.</span></p>
    <p xml:id="p1408" begin="55361560000t" end="55379910000t" style="style0"><span style="style1">Saya membinanya untuk awak.</span></p>
    <p xml:id="p1409" begin="55379910000t" end="55410770000t" style="style0"><span style="style1">Jika ia lebih tinggi, ia akan menghalang saya.</span></p>
    <p xml:id="p1410" begin="55410770000t" end="55442890000t" style="style0"><span style="style1">Alihkan mata anda dari layar anda</span></p>
    <p xml:id="p1411" begin="55442890000t" end="55455390000t" style="style0"><span style="style1">dan lihat semua yang saya lakukan.</span></p>
    <p xml:id="p1412" begin="55475830000t" end="55494190000t" style="style0"><span style="style1">Apa yang Osiris tidak pernah dapat.</span></p>
    <p xml:id="p1413" begin="55494190000t" end="55510460000t" style="style0"><span style="style1">Saya memerintah semua yang bernafas.</span></p>
    <p xml:id="p1414" begin="55522970000t" end="55538400000t" style="style0"><span style="style1">Dan semua yang dihembuskan.</span></p>
    <p xml:id="p1415" begin="55553000000t" end="55576350000t" style="style0"><span style="style1">Tiada yang lebih kuat di bawah matahari.</span></p>
    <p xml:id="p1416" begin="55576350000t" end="55612230000t" style="style0"><span style="style1">kerana saya telah menghormati anda. Kemudian muliakan saya</span></p>
    <p xml:id="p1417" begin="55612230000t" end="55626820000t" style="style0"><span style="style1">Jika kehormatan adalah niatmu,</span></p>
    <p xml:id="p1418" begin="55626820000t" end="55656850000t" style="style0"><span style="style1">daripada membunuh saudaramu. anda mungkin telah berpantang</span></p>
    <p xml:id="p1419" begin="55656850000t" end="55687710000t" style="style0"><span style="style1">segalanya di bawah sana. Jadi anda nampak</span></p>
    <p xml:id="p1420" begin="55687710000t" end="55721080000t" style="style0"><span style="style1">adakah anda peduli apa yang berlaku? Beritahu saya, Bapa,</span></p>
    <p xml:id="p1421" begin="55742360000t" end="55774890000t" style="style0"><span style="style1">Saya mengambil berat lebih daripada yang anda tahu.</span></p>
    <p xml:id="p1422" begin="55774890000t" end="55792820000t" style="style0"><span style="style1">Saya membuang seorang diri Kemudian mengapa</span></p>
    <p xml:id="p1423" begin="55809920000t" end="55830360000t" style="style0"><span style="style1">berjalan di atas pasir yang terbakar (BERBISIK)</span></p>
    <p xml:id="p1424" begin="55844130000t" end="55874570000t" style="style0"><span style="style1">manakala abang saya bermain berkaki ayam</span></p>
    <p xml:id="p1425" begin="55874570000t" end="55889170000t" style="style0"><span style="style1">di tepi sungai Nil?</span></p>
    <p xml:id="p1426" begin="55916270000t" end="55938380000t" style="style0"><span style="style1">Kenapa awak jadikan Osiris King?</span></p>
    <p xml:id="p1427" begin="55938380000t" end="55973000000t" style="style0"><span style="style1">Dan mengapa kamu memberinya seorang anak lelaki?</span></p>
    <p xml:id="p1428" begin="55973000000t" end="56000950000t" style="style0"><span style="style1">peluang untuk memberi kehidupan. Namun anda menafikan saya</span></p>
    <p xml:id="p1429" begin="56000950000t" end="56023050000t" style="style0"><span style="style1">Ini adalah ujian anda.</span></p>
    <p xml:id="p1430" begin="56023050000t" end="56036810000t" style="style0"><span style="style1">Awak tak uji dia.</span></p>
    <p xml:id="p1431" begin="56036810000t" end="56057670000t" style="style0"><span style="style1">mahkota Mesir. Saya memberi Osiris</span></p>
    <p xml:id="p1432" begin="56072270000t" end="56116470000t" style="style0"><span style="style1">dia tidak berpegang pada kuasanya. Dan apabila tiba masanya,</span></p>
    <p xml:id="p1433" begin="56116470000t" end="56160270000t" style="style0"><span style="style1">Dia memberikannya secara percuma. Dia lulus ujiannya.</span></p>
    <p xml:id="p1434" begin="56160270000t" end="56176950000t" style="style0"><span style="style1">Saya telah melepasi saya. Dan saya akan bertaruh</span></p>
    <p xml:id="p1435" begin="56176950000t" end="56194060000t" style="style0"><span style="style1">belum lagi.</span></p>
    <p xml:id="p1436" begin="56199480000t" end="56219080000t" style="style0"><span style="style1">memang betul...</span></p>
    <p xml:id="p1437" begin="56219080000t" end="56237850000t" style="style0"><span style="style1">Saya tidak mahu anda mempunyai anak.</span></p>
    <p xml:id="p1438" begin="56246600000t" end="56266620000t" style="style0"><span style="style1">Ini adalah kebaikan,</span></p>
    <p xml:id="p1439" begin="56266620000t" end="56285820000t" style="style0"><span style="style1">kerana saya tidak mahu awak merindui mereka</span></p>
    <p xml:id="p1440" begin="56285820000t" end="56299580000t" style="style0"><span style="style1">seteruk yang saya ada.</span></p>
    <p xml:id="p1441" begin="56299580000t" end="56313760000t" style="style0"><span style="style1">Rindu mereka?</span></p>
    <p xml:id="p1442" begin="56326680000t" end="56342120000t" style="style0"><span style="style1">untuk mengambil tempat saya. saya perlukan awak</span></p>
    <p xml:id="p1443" begin="56366720000t" end="56379660000t" style="style0"><span style="style1">Di sini?</span></p>
    <p xml:id="p1444" begin="56379660000t" end="56406760000t" style="style0"><span style="style1">ujian berakhir, anakku. Beginilah cara anda</span></p>
    <p xml:id="p1445" begin="56406760000t" end="56426360000t" style="style0"><span style="style1">Tidak ada beban yang lebih besar.</span></p>
    <p xml:id="p1446" begin="56451400000t" end="56464330000t" style="style0"><span style="style1">Tetapi tiada penghormatan yang lebih besar.</span></p>
    <p xml:id="p1447" begin="56496850000t" end="56525640000t" style="style0"><span style="style1">Semua yang telah anda lakukan boleh dimaafkan.</span></p>
    <p xml:id="p1448" begin="56586940000t" end="56632410000t" style="style0"><span style="style1">Anda mengharapkan saya untuk bertanding dengan binatang ini</span></p>
    <p xml:id="p1449" begin="56645760000t" end="56685380000t" style="style0"><span style="style1">malam demi malam sehingga saya mati?</span></p>
    <p xml:id="p1450" begin="56685380000t" end="56701230000t" style="style0"><span style="style1">apa yang awak nak?</span></p>
    <p xml:id="p1451" begin="56707060000t" end="56725010000t" style="style0"><span style="style1">Keabadian.</span></p>
    <p xml:id="p1452" begin="56725010000t" end="56757110000t" style="style0"><span style="style1">Keabadian menanti kita semua di Akhirat.</span></p>
    <p xml:id="p1453" begin="56757110000t" end="56789230000t" style="style0"><span style="style1">Saya tidak mahu mati. Saya mahu hidup.</span></p>
    <p xml:id="p1454" begin="56789230000t" end="56805090000t" style="style0"><span style="style1">Selamanya.</span></p>
    <p xml:id="p1455" begin="56805090000t" end="56827180000t" style="style0"><span style="style1">di negeri yang aku takluki. Di bawah sana</span></p>
    <p xml:id="p1456" begin="56827180000t" end="56837190000t" style="style0"><span style="style1">kerajaan saya.</span></p>
    <p xml:id="p1457" begin="56837190000t" end="56860970000t" style="style0"><span style="style1">Ini sepatutnya menjadi ganjaran saya.</span></p>
    <p xml:id="p1458" begin="56860970000t" end="56896010000t" style="style0"><span style="style1">Bagaimana? Satu-satunya cara untuk mencapai ini tidak dapat difikirkan.</span></p>
    <p xml:id="p1459" begin="56896010000t" end="56912270000t" style="style0"><span style="style1">Seseorang perlu memakan...</span></p>
    <p xml:id="p1460" begin="56912270000t" end="56931040000t" style="style0"><span style="style1">Akhirat itu sendiri.</span></p>
    <p xml:id="p1461" begin="56931040000t" end="56956490000t" style="style0"><span style="style1">Anda akan melepaskan Huru-hara semasa penciptaan?</span></p>
    <p xml:id="p1462" begin="56956490000t" end="56977330000t" style="style0"><span style="style1">Anda akan memusnahkan segala-galanya?</span></p>
    <p xml:id="p1463" begin="56977330000t" end="57006540000t" style="style0"><span style="style1">Bukan memusnahkan. Bentuk semula.</span></p>
    <p xml:id="p1464" begin="57006540000t" end="57030310000t" style="style0"><span style="style1">Saya akan ambil tempat awak.</span></p>
    <p xml:id="p1465" begin="57030310000t" end="57050740000t" style="style0"><span style="style1">Tetapi ia tidak akan duduk di atas bot sialan.</span></p>
    <p xml:id="p1466" begin="57227580000t" end="57242600000t" style="style0"><span style="style1">(SET PERNAFASAN BERAT)</span></p>
    <p xml:id="p1467" begin="57296830000t" end="57311840000t" style="style0"><span style="style1">tahan itu. Tiada tuhan boleh</span></p>
    <p xml:id="p1468" begin="57327680000t" end="57348120000t" style="style0"><span style="style1">Saya bukan hanya satu tuhan.</span></p>
    <p xml:id="p1469" begin="57360640000t" end="57374820000t" style="style0"><span style="style1">(TERGAS)</span></p>
    <p xml:id="p1470" begin="57715160000t" end="57742270000t" style="style0"><span style="style1">KETUA HAKIM: Apa yang anda tawarkan?</span></p>
    <p xml:id="p1471" begin="57742270000t" end="57764790000t" style="style0"><span style="style1">tempat di Akhirat. Ini akan membeli anda</span></p>
    <p xml:id="p1472" begin="57764790000t" end="57777710000t" style="style0"><span style="style1">ZAYA: Tidak.</span></p>
    <p xml:id="p1473" begin="57787320000t" end="57799410000t" style="style0"><span style="style1">Bukan tanpa awak.</span></p>
    <p xml:id="p1474" begin="57826520000t" end="57838190000t" style="style0"><span style="style1">(GEMPAR)</span></p>
    <p xml:id="p1475" begin="57884910000t" end="57903260000t" style="style0"><span style="style1">(JIWA MENJERIT)</span></p>
    <p xml:id="p1476" begin="57903260000t" end="57927460000t" style="style0"><span style="style1">Pintu pagar telah rosak!</span></p>
    <p xml:id="p1477" begin="57927460000t" end="57948300000t" style="style0"><span style="style1">Kekacauan merebak.</span></p>
    <p xml:id="p1478" begin="57948300000t" end="57962490000t" style="style0"><span style="style1">musnahkan tanah ini. Apophis hendaklah</span></p>
    <p xml:id="p1479" begin="58014210000t" end="58027960000t" style="style0"><span style="style1">(APOPHIS MENGERENG)</span></p>
    <p xml:id="p1480" begin="58076360000t" end="58098450000t" style="style0"><span style="style1">hanya harapan sekarang. Horus adalah kami</span></p>
    <p xml:id="p1481" begin="58098450000t" end="58111390000t" style="style0"><span style="style1">anda fikir dia, Zaya. Dia bukan tuhan</span></p>
    <p xml:id="p1482" begin="58111390000t" end="58127240000t" style="style0"><span style="style1">Dia tipu saya.</span></p>
    <p xml:id="p1483" begin="58127240000t" end="58145170000t" style="style0"><span style="style1">Beri dia peluang lagi.</span></p>
    <p xml:id="p1484" begin="58145170000t" end="58165610000t" style="style0"><span style="style1">Dia hanya sampai sejauh ini kerana awak.</span></p>
    <p xml:id="p1485" begin="58165610000t" end="58184380000t" style="style0"><span style="style1">Kekuatan saya tidak terhingga.</span></p>
    <p xml:id="p1486" begin="58184380000t" end="58216910000t" style="style0"><span style="style1">mempunyai apa-apa rancangan untuk membetulkan perkara ini, If the Lord of the Air</span></p>
    <p xml:id="p1487" begin="58216910000t" end="58238590000t" style="style0"><span style="style1">dia harus berbuat demikian dengan tergesa-gesa.</span></p>
    <p xml:id="p1488" begin="58238590000t" end="58267800000t" style="style0"><span style="style1">Kalau awak tak percaya dia, percayalah saya.</span></p>
    <p xml:id="p1489" begin="58267800000t" end="58279890000t" style="style0"><span style="style1">Saya tahu kita akan bersama lagi.</span></p>
    <p xml:id="p1490" begin="58400420000t" end="58415030000t" style="style0"><span style="style1">HORUS: Ra telah jatuh.</span></p>
    <p xml:id="p1491" begin="58415030000t" end="58433380000t" style="style0"><span style="style1">Set telah melancarkan Chaos.</span></p>
    <p xml:id="p1492" begin="58433380000t" end="58448380000t" style="style0"><span style="style1">Jadi bagaimana kita menghalangnya?</span></p>
    <p xml:id="p1493" begin="58469240000t" end="58488840000t" style="style0"><span style="style1">Anda tidak pernah berputus asa, bukan?</span></p>
    <p xml:id="p1494" begin="58488840000t" end="58504280000t" style="style0"><span style="style1">Zaya suruh aku jangan. Hanya kerana</span></p>
    <p xml:id="p1495" begin="58509280000t" end="58525550000t" style="style0"><span style="style1">tentang tawaran kami? Awak tak beritahu dia</span></p>
    <p xml:id="p1496" begin="58525550000t" end="58539310000t" style="style0"><span style="style1">Ya, saya memberitahunya.</span></p>
    <p xml:id="p1497" begin="58539310000t" end="58555580000t" style="style0"><span style="style1">dia masih percaya pada awak. Tetapi atas sebab tertentu,</span></p>
    <p xml:id="p1498" begin="58576020000t" end="58588520000t" style="style0"><span style="style1">Kita mesti kembali ke ibu kota.</span></p>
    <p xml:id="p1499" begin="58598950000t" end="58613970000t" style="style0"><span style="style1">Kemudian kita perlu berjalan jauh di hadapan kita.</span></p>
    <p xml:id="p1500" begin="58625650000t" end="58641920000t" style="style0"><span style="style1">(BURUNG BERKICANG)</span></p>
    <p xml:id="p1501" begin="58641920000t" end="58656520000t" style="style0"><span style="style1">Saya lebih suka terbang.</span></p>
    <p xml:id="p1502" begin="58693220000t" end="58704480000t" style="style0"><span style="style1">Nephthys.</span></p>
    <p xml:id="p1503" begin="58709060000t" end="58731170000t" style="style0"><span style="style1">dia cuba membantu kita. Walaupun selepas kematian,</span></p>
    <p xml:id="p1504" begin="58785400000t" end="58796660000t" style="style0"><span style="style1">(GEMPAR)</span></p>
    <p xml:id="p1505" begin="58903850000t" end="58918850000t" style="style0"><span style="style1">Datang, syaitan!</span></p>
    <p xml:id="p1506" begin="59008120000t" end="59020210000t" style="style0"><span style="style1">(MENGERAM)</span></p>
    <p xml:id="p1507" begin="59189540000t" end="59211230000t" style="style0"><span style="style1">HORUS: Set mempunyai lembing Ra.</span></p>
    <p xml:id="p1508" begin="59211230000t" end="59227510000t" style="style0"><span style="style1">Dia menarik Apophis ke Sungai Nil,</span></p>
    <p xml:id="p1509" begin="59227510000t" end="59235430000t" style="style0"><span style="style1">kepada sumber segala kehidupan.</span></p>
    <p xml:id="p1510" begin="59235430000t" end="59253360000t" style="style0"><span style="style1">kenapa?</span></p>
    <p xml:id="p1511" begin="59253360000t" end="59289640000t" style="style0"><span style="style1">Untuk memusnahkan semua ciptaan. Untuk meminumnya.</span></p>
    <p xml:id="p1512" begin="59289640000t" end="59309660000t" style="style0"><span style="style1">Ra belum mati. Dan hanya dia yang boleh membuat ini betul.</span></p>
    <p xml:id="p1513" begin="59309660000t" end="59329680000t" style="style0"><span style="style1">Tetapi dia memerlukan lembingnya.</span></p>
    <p xml:id="p1514" begin="59329680000t" end="59342200000t" style="style0"><span style="style1">Jadi bagaimana kita mendapatkannya kembali?</span></p>
    <p xml:id="p1515" begin="59351370000t" end="59369300000t" style="style0"><span style="style1">Mungkin sudah tiba masanya kita pergi memancing.</span></p>
    <p xml:id="p1516" begin="59438130000t" end="59459810000t" style="style0"><span style="style1">(URSHU SOLAT SECARA TAK SENTIASA)</span></p>
    <p xml:id="p1517" begin="59459810000t" end="59486930000t" style="style0"><span style="style1">Saya datang dalam perkhidmatan anda, saya meminta bantuan anda.</span></p>
    <p xml:id="p1518" begin="59486930000t" end="59499030000t" style="style0"><span style="style1">HORUS: Pembina. (TERGAS)</span></p>
    <p xml:id="p1519" begin="59518210000t" end="59532810000t" style="style0"><span style="style1">Kami memerlukan anda.</span></p>
    <p xml:id="p1520" begin="59532810000t" end="59549480000t" style="style0"><span style="style1">(GEMPAR)</span></p>
    <p xml:id="p1521" begin="59579930000t" end="59593280000t" style="style0"><span style="style1">(ASKAR MENJERIT)</span></p>
    <p xml:id="p1522" begin="59720070000t" end="59749280000t" style="style0"><span style="style1">Ia adalah satu-satunya pencapaian seni bina terbesar</span></p>
    <p xml:id="p1523" begin="59749280000t" end="59766380000t" style="style0"><span style="style1">dan akan menjadi. yang pernah ada</span></p>
    <p xml:id="p1524" begin="59775970000t" end="59789720000t" style="style0"><span style="style1">saya...</span></p>
    <p xml:id="p1525" begin="59800150000t" end="59840190000t" style="style0"><span style="style1">Obelisk Lord Set yang saya maksudkan,</span></p>
    <p xml:id="p1526" begin="59840190000t" end="59886910000t" style="style0"><span style="style1">2,220 hasta tinggi. berdiri dengan tepat</span></p>
    <p xml:id="p1527" begin="59886910000t" end="59901920000t" style="style0"><span style="style1">Dan bukan sebatang batang.</span></p>
    <p xml:id="p1528" begin="59901920000t" end="59924030000t" style="style0"><span style="style1">Dibina daripada tujuh bilion blok granit,</span></p>
    <p xml:id="p1529" begin="59924030000t" end="59952810000t" style="style0"><span style="style1">lima bilion papak batu kapur Tura,</span></p>
    <p xml:id="p1530" begin="59952810000t" end="59980330000t" style="style0"><span style="style1">dan sembilan bilion talenta emas.</span></p>
    <p xml:id="p1531" begin="59980330000t" end="59994940000t" style="style0"><span style="style1">daripada berapa ramai hamba? Dan nyawa</span></p>
    <p xml:id="p1532" begin="60006620000t" end="60044150000t" style="style0"><span style="style1">5,930.</span></p>
    <p xml:id="p1533" begin="60044150000t" end="60057920000t" style="style0"><span style="style1">Tidak, tunggu.</span></p>
    <p xml:id="p1534" begin="60068350000t" end="60107550000t" style="style0"><span style="style1">Jadikan itu 5,931.</span></p>
    <p xml:id="p1535" begin="60107550000t" end="60124650000t" style="style0"><span style="style1">jangan! Anda memerlukan dia untuk pergi ke bumbung.</span></p>
    <p xml:id="p1536" begin="60157600000t" end="60170100000t" style="style0"><span style="style1">HORUS: Saya akan jumpa awak di atas.</span></p>
    <p xml:id="p1537" begin="60230580000t" end="60247690000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1538" begin="60466660000t" end="60490420000t" style="style0"><span style="style1">seolah-olah dia kawan awak. Awak berdiri di sebelah dia</span></p>
    <p xml:id="p1539" begin="60500850000t" end="60515460000t" style="style0"><span style="style1">bagaimana rasanya. Oh, saya tahu</span></p>
    <p xml:id="p1540" begin="60515460000t" end="60534640000t" style="style0"><span style="style1">Nikmat tuhan.</span></p>
    <p xml:id="p1541" begin="60534640000t" end="60554660000t" style="style0"><span style="style1">Ia memabukkan.</span></p>
    <p xml:id="p1542" begin="60554660000t" end="60580930000t" style="style0"><span style="style1">salah nak ikut. Saya minta maaf anda memilih</span></p>
    <p xml:id="p1543" begin="60580930000t" end="60593870000t" style="style0"><span style="style1">Dia bertambah baik.</span></p>
    <p xml:id="p1544" begin="60593870000t" end="60617640000t" style="style0"><span style="style1">Wanita anda masih mati, bukan?</span></p>
    <p xml:id="p1545" begin="60617640000t" end="60651000000t" style="style0"><span style="style1">Gadis yang begitu cantik. malu.</span></p>
    <p xml:id="p1546" begin="60651000000t" end="60661010000t" style="style0"><span style="style1">Hmm...</span></p>
    <p xml:id="p1547" begin="60661010000t" end="60681450000t" style="style0"><span style="style1">Kulit lembut yang begitu indah.</span></p>
    <p xml:id="p1548" begin="60681450000t" end="60703980000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p1549" begin="60726920000t" end="60746100000t" style="style0"><span style="style1">Kekayaan Dunia Akhirat.</span></p>
    <p xml:id="p1550" begin="60746100000t" end="60761110000t" style="style0"><span style="style1">(BEK BATUK)</span></p>
    <p xml:id="p1551" begin="60761110000t" end="60779470000t" style="style0"><span style="style1">Awak nampak? Saya bersedia untuk mati.</span></p>
    <p xml:id="p1552" begin="60849960000t" end="60862050000t" style="style0"><span style="style1">(KEDUA-DUA MENGERENG)</span></p>
    <p xml:id="p1553" begin="60971320000t" end="60985930000t" style="style0"><span style="style1">(APOPHIS MENGGEMPAR)</span></p>
    <p xml:id="p1554" begin="61093110000t" end="61108130000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1555" begin="61186130000t" end="61201130000t" style="style0"><span style="style1">(METALLIC RATTLE)</span></p>
    <p xml:id="p1556" begin="61292480000t" end="61320430000t" style="style0"><span style="style1">SET: Mari, Apophis!</span></p>
    <p xml:id="p1557" begin="61410520000t" end="61423030000t" style="style0"><span style="style1">(GEMPAR)</span></p>
    <p xml:id="p1558" begin="61473490000t" end="61490600000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p1559" begin="61574430000t" end="61596950000t" style="style0"><span style="style1">tinggal di bawah pasir. Anda sepatutnya mempunyai</span></p>
    <p xml:id="p1560" begin="61596950000t" end="61611960000t" style="style0"><span style="style1">membunuh untuk mahkota, saya boleh faham</span></p>
    <p xml:id="p1561" begin="61611960000t" end="61628240000t" style="style0"><span style="style1">tetapi ini adalah kegilaan.</span></p>
    <p xml:id="p1562" begin="61628240000t" end="61644920000t" style="style0"><span style="style1">awak tak faham. Sudah tentu</span></p>
    <p xml:id="p1563" begin="61644920000t" end="61660350000t" style="style0"><span style="style1">Bagaimana anda boleh?</span></p>
    <p xml:id="p1564" begin="61660350000t" end="61675360000t" style="style0"><span style="style1">daripada anak lelaki yang disayangi. Anak kesayangan</span></p>
    <p xml:id="p1565" begin="61729170000t" end="61741670000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p1566" begin="62039480000t" end="62051980000t" style="style0"><span style="style1">(BEK MENJERONG)</span></p>
    <p xml:id="p1567" begin="62139160000t" end="62152500000t" style="style0"><span style="style1">(MENGKEK)</span></p>
    <p xml:id="p1568" begin="62152500000t" end="62169610000t" style="style0"><span style="style1">By the way,</span></p>
    <p xml:id="p1569" begin="62169610000t" end="62190470000t" style="style0"><span style="style1">Apophis akan makan Tanah Orang Mati.</span></p>
    <p xml:id="p1570" begin="62190470000t" end="62204640000t" style="style0"><span style="style1">Anda tidak akan pernah sampai ke Akhirat sekarang.</span></p>
    <p xml:id="p1571" begin="62204640000t" end="62219240000t" style="style0"><span style="style1">(TEREKUT) Apa?</span></p>
    <p xml:id="p1572" begin="62248860000t" end="62262190000t" style="style0"><span style="style1">(JERENG)</span></p>
    <p xml:id="p1573" begin="62294730000t" end="62313920000t" style="style0"><span style="style1">Siapa yang salah pilih tuhan sekarang?</span></p>
    <p xml:id="p1574" begin="62444880000t" end="62459070000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p1575" begin="62572920000t" end="62587110000t" style="style0"><span style="style1">(KEDUA-DUA MENDERENG)</span></p>
    <p xml:id="p1576" begin="62630910000t" end="62663010000t" style="style0"><span style="style1">Saya fikir saya mungkin sebenarnya merindui pertemuan kecil kami.</span></p>
    <p xml:id="p1577" begin="62672200000t" end="62683870000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p1578" begin="62713480000t" end="62735590000t" style="style0"><span style="style1">Tetapi awak masih tiada tandingan untuk saya.</span></p>
    <p xml:id="p1579" begin="62746850000t" end="62761870000t" style="style0"><span style="style1">awak betul.</span></p>
    <p xml:id="p1580" begin="62777300000t" end="62792320000t" style="style0"><span style="style1">Saya hanya umpan.</span></p>
    <p xml:id="p1581" begin="62850290000t" end="62862790000t" style="style0"><span style="style1">Sekarang anda hanya menjadi perosak.</span></p>
    <p xml:id="p1582" begin="62876150000t" end="62890750000t" style="style0"><span style="style1">(SET GRUNTS)</span></p>
    <p xml:id="p1583" begin="62895750000t" end="62910350000t" style="style0"><span style="style1">(BEK SERU)</span></p>
    <p xml:id="p1584" begin="62962070000t" end="62974160000t" style="style0"><span style="style1">(TANAH BEK)</span></p>
    <p xml:id="p1585" begin="62992520000t" end="63004190000t" style="style0"><span style="style1">(MENGERUNG)</span></p>
    <p xml:id="p1586" begin="63046320000t" end="63063830000t" style="style0"><span style="style1">Horus!</span></p>
    <p xml:id="p1587" begin="63283630000t" end="63294900000t" style="style0"><span style="style1">(JERENG)</span></p>
    <p xml:id="p1588" begin="63345360000t" end="63359970000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1589" begin="63404170000t" end="63421280000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1590" begin="63485500000t" end="63503030000t" style="style0"><span style="style1">Anda tidak fikir mata anda mungkin</span></p>
    <p xml:id="p1591" begin="63503030000t" end="63516790000t" style="style0"><span style="style1">daripada pencuri yang cedera? lebih berguna</span></p>
    <p xml:id="p1592" begin="63516790000t" end="63531390000t" style="style0"><span style="style1">Mungkin, ya.</span></p>
    <p xml:id="p1593" begin="63553900000t" end="63573500000t" style="style0"><span style="style1">Saya minta maaf atas semua yang saya lakukan pada awak.</span></p>
    <p xml:id="p1594" begin="63576430000t" end="63593940000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1595" begin="63593940000t" end="63606880000t" style="style0"><span style="style1">Termasuk ini.</span></p>
    <p xml:id="p1596" begin="63606880000t" end="63621060000t" style="style0"><span style="style1">Diterima.</span></p>
    <p xml:id="p1597" begin="63917190000t" end="63953060000t" style="style0"><span style="style1">Saya akan curi mata awak yang sebelah lagi. (KECEWA) Saya dah cakap</span></p>
    <p xml:id="p1598" begin="63953060000t" end="63965150000t" style="style0"><span style="style1">menyelamatkan saya beberapa masalah Tetapi anda boleh mempunyai</span></p>
    <p xml:id="p1599" begin="63965150000t" end="63978920000t" style="style0"><span style="style1">anda tidak memerlukannya. dan memberitahu saya</span></p>
    <p xml:id="p1600" begin="63978920000t" end="63999350000t" style="style0"><span style="style1">Ra menunjukkan saya jalan,</span></p>
    <p xml:id="p1601" begin="63999350000t" end="64015200000t" style="style0"><span style="style1">tetapi saya tidak mendengar.</span></p>
    <p xml:id="p1602" begin="64015200000t" end="64040230000t" style="style0"><span style="style1">Saya percaya saya memerlukan mata saya untuk berubah,</span></p>
    <p xml:id="p1603" begin="64040230000t" end="64067340000t" style="style0"><span style="style1">tetapi perjalanan saya bukan untuk membalas dendam pada semua kos.</span></p>
    <p xml:id="p1604" begin="64081100000t" end="64096950000t" style="style0"><span style="style1">Ia adalah untuk melindungi rakyat saya.</span></p>
    <p xml:id="p1605" begin="64108210000t" end="64133660000t" style="style0"><span style="style1">Berhenti mengucapkan tahniah kepada diri sendiri.</span></p>
    <p xml:id="p1606" begin="64133660000t" end="64144490000t" style="style0"><span style="style1">melindungi untuk dilakukan. Anda ada lebih</span></p>
    <p xml:id="p1607" begin="64281300000t" end="64294220000t" style="style0"><span style="style1">(MERENGANG LEMBUT)</span></p>
    <p xml:id="p1608" begin="64398920000t" end="64413940000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p1609" begin="64789310000t" end="64803910000t" style="style0"><span style="style1">(SET MERENGUS)</span></p>
    <p xml:id="p1610" begin="64861050000t" end="64874800000t" style="style0"><span style="style1">(SET MENGERANG)</span></p>
    <p xml:id="p1611" begin="64925690000t" end="64937790000t" style="style0"><span style="style1">(MENJERIT)</span></p>
    <p xml:id="p1612" begin="64985750000t" end="65002860000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1613" begin="65095440000t" end="65105450000t" style="style0"><span style="style1">(APOPHIS MENGGEMPAR)</span></p>
    <p xml:id="p1614" begin="65105450000t" end="65120470000t" style="style0"><span style="style1">(ASKAR MENJERIT)</span></p>
    <p xml:id="p1615" begin="65350700000t" end="65366970000t" style="style0"><span style="style1">(MERENGANG LEMBUT)</span></p>
    <p xml:id="p1616" begin="65495840000t" end="65511280000t" style="style0"><span style="style1">(BATUK)</span></p>
    <p xml:id="p1617" begin="65540480000t" end="65555480000t" style="style0"><span style="style1">(BERNAFAS BERAT)</span></p>
    <p xml:id="p1618" begin="65583860000t" end="65625550000t" style="style0"><span style="style1">Lihatlah, Raja yang baru.</span></p>
    <p xml:id="p1619" begin="65645990000t" end="65671020000t" style="style0"><span style="style1">yang paling agung dari segala tuhan. Saya fikir anda adalah</span></p>
    <p xml:id="p1620" begin="65671020000t" end="65691880000t" style="style0"><span style="style1">Sekarang tengok awak. (Merengus)</span></p>
    <p xml:id="p1621" begin="65691880000t" end="65711900000t" style="style0"><span style="style1">Anda tidak mempunyai apa-apa.</span></p>
    <p xml:id="p1622" begin="65711900000t" end="65735660000t" style="style0"><span style="style1">Saya adalah tuhan yang paling hebat.</span></p>
    <p xml:id="p1623" begin="65746090000t" end="65759440000t" style="style0"><span style="style1">Saya selamatkan awak sekali.</span></p>
    <p xml:id="p1624" begin="65766530000t" end="65776120000t" style="style0"><span style="style1">Hah?</span></p>
    <p xml:id="p1625" begin="65776120000t" end="65797810000t" style="style0"><span style="style1">Saya menunjukkan belas kasihan kepada anda.</span></p>
    <p xml:id="p1626" begin="65797810000t" end="65814500000t" style="style0"><span style="style1">Saya tidak akan melakukan kesilapan itu.</span></p>
    <p xml:id="p1627" begin="65822840000t" end="65835760000t" style="style0"><span style="style1">(Merengus)</span></p>
    <p xml:id="p1628" begin="65999270000t" end="66019700000t" style="style0"><span style="style1">HORUS: Atuk, masih ada masa.</span></p>
    <p xml:id="p1629" begin="66071420000t" end="66086010000t" style="style0"><span style="style1">Cukuplah, binatang!</span></p>
    <p xml:id="p1630" begin="66146490000t" end="66161100000t" style="style0"><span style="style1">(APOPHIS MENGERUNG)</span></p>
    <p xml:id="p1631" begin="66347110000t" end="66364220000t" style="style0"><span style="style1">(Mengeluh)</span></p>
    <p xml:id="p1632" begin="66870140000t" end="66884320000t" style="style0"><span style="style1">terima kasih.</span></p>
    <p xml:id="p1633" begin="66925200000t" end="66940620000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p1634" begin="66947290000t" end="66960230000t" style="style0"><span style="style1">(TEPUK)</span></p>
    <p xml:id="p1635" begin="66985670000t" end="67004440000t" style="style0"><span style="style1">HORUS: Kami membentuk pasukan yang baik.</span></p>
    <p xml:id="p1636" begin="67004440000t" end="67025710000t" style="style0"><span style="style1">awak bukan tuhan? Adakah anda pasti</span></p>
    <p xml:id="p1637" begin="67025710000t" end="67047390000t" style="style0"><span style="style1">Apa yang saya akan menjadi tuhan?</span></p>
    <p xml:id="p1638" begin="67047390000t" end="67063250000t" style="style0"><span style="style1">(Hembus nafas berat)</span></p>
    <p xml:id="p1639" begin="67063250000t" end="67077000000t" style="style0"><span style="style1">Kebodohan?</span></p>
    <p xml:id="p1640" begin="67092030000t" end="67106630000t" style="style0"><span style="style1">Yang Mustahil.</span></p>
    <p xml:id="p1641" begin="67150420000t" end="67164600000t" style="style0"><span style="style1">pertahanan?</span></p>
    <p xml:id="p1642" begin="67701800000t" end="67720570000t" style="style0"><span style="style1">Saya tidak pernah berhutang.</span></p>
    <p xml:id="p1643" begin="67720570000t" end="67743090000t" style="style0"><span style="style1">Namun saya berhutang dengan awak, cucu.</span></p>
    <p xml:id="p1644" begin="67753940000t" end="67778120000t" style="style0"><span style="style1">Tanya apa sahaja yang anda mahu.</span></p>
    <p xml:id="p1645" begin="67778120000t" end="67801900000t" style="style0"><span style="style1">Gunung akan berlutut di hadapan anda.</span></p>
    <p xml:id="p1646" begin="67801900000t" end="67818160000t" style="style0"><span style="style1">akan melakukan tawaran anda. Angin</span></p>
    <p xml:id="p1647" begin="67818160000t" end="67843190000t" style="style0"><span style="style1">kerana Apophis masih lapar. Jawab dengan cepat,</span></p>
    <p xml:id="p1648" begin="67856540000t" end="67875730000t" style="style0"><span style="style1">Dan malam sentiasa datang.</span></p>
    <p xml:id="p1649" begin="67917440000t" end="67929530000t" style="style0"><span style="style1">Saya tidak mahu apa-apa.</span></p>
    <p xml:id="p1650" begin="67949960000t" end="67967890000t" style="style0"><span style="style1">Kecuali apa yang mustahil untuk saya berikan.</span></p>
    <p xml:id="p1651" begin="68142240000t" end="68159760000t" style="style0"><span style="style1">(Tercungap-cungap)</span></p>
    <p xml:id="p1652" begin="68228990000t" end="68248590000t" style="style0"><span style="style1">adakah saya...</span></p>
    <p xml:id="p1653" begin="68248590000t" end="68269030000t" style="style0"><span style="style1">(KECEWA) Anda telah kembali. (KETAWA)</span></p>
    <p xml:id="p1654" begin="68269030000t" end="68287810000t" style="style0"><span style="style1">HORUS: Mulut?</span></p>
    <p xml:id="p1655" begin="68287810000t" end="68298640000t" style="style0"><span style="style1">nak tolong dia. Anda mungkin</span></p>
    <p xml:id="p1656" begin="68319500000t" end="68337440000t" style="style0"><span style="style1">Ia akan.</span></p>
    <p xml:id="p1657" begin="68364970000t" end="68378300000t" style="style0"><span style="style1">(ZAYA BERNAFAS BERAT)</span></p>
    <p xml:id="p1658" begin="68386660000t" end="68403340000t" style="style0"><span style="style1">(LEMBUT) Bek.</span></p>
    <p xml:id="p1659" begin="68403340000t" end="68417940000t" style="style0"><span style="style1">HORUS: Zaya?</span></p>
    <p xml:id="p1660" begin="68425030000t" end="68437120000t" style="style0"><span style="style1">Saya Horus.</span></p>
    <p xml:id="p1661" begin="68437120000t" end="68448790000t" style="style0"><span style="style1">Tuanku.</span></p>
    <p xml:id="p1662" begin="68448790000t" end="68463400000t" style="style0"><span style="style1">Saya fikir ini adalah mustahil.</span></p>
    <p xml:id="p1663" begin="68463400000t" end="68488410000t" style="style0"><span style="style1">Mustahil? ya.</span></p>
    <p xml:id="p1664" begin="68568910000t" end="68579760000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p1665" begin="68579760000t" end="68608530000t" style="style0"><span style="style1">ORANG RAMAI: Salam Ra, Tuan Cahaya!</span></p>
    <p xml:id="p1666" begin="68626060000t" end="68651500000t" style="style0"><span style="style1">Salam Ra, Tuhan Cahaya!</span></p>
    <p xml:id="p1667" begin="68679020000t" end="68704890000t" style="style0"><span style="style1">kebijaksanaan telah ditemui. ODER BEK: Dan sebagainya</span></p>
    <p xml:id="p1668" begin="68704890000t" end="68739080000t" style="style0"><span style="style1">Ujian telah dilalui. Peluang kedua diberi.</span></p>
    <p xml:id="p1669" begin="68739080000t" end="68756190000t" style="style0"><span style="style1">Untuk hidup semula.</span></p>
    <p xml:id="p1670" begin="68756190000t" end="68776210000t" style="style0"><span style="style1">Untuk kembali utuh.</span></p>
    <p xml:id="p1671" begin="68776210000t" end="68802070000t" style="style0"><span style="style1">Horus meratapi ibu bapanya.</span></p>
    <p xml:id="p1672" begin="68802070000t" end="68827930000t" style="style0"><span style="style1">Mereka telah lama berlalu ke Alam Akhirat.</span></p>
    <p xml:id="p1673" begin="68827930000t" end="68848370000t" style="style0"><span style="style1">itu adalah kebijaksanaan Ra Tetapi dia tahu</span></p>
    <p xml:id="p1674" begin="68848370000t" end="68881310000t" style="style0"><span style="style1">kekal seperti sediakala. bahawa Gerbang Akhir akan</span></p>
    <p xml:id="p1675" begin="68881310000t" end="68933030000t" style="style0"><span style="style1">Penghalang yang tidak dapat dipecahkan antara kehidupan ini dan keabadian.</span></p>
    <p xml:id="p1676" begin="68933030000t" end="68943880000t" style="style0"><span style="style1">Awak rasa saya sudah bersedia?</span></p>
    <p xml:id="p1677" begin="68943880000t" end="68969310000t" style="style0"><span style="style1">Hmm, kesediaan sebenar</span></p>
    <p xml:id="p1678" begin="68969310000t" end="69003520000t" style="style0"><span style="style1">adalah keadaan yang terkenal sukar dicapai.</span></p>
    <p xml:id="p1679" begin="69003520000t" end="69028960000t" style="style0"><span style="style1">-Tetapi awak cukup dekat. -Hmm.</span></p>
    <p xml:id="p1680" begin="69157430000t" end="69184530000t" style="style0"><span style="style1">Bangun, Horus...</span></p>
    <p xml:id="p1681" begin="69184530000t" end="69210810000t" style="style0"><span style="style1">Raja seluruh Mesir.</span></p>
    <p xml:id="p1682" begin="69255860000t" end="69269200000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p1683" begin="69305490000t" end="69330090000t" style="style0"><span style="style1">Mulai saat ini,</span></p>
    <p xml:id="p1684" begin="69330090000t" end="69352200000t" style="style0"><span style="style1">Akhirat mesti diperolehi, bukan dengan emas,</span></p>
    <p xml:id="p1685" begin="69368890000t" end="69397250000t" style="style0"><span style="style1">tetapi dengan perbuatan baik, belas kasihan,</span></p>
    <p xml:id="p1686" begin="69407680000t" end="69420600000t" style="style0"><span style="style1">dan kemurahan hati.</span></p>
    <p xml:id="p1687" begin="69429770000t" end="69468570000t" style="style0"><span style="style1">Apa yang kita lakukan, bagaimana kita bertindak dalam kehidupan ini penting.</span></p>
    <p xml:id="p1688" begin="69482750000t" end="69499430000t" style="style0"><span style="style1">(ORANG BERSORAK)</span></p>
    <p xml:id="p1689" begin="69543640000t" end="69558240000t" style="style0"><span style="style1">Adakah anda berfikir tentang dia?</span></p>
    <p xml:id="p1690" begin="69579920000t" end="69594940000t" style="style0"><span style="style1">Sudah tentu, anda.</span></p>
    <p xml:id="p1691" begin="69635820000t" end="69653330000t" style="style0"><span style="style1">Anda tidak fikir saya akan melesetkan khazanah terbesar Mesir?</span></p>
    <p xml:id="p1692" begin="69670430000t" end="69697970000t" style="style0"><span style="style1">jika saya pergi beberapa hari? Anda fikir mereka akan merindui saya</span></p>
    <p xml:id="p1693" begin="69697970000t" end="69720060000t" style="style0"><span style="style1">Sebagai Ketua Penasihat Raja,</span></p>
    <p xml:id="p1694" begin="69720060000t" end="69740080000t" style="style0"><span style="style1">menjadi kewajipan saya untuk memastikan mereka tidak menyedarinya.</span></p>
    <p xml:id="p1695" begin="69740080000t" end="69760100000t" style="style0"><span style="style1">BEK: Tapi kalau ada yang tanya.. (TERKECAK)</span></p>
    <p xml:id="p1696" begin="69760100000t" end="69776790000t" style="style0"><span style="style1">untuk pergi membantu rakan. Beritahu mereka saya ada</span></p>
    <p xml:id="p1697" begin="69800140000t" end="69827680000t" style="style0"><span style="style1">di tangan anda yang mampu. Saya meninggalkan Mesir</span></p>
    <p xml:id="p1698" begin="69839360000t" end="69849780000t" style="style0"><span style="style1">(KECIK)</span></p>
  </div>
  </body>
</tt>